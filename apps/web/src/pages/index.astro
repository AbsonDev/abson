---
import fallbackContent from '../data/site-content.json';

const apiUrl = import.meta.env.API_URL ?? 'https://api.abson.tech';

let content: any = fallbackContent;
try {
  const response = await fetch(`${apiUrl}/api/site`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(3000),
  });
  if (response.ok) {
    content = await response.json();
  }
} catch {
  // mantém o fallback local
}

const seo = content.seo ?? {};
const theme = content.theme ?? { default: 'dark' };
const profile = content.profile ?? {};
const workCard = content.workCard ?? { rows: [] };
const about = content.about ?? { paragraphs: [], principles: [] };
const skills = content.skills ?? { groups: [] };
const experience = content.experience ?? { jobs: [] };
const projects = content.projects ?? { cases: [] };
const education = content.education ?? { certifications: [] };
const processSection = content.process ?? { steps: [] };
const contact = content.contact ?? { subjects: [] };
const navigation = content.navigation ?? [];
const footerNavigation = content.footerNavigation ?? [];
const headline = profile.headline ?? { before: '', emphasis: '', after: '' };
const heroMeta = profile.heroMeta ?? [];
const casesJson = JSON.stringify(projects.cases ?? []).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pt-BR" data-theme={theme.default ?? 'dark'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seo.title ?? 'Abson Dutra Galvão · Desenvolvedor Mobile Full-Stack'}</title>
  <meta name="description" content={seo.description ?? ''} />
  {seo.canonical ? <link rel="canonical" href={seo.canonical} /> : null}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seo.title ?? 'Abson Developer'} />
  <meta property="og:description" content={seo.description ?? ''} />
  {seo.canonical ? <meta property="og:url" content={seo.canonical} /> : null}
  {seo.ogImage ? <meta property="og:image" content={seo.ogImage} /> : null}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230b0b0c'/%3E%3Ctext x='32' y='42' font-family='monospace' font-size='24' fill='%23f6f5f2' text-anchor='middle'%3EAD%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/assets/styles.css" />
  <script is:inline src="/assets/app.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#topo" aria-label={`${profile.brand ?? 'Abson Developer'} — início`}>
        <span class="brand-mark" aria-hidden="true">{profile.brandMark ?? 'AD'}</span>
        <span class="brand-text">
          <span class="brand-name">{profile.brand ?? 'Abson Developer'}</span>
          <span class="brand-role">{profile.role ?? ''}</span>
        </span>
      </a>

      <nav class="nav" id="nav-principal" aria-label="Seções do portfólio">
        {navigation.map((item: any) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="header-actions">
        <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Ativar tema claro">
          <svg class="od-icon icon-stroke icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
          <svg class="od-icon icon-stroke icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4" /></svg>
        </button>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-principal">Menu</button>
      </div>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero" id="topo">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{profile.name ?? ''}</p>
          <h1 class="hero-title">{headline.before}{headline.emphasis ? <em>{headline.emphasis}</em> : null}{headline.after}</h1>
          <p class="hero-lead">{profile.lead ?? ''}</p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#experiencia">Ver experiência</a>
            <a class="btn btn-ghost" href="#contato">Falar sobre um projeto</a>
          </div>

          <ul class="hero-meta">
            {heroMeta.map((item: string, index: number) => (
              <li>{index === 0 ? <span class="dot" aria-hidden="true" /> : null}{item}</li>
            ))}
          </ul>
        </div>

        <aside class="work-card" aria-labelledby="ficha-title">
          <div class="work-card-head">
            <h2 class="card-title" id="ficha-title">{workCard.title ?? 'Ficha de trabalho'}</h2>
            <span class="card-index" aria-hidden="true">{workCard.index ?? '01'}</span>
          </div>
          <dl class="work-list">
            {(workCard.rows ?? []).map((row: any) => (
              <div class="work-row">
                <dt>{row.label}</dt>
                <dd>{row.value}{row.note ? <span class="od-nowrap">{row.note}</span> : null}</dd>
              </div>
            ))}
          </dl>
          <p class="work-foot">
            <span class="badge"><span class="dot" aria-hidden="true"></span>{workCard.badge ?? 'Disponível'}</span>
            <span class="work-cap">{workCard.caption ?? ''}</span>
          </p>
        </aside>
      </div>
    </section>

    <section class="section" id="sobre">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{about.number ?? '01'}</span>{about.label ?? 'Sobre'}</p>
            <h2 class="section-title">{about.title ?? ''}</h2>
          </div>
          <p class="section-lead">{about.lead ?? ''}</p>
        </div>

        <div class="about-grid">
          <div class="about-copy">
            {(about.paragraphs ?? []).map((paragraph: string) => <p>{paragraph}</p>)}
          </div>

          <div class="principles">
            {(about.principles ?? []).map((principle: any, index: number) => (
              <div class="principle">
                <span class="principle-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{principle.title}</h3>
                  <p>{principle.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="competencias">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{skills.number ?? '02'}</span>{skills.label ?? 'Competências'}</p>
            <h2 class="section-title">{skills.title ?? ''}</h2>
          </div>
          <p class="section-lead">{skills.lead ?? ''}</p>
        </div>

        <div class="cap-grid">
          {(skills.groups ?? []).map((group: any, index: number) => (
            <div class="cap">
              <span class="cap-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{group.title}</h3>
              <ul>
                {(group.items ?? []).map((item: string) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="experiencia">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{experience.number ?? '03'}</span>{experience.label ?? 'Experiência'}</p>
            <h2 class="section-title">{experience.title ?? ''}</h2>
          </div>
          <p class="section-lead">{experience.lead ?? ''}</p>
        </div>

        <div class="jobs">
          {(experience.jobs ?? []).map((job: any) => (
            <article class="job">
              <p class="job-period">{job.period}{job.duration ? <><br />{job.duration}</> : null}</p>
              <div class="job-body">
                <h3>{job.company}</h3>
                <p class="job-role">{job.role}{job.location ? ` · ${job.location}` : ''}</p>
                <ul class="job-points">
                  {(job.bullets ?? []).map((bullet: string) => <li>{bullet}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projetos">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{projects.number ?? '04'}</span>{projects.label ?? 'Projetos'}</p>
            <h2 class="section-title">{projects.title ?? ''}</h2>
          </div>
          <p class="section-lead">{projects.lead ?? ''}</p>
        </div>

        <div class="cases">
          {(projects.cases ?? []).map((item: any, index: number) => (
            <article class="case">
              <span class="case-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="case-body">
                <p class="case-kicker">{item.kicker}</p>
                <h3>{item.title}</h3>
                <p class="case-summary">{item.summary}</p>
                <ul class="tag-list">
                  {(item.tags ?? []).map((tag: string) => <li class="tag">{tag}</li>)}
                </ul>
              </div>
              <div class="case-action">
                <button class="btn btn-ghost btn-sm" type="button" data-case={item.slug}>
                  Abrir ficha
                  <svg class="od-icon icon-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
              </div>
            </article>
          ))}
        </div>

        <p class="case-note">{projects.note ?? ''}</p>
      </div>
    </section>

    <section class="section" id="formacao">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{education.number ?? '05'}</span>{education.label ?? 'Formação'}</p>
            <h2 class="section-title">{education.title ?? ''}</h2>
          </div>
          <p class="section-lead">{education.lead ?? ''}</p>
        </div>

        <div class="edu-grid">
          <div class="edu-block">
            <p class="edu-label">{education.degree?.label ?? 'Formação acadêmica'}</p>
            <h3 class="edu-school">{education.degree?.institution ?? ''}</h3>
            <p class="edu-degree">{education.degree?.degree ?? ''}</p>
            <p class="edu-period">{education.degree?.period ?? ''}</p>
          </div>
          <div class="cert-block">
            <p class="edu-label">{education.certificationsLabel ?? 'Certificações'}</p>
            <ul class="cert-list">
              {(education.certifications ?? []).map((certification: string) => <li>{certification}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="processo">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{processSection.number ?? '06'}</span>{processSection.label ?? 'Processo'}</p>
            <h2 class="section-title">{processSection.title ?? ''}</h2>
          </div>
          <p class="section-lead">{processSection.lead ?? ''}</p>
        </div>

        <div class="steps">
          {(processSection.steps ?? []).map((step: any, index: number) => (
            <div class="step">
              <span class="step-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <p class="step-out">{step.output}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-contact" id="contato">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="section-label"><span class="num">{contact.number ?? '07'}</span>{contact.label ?? 'Contato'}</p>
            <h2 class="section-title">{contact.title ?? ''}</h2>
          </div>
          <p class="section-lead">{contact.lead ?? ''}</p>
        </div>

        <div class="contact-grid">
          <div class="contact-info">
            <p class="contact-label">E-mail</p>
            <a class="contact-email" href={`mailto:${profile.email ?? ''}`}>{profile.email ?? ''}</a>

            <p class="contact-label">LinkedIn</p>
            <a class="contact-link" href={profile.linkedin ?? '#'} target="_blank" rel="noopener">{profile.linkedinLabel ?? ''}</a>

            <p class="contact-label">Base</p>
            <p class="contact-text">{profile.location ?? ''} · atendimento remoto</p>

            <p class="contact-label">Currículo</p>
            <a class="btn btn-ghost btn-download" href={profile.cvUrl ?? '/assets/cv-abson-dutra-galvao.pdf'} download="CV-Abson-Dutra-Galvao.pdf">
              Baixar currículo em PDF
              <svg class="od-icon icon-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
            </a>

            <p class="contact-label contact-label-spaced">Estado</p>
            <p class="contact-text"><span class="badge"><span class="dot" aria-hidden="true"></span>{profile.availability ?? 'Disponível para conversa'}</span></p>
          </div>

          <div class="form-panel">
            <form id="contact-form" class="contact-form" novalidate>
              <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
                <label for="campo-website">Website</label>
                <input id="campo-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <div class="form-summary" id="resumo-erros" hidden>
                <h3 class="summary-title" id="resumo-titulo" tabindex="-1">Revise os campos destacados</h3>
                <ul class="summary-list" id="lista-erros"></ul>
              </div>

              <div class="field">
                <label for="campo-nome">Nome <span class="req" aria-hidden="true">*</span></label>
                <input id="campo-nome" name="nome" type="text" autocomplete="name" required aria-required="true" aria-describedby="erro-nome" />
                <p class="field-error" id="erro-nome" hidden></p>
              </div>

              <div class="field">
                <label for="campo-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <input id="campo-email" name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby="erro-email" />
                <p class="field-error" id="erro-email" hidden></p>
              </div>

              <div class="field">
                <label for="campo-assunto">Tipo de conversa <span class="req" aria-hidden="true">*</span></label>
                <select id="campo-assunto" name="assunto" required aria-required="true" aria-describedby="erro-assunto">
                  <option value="">Selecione…</option>
                  {(contact.subjects ?? []).map((subject: any) => (
                    <option value={subject.value}>{subject.label}</option>
                  ))}
                </select>
                <p class="field-error" id="erro-assunto" hidden></p>
              </div>

              <div class="field">
                <label for="campo-mensagem">Mensagem <span class="req" aria-hidden="true">*</span></label>
                <textarea id="campo-mensagem" name="mensagem" rows="5" required aria-required="true" aria-describedby="erro-mensagem"></textarea>
                <p class="field-error" id="erro-mensagem" hidden></p>
              </div>

              <p class="form-note">{contact.formNote ?? 'Seus dados são enviados com segurança e usados apenas para responder ao contato.'}</p>

              <button class="btn btn-primary btn-block" type="submit">Enviar mensagem</button>
            </form>

            <div class="form-status" id="form-status" role="status" hidden>
              <p class="status-title" id="status-title" tabindex="-1">{contact.successTitle ?? 'Mensagem enviada com sucesso.'}</p>
              <p class="status-text">{contact.successText ?? 'Obrigado pelo contato. Responderei pelo e-mail informado em breve.'}</p>
              <button class="btn btn-ghost" type="button" id="reset-form">Escrever outra mensagem</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <span class="brand-mark" aria-hidden="true">{profile.brandMark ?? 'AD'}</span>
        <div>
          <p class="footer-name">{profile.brand ?? 'Abson Developer'}</p>
          <p class="footer-role">{profile.role ?? ''}</p>
        </div>
      </div>
      <nav class="footer-nav" aria-label="Navegação do rodapé">
        {footerNavigation.map((item: any) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <p class="footer-meta">{profile.footerNote ?? ''}</p>
    </div>
  </footer>

  <dialog class="case-dialog" id="case-dialog" aria-labelledby="case-title">
    <div class="dialog-head">
      <div class="dialog-heading">
        <p class="dialog-kicker" id="case-kicker">Estudo de caso</p>
        <h2 class="dialog-title" id="case-title">Ficha</h2>
      </div>
      <button class="dialog-close" type="button" id="case-close" aria-label="Fechar ficha" autofocus>
        <svg class="od-icon icon-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <div class="dialog-body">
      <section class="dialog-section">
        <h3 class="dialog-label">Contexto</h3>
        <p id="case-context"></p>
      </section>
      <section class="dialog-section">
        <h3 class="dialog-label">Decisão</h3>
        <p id="case-decision"></p>
      </section>
      <section class="dialog-section">
        <h3 class="dialog-label">Resultado</h3>
        <p id="case-result"></p>
      </section>
      <section class="dialog-section">
        <h3 class="dialog-label">Stack</h3>
        <ul class="tag-list" id="case-stack"></ul>
      </section>
      <p class="dialog-note" id="case-note">{projects.note ?? 'Ficha baseada em experiência profissional real — sem cliente identificado ou métrica de resultado.'}</p>
    </div>
  </dialog>

  <script type="application/json" id="site-cases" set:html={casesJson}></script>
</body>
</html>
