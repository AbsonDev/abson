---
import fallbackContent from "../data/site-content.json";
import { buildCmsI18n, buildExtraI18n } from "../lib/cms-i18n";

const apiUrl = import.meta.env.API_URL ?? "https://api.abson.tech";
let content: any = fallbackContent;
try {
  const response = await fetch(apiUrl + "/api/site", {
    headers: { Accept: "application/json" },
    signal: AbortSignal.timeout(3000),
  });
  if (response.ok) content = await response.json();
} catch {
  // mantém o fallback local
}

const seo = content.seo ?? {};
const profile = content.profile ?? {};
const theme = content.theme ?? { default: "dark" };
const projects = content.projects ?? { cases: [] };
const cmsI18n = buildCmsI18n(content);
const extraI18n = buildExtraI18n(content);
const pageTitle = seo.title || "Abson Dutra Galvão · Desenvolvedor Mobile Full-Stack";
const pageDescription = seo.description || "Portfólio de Abson Dutra Galvão — desenvolvedor mobile full-stack.";
const canonical = seo.canonical || "https://abson.tech";
const canonicalBase = canonical.replace(/\/$/, "");
const ogImage = seo.ogImage || "https://abson.tech/assets/og-cover.png";
const cmsI18nJson = JSON.stringify(cmsI18n).replace(/</g, "\\u003c");
const extraI18nJson = JSON.stringify(extraI18n).replace(/</g, "\\u003c");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.brand,
  jobTitle: profile.role,
  description: pageDescription,
  image: ogImage,
  email: profile.email ? "mailto:" + profile.email : undefined,
  sameAs: [profile.linkedin].filter(Boolean),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Aracaju",
    addressRegion: "SE",
    addressCountry: "BR",
  },
  knowsAbout: (content.skills?.groups ?? []).flatMap((group: any) => group.items ?? []).slice(0, 8),
};
const jsonLdJson = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="pt-BR" data-theme={theme.default ?? "dark"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var stored = null;
      try {
        stored = window.localStorage.getItem("abson-theme");
      } catch (error) {
        stored = null;
      }
      var systemLight =
        window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
      var theme = stored === "light" || stored === "dark" ? stored : systemLight ? "light" : "dark";
      root.setAttribute("data-theme", theme);
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && "IntersectionObserver" in window) {
        root.classList.add("js-reveal");
      }
    })();
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="author" content={profile.name ?? "Abson Dutra Galvão"} />
  <meta name="robots" content="index,follow" />
  <meta name="theme-color" content="#0b0b0c" id="meta-theme-color" />
  <meta name="color-scheme" content="dark light" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230b0b0c'/%3E%3Ctext x='32' y='42' font-family='monospace' font-size='24' fill='%23f6f5f2' text-anchor='middle'%3EAD%3C/text%3E%3C/svg%3E" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={pageTitle} />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="pt-BR" href={canonicalBase + "/"} />
  <link rel="alternate" hreflang="en" href={canonicalBase + "/?lang=en"} />
  <link rel="alternate" hreflang="es" href={canonicalBase + "/?lang=es"} />

  <script type="application/ld+json" set:html={jsonLdJson}></script>

  <link rel="preload" href="/assets/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/instrument-serif-italic-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/styles.css" />

  <script type="application/json" id="cms-i18n" set:html={cmsI18nJson}></script>
  <script type="application/json" id="cms-extra-i18n" set:html={extraI18nJson}></script>
  <script is:inline>
    window.ABSON_CMS_I18N = JSON.parse(document.getElementById("cms-i18n").textContent || "{}");
    window.ABSON_EXTRA_I18N = JSON.parse(document.getElementById("cms-extra-i18n").textContent || "{}");
  </script>
  <script src="/assets/i18n.js" defer></script>
  <script src="/assets/app.js" defer></script>
</head>
<body data-api-base={apiUrl} data-contact-email={profile.email}>

    <a class="skip-link" href="#conteudo" data-i18n="ui.skip">Pular para o conteúdo</a>
    <p class="sr-status" id="status-announcer" role="status" aria-live="polite" aria-atomic="true"></p>

    <header class="site-header">
