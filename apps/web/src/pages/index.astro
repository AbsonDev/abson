                  <svg class="od-icon icon-stroke icon-copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
                  <svg class="od-icon icon-stroke icon-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l5 5 20-11" /></svg>
                  <span id="copy-email-label" data-i18n="contact.copy">Copiar</span>
                </button>
              </div>
              <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>

              <p class="contact-label">LinkedIn</p>
              <a class="contact-link" href={profile.linkedin} target="_blank" rel="noopener">{profile.linkedinLabel}</a>

              <p class="contact-label" data-i18n="contact.baseLabel">Base</p>
              <p class="contact-text" data-i18n="contact.baseText">Aracaju, Sergipe · atendimento remoto</p>

              <p class="contact-label" data-i18n="contact.cvLabel">Currículo</p>
              <a class="btn btn-ghost btn-download" href={profile.cvUrl} download="CV-Abson-Dutra-Galvao.pdf">
                <span data-i18n="contact.cvButton">Baixar currículo em PDF</span>
                <svg class="od-icon icon-stroke" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
              </a>

              <p class="contact-label contact-label-spaced" data-i18n="contact.stateLabel">Estado</p>
              <p class="contact-text">
                <span class="badge">
                  <span class="dot" aria-hidden="true"></span>
                  <span data-i18n="contact.openLabel">Aberto a projetos e conversas</span>
                </span>
              </p>
            </div>

            <div class="form-panel">
              <form id="contact-form" class="contact-form" novalidate>
                <div class="form-summary" id="resumo-erros" hidden>
                  <h3 class="summary-title" id="resumo-titulo" tabindex="-1" data-i18n="form.summaryHeading">Revise os campos destacados</h3>
                  <ul class="summary-list" id="lista-erros"></ul>
                </div>

                <div class="field">
                  <label for="campo-nome"><span data-i18n="form.name">Nome</span> <span class="req" aria-hidden="true">*</span></label>
                  <input id="campo-nome" name="nome" type="text" autocomplete="name" required aria-required="true" aria-describedby="erro-nome" />
                  <p class="field-error" id="erro-nome" hidden></p>
                </div>

                <div class="field">
                  <label for="campo-email"><span data-i18n="form.email">E-mail</span> <span class="req" aria-hidden="true">*</span></label>
                  <input id="campo-email" name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby="erro-email" />
                  <p class="field-error" id="erro-email" hidden></p>
                </div>

                <div class="field">
                  <label for="campo-assunto"><span data-i18n="form.subject">Tipo de conversa</span> <span class="req" aria-hidden="true">*</span></label>
                  <select id="campo-assunto" name="assunto" required aria-required="true" aria-describedby="erro-assunto">
                    <option value="" data-i18n="form.subjectEmpty">Selecione…</option>
                    <option value="novo" data-i18n="form.optNew">Novo sistema</option>
                    <option value="melhoria" data-i18n="form.optImprove">Melhoria em sistema existente</option>
                    <option value="integracao" data-i18n="form.optIntegration">Integração entre sistemas</option>
                    <option value="consultoria" data-i18n="form.optConsult">Consultoria pontual</option>
                  </select>
                  <p class="field-error" id="erro-assunto" hidden></p>
                </div>

                <div class="field">
                  <label for="campo-mensagem"><span data-i18n="form.message">Mensagem</span> <span class="req" aria-hidden="true">*</span></label>
                  <textarea id="campo-mensagem" name="mensagem" rows="5" required aria-required="true" aria-describedby="erro-mensagem"></textarea>
                  <p class="field-error" id="erro-mensagem" hidden></p>
                </div>

                <p class="form-note" data-i18n="form.note">O envio abre uma mensagem no seu cliente de e-mail. Nada é transmitido por este site.</p>

                <button class="btn btn-primary btn-block" type="submit" data-i18n="form.submit">Preparar mensagem</button>
              </form>

              <div class="form-status" id="form-status" role="status" hidden>
                <p class="status-title" id="status-title" tabindex="-1" data-i18n="form.statusTitle">Mensagem pronta para enviar.</p>
                <p class="status-text" data-i18n="form.statusText">Abra seu cliente de e-mail ou copie o texto abaixo. O site não envia nada por conta própria.</p>
                <p class="message-preview" id="message-preview"></p>
                <div class="status-actions">
                  <a class="btn btn-primary" id="mailto-link" href={'mailto:' + profile.email} data-i18n="form.mailto">Abrir no e-mail</a>
                  <button class="btn btn-ghost" type="button" id="copy-message" data-i18n="form.copyMessage">Copiar mensagem</button>
                </div>
                <p class="copy-status" id="copy-message-status" role="status" aria-live="polite"></p>
                <button class="btn btn-ghost" type="button" id="reset-form" data-i18n="form.reset">Escrever outra mensagem</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="atmos-layer atmos-footer" aria-hidden="true" data-parallax="18" data-parallax-source="parent"></div>
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <div>
            <p class="footer-name" data-i18n-html="brand.nameHtml">Abson <em>Developer</em></p>
            <p class="footer-role" data-i18n="footer.role">Desenvolvedor mobile full-stack</p>
          </div>
        </div>
        <nav class="footer-nav" aria-label="Navegação do rodapé" data-i18n-aria="ui.footerNavLabel">
          <a href="#sobre" data-i18n="nav.sobre">Sobre</a>
          <a href="#competencias" data-i18n="nav.competencias">Competências</a>
          <a href="#experiencia" data-i18n="nav.experiencia">Experiência</a>
          <a href="#projetos" data-i18n="nav.projetos">Projetos</a>
          <a href="#formacao" data-i18n="nav.formacao">Formação</a>
          <a href="#processo" data-i18n="nav.processo">Processo</a>
          <a href="#contato" data-i18n="nav.contato">Contato</a>
        </nav>
        <p class="footer-meta" data-i18n="footer.meta">{profile.footerNote}</p>
      </div>
    </footer>
  
</body>
</html>
