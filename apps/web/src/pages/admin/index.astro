---
const apiUrl = import.meta.env.API_URL ?? 'https://api.abson.tech';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="Painel administrativo de abson.tech." />
  <title>Painel Abson · abson.tech</title>
  <link rel="stylesheet" href="/admin/admin.css" />
</head>
<body data-api-base={apiUrl}>
<a class="skip" href="#main-content">Pular para o conteúdo</a>

<div class="login" id="login">
  <div class="login-atmos" aria-hidden="true"></div>
  <main class="login-wrap">
    <div class="login-brand">
      <span class="mark" aria-hidden="true">AD</span>
      <div>
        <p class="brand-site mono">abson.tech</p>
        <p class="brand-role">Administração do portfólio</p>
      </div>
    </div>

    <div class="login-card">
      <p class="eyebrow">Acesso restrito</p>
      <h1 class="login-title">Painel <em>Abson</em></h1>
      <p class="login-lede">Entre para editar o conteúdo publicado no portfólio, responder mensagens e cuidar do acesso.</p>

      <form id="login-form" novalidate>
        <div class="field">
          <label for="login-email">E-mail <span class="req">obrigatório</span></label>
          <input class="input" id="login-email" name="email" type="email" inputmode="email" autocomplete="username" aria-describedby="login-email-error">
          <p class="field-error" id="login-email-error" hidden></p>
        </div>
        <div class="field">
          <label for="login-password">Senha <span class="req">obrigatório</span></label>
          <input class="input" id="login-password" name="password" type="password" autocomplete="current-password" aria-describedby="login-password-error">
          <p class="field-error" id="login-password-error" hidden></p>
        </div>
        <button class="btn btn-primary" id="login-button" type="submit">
          <span id="login-button-label">Entrar</span>
          <span class="spinner" id="login-spinner" hidden aria-hidden="true"></span>
        </button>
      </form>

      <div class="login-secure">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span>Conexão protegida por HTTPS. Use uma senha exclusiva para este painel.</span>
      </div>
    </div>

    <div class="brand-signature">
      <span>2026 · Abson Dutra Galvão</span>
      <em>sistemas com clareza</em>
    </div>

    <p class="login-foot">Acesso restrito · abson.tech</p>
  </main>
</div>

<div class="app" id="app" hidden>
  <div class="scrim" id="scrim" hidden></div>

  <aside class="sidebar" id="sidebar" aria-label="Menu principal">
    <div class="side-head">
      <span class="mark" aria-hidden="true">AD</span>
      <div class="side-title">
        <strong>Painel <em>Abson</em></strong>
        <span class="mono">abson.tech</span>
      </div>
      <button class="icon-btn side-close" id="side-close" aria-label="Fechar menu" aria-controls="sidebar">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="nav" aria-label="Seções do painel">
      <p class="nav-label mono">Navegação</p>
      <button class="nav-item is-active" data-view="overview" aria-current="page">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>Visão geral</span>
      </button>
      <button class="nav-item" data-view="career">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>
        <span>Carreira</span>
        <span class="count" id="nav-career-pending" hidden>0</span>
      </button>
      <button class="nav-item" data-view="content">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
        <span>Conteúdo do site</span>
      </button>
      <button class="nav-item" data-view="messages">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5 5h14l2 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z"/></svg>
        <span>Mensagens</span>
        <span class="count" id="nav-unread" aria-label="2 não lidas">2</span>
      </button>
      <button class="nav-item" data-view="security">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8 3.5-3.5"/></svg>
        <span>Segurança</span>
      </button>
    </nav>

    <div class="side-status">
      <span class="dot ok" aria-hidden="true"></span>
      <div>
        <strong>Site no ar</strong>
        <span class="mono">abson.tech</span>
      </div>
    </div>

    <div class="side-foot">
      <a class="side-link" href="https://abson.tech" target="_blank" rel="noopener">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
        <span>Ver site</span>
      </a>
      <button class="side-link" id="logout">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
        <span>Sair</span>
      </button>
    </div>
  </aside>

  <div class="shell">
    <header class="topbar">
      <button class="icon-btn" id="menu-btn" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <div class="topbar-brand">
        <span class="mark is-sm" aria-hidden="true">AD</span>
        <span>Painel <em>Abson</em></span>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="view" id="view-overview" aria-labelledby="heading-overview">
        <div class="view-head">
          <div>
            <p class="eyebrow">Visão geral <span class="sep">/</span> <span id="today-label">domingo, 8 de novembro de 2026</span></p>
            <h1 id="heading-overview" tabindex="-1">Olá, <em>Abson</em></h1>
            <p class="lede">Este é o estado do seu site agora. Conteúdo, mensagens e acesso em um só lugar.</p>
          </div>
          <div class="head-actions">
            <span class="pill"><span class="dot ok" aria-hidden="true"></span> Site no ar</span>
            <button class="btn btn-ghost" data-go="content">
              <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              Editar conteúdo
            </button>
          </div>
        </div>

        <div class="stats">
          <article class="stat">
            <p class="stat-label">Mensagens</p>
            <p class="stat-num" id="stat-total">6</p>
            <p class="stat-foot"><span class="dot purple" aria-hidden="true"></span> no total, desde o início do site</p>
          </article>
          <article class="stat">
            <p class="stat-label">Não lidas</p>
            <p class="stat-num is-cyan" id="stat-unread">2</p>
            <p class="stat-foot"><span class="dot cyan" aria-hidden="true"></span> aguardando uma resposta sua</p>
          </article>
          <article class="stat">
            <p class="stat-label">Conteúdo atualizado</p>
            <p class="stat-num is-purple" id="stat-completeness">91<small>%</small></p>
            <p class="stat-foot"><span class="dot purple" aria-hidden="true"></span> <span id="stat-updated-foot">revisão há 2 h</span></p>
          </article>
        </div>

        <div class="overview-grid">
          <section class="panel" aria-labelledby="recent-title">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Caixa de entrada</p>
                <h2 id="recent-title">Mensagens recentes</h2>
              </div>
              <button class="link-btn" data-go="messages">
                Ver todas
                <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            <div class="recent-list" id="recent-list"></div>
          </section>

          <div class="overview-side">
            <section class="panel quick" aria-labelledby="quick-title">
              <div class="panel-head">
                <div>
                  <p class="eyebrow">Atalhos</p>
                  <h2 id="quick-title">Ações rápidas</h2>
                </div>
              </div>
              <div class="quick-body">
                <p class="quick-sub">O que costuma importar agora.</p>
                <button class="quick-btn" data-go="content">
                  <span class="qi" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
                  </span>
                  <span class="quick-copy">
                    <strong>Editar conteúdo</strong>
                    <span>SEO, perfil, experiências e projetos</span>
                  </span>
                  <span class="arrow" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                  </span>
                </button>
                <button class="quick-btn" data-go="messages">
                  <span class="qi" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5 5h14l2 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z"/></svg>
                  </span>
                  <span class="quick-copy">
                    <strong>Ver mensagens</strong>
                    <span id="quick-unread">2 não lidas</span>
                  </span>
                  <span class="arrow" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                  </span>
                </button>
              </div>
            </section>

            <section class="panel health" aria-labelledby="health-title">
              <p class="eyebrow">Integridade</p>
              <h2 id="health-title">Conteúdo do site</h2>
              <ul id="health-list"></ul>
              <p class="health-foot">Completude estimada a partir dos campos preenchidos do conteúdo.</p>
            </section>
          </div>
        </div>
      </section>

      <section class="view" id="view-career" aria-labelledby="heading-career" hidden>
        <div class="view-head">
          <div>
            <p class="eyebrow">Carreira <span class="sep">/</span> career-ops</p>
            <h1 id="heading-career" tabindex="-1">Carreira</h1>
            <p class="lede">O estado da sua busca, sincronizado do Mac. Ações feitas aqui entram na fila e são aplicadas no próximo sync.</p>
          </div>
          <div class="head-actions">
            <span class="pill" id="career-sync-pill"><span class="dot warn" id="career-sync-dot" aria-hidden="true"></span> <span id="career-sync-label">Aguardando sync</span></span>
            <button class="btn btn-ghost" id="career-refresh" type="button">
              <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
              Atualizar
            </button>
          </div>
        </div>

        <div class="stats career-stats">
          <article class="stat">
            <p class="stat-label">Candidaturas</p>
            <p class="stat-num" id="career-stat-apps">—</p>
            <p class="stat-foot"><span class="dot purple" aria-hidden="true"></span> no tracker</p>
          </article>
          <article class="stat">
            <p class="stat-label">Em processo</p>
            <p class="stat-num is-cyan" id="career-stat-active">—</p>
            <p class="stat-foot"><span class="dot cyan" aria-hidden="true"></span> aplicadas, testes e entrevistas</p>
          </article>
          <article class="stat">
            <p class="stat-label">Ofertas</p>
            <p class="stat-num is-purple" id="career-stat-offers">—</p>
            <p class="stat-foot"><span class="dot purple" aria-hidden="true"></span> oferta ou contratação</p>
          </article>
          <article class="stat">
            <p class="stat-label">Score médio</p>
            <p class="stat-num" id="career-stat-score">—</p>
            <p class="stat-foot"><span class="dot ok" aria-hidden="true"></span> das avaliações</p>
          </article>
        </div>

        <div class="career-grid">
          <section class="panel" aria-labelledby="career-funnel-title">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Funil</p>
                <h2 id="career-funnel-title">Status das candidaturas</h2>
              </div>
            </div>
            <div class="career-funnel" id="career-funnel"></div>
          </section>

          <section class="panel" aria-labelledby="career-add-title">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Adicionar</p>
                <h2 id="career-add-title">Nova vaga no pipeline</h2>
              </div>
            </div>
            <form id="career-add-form" class="career-form" novalidate>
              <div class="field">
                <label for="career-url">URL da vaga <span class="req">obrigatório</span></label>
                <input class="input" id="career-url" type="url" placeholder="https://..." required>
              </div>
              <div class="career-form-row">
                <div class="field">
                  <label for="career-company">Empresa</label>
                  <input class="input" id="career-company" type="text" placeholder="opcional">
                </div>
                <div class="field">
                  <label for="career-role">Cargo</label>
                  <input class="input" id="career-role" type="text" placeholder="opcional">
                </div>
              </div>
              <p class="career-hint">A URL entra em <span class="mono">data/pipeline.md</span> no próximo sync.</p>
              <button class="btn btn-primary" type="submit" id="career-add-submit">Adicionar à fila</button>
            </form>
          </section>
        </div>

        <section class="panel career-panel" aria-labelledby="career-apps-title">
          <div class="panel-head">
            <div>
              <p class="eyebrow">Candidaturas</p>
              <h2 id="career-apps-title">Tracker</h2>
            </div>
            <div class="career-tools">
              <div class="search career-search">
                <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input class="input" id="career-search" type="search" placeholder="Buscar empresa ou cargo" autocomplete="off">
              </div>
              <select class="input" id="career-filter" aria-label="Filtrar por status">
                <option value="">Todos os status</option>
              </select>
            </div>
          </div>
          <div class="career-table-wrap">
            <table class="career-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Empresa</th>
                  <th>Cargo</th>
                  <th>Score</th>
                  <th>Status</th>
                  <th>Data</th>
                  <th>Ação</th>
                </tr>
              </thead>
              <tbody id="career-table-body">
                <tr><td colspan="7" class="career-empty">Aguardando o primeiro sync…</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <div class="career-grid">
          <section class="panel" aria-labelledby="career-pipeline-title">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Pipeline</p>
                <h2 id="career-pipeline-title">Vagas pendentes</h2>
              </div>
              <span class="pill" id="career-pipeline-count">0</span>
            </div>
            <div class="career-list" id="career-pipeline"></div>
          </section>

          <section class="panel" aria-labelledby="career-actions-title">
            <div class="panel-head">
              <div>
                <p class="eyebrow">Fila</p>
                <h2 id="career-actions-title">Ações recentes</h2>
              </div>
              <span class="pill" id="career-pending-count">sem pendências</span>
            </div>
            <div class="career-list" id="career-actions"></div>
          </section>
        </div>
      </section>

      <section class="view" id="view-content" aria-labelledby="heading-content" hidden>
        <div class="view-head">
          <div>
            <p class="eyebrow">Conteúdo do site <span class="sep">/</span> pt-BR</p>
            <h1 id="heading-content" tabindex="-1">Conteúdo</h1>
            <p class="lede">Cada seção abaixo corresponde a um bloco publicado em abson.tech. As alterações ficam em rascunho até você salvar.</p>
          </div>
          <div class="head-actions">
            <span class="pill"><span class="dot ok" aria-hidden="true"></span> Publicado</span>
          </div>
        </div>
        <div class="content-layout">
          <nav class="sec-nav" id="sec-nav" aria-label="Seções do site"></nav>
          <section class="editor" id="editor" aria-label="Editor de conteúdo">
          <div class="editor-head">
            <p class="eyebrow" id="editor-num">Seção 01</p>
            <span class="pill editor-status"><span class="dot done" id="editor-dot" aria-hidden="true"></span> <span id="editor-pct">—</span></span>
            <h2 id="editor-title">SEO</h2>
            <p class="editor-hint" id="editor-hint">Título, descrição e canonical da página.</p>
          </div>
          <div class="editor-body" id="editor-body">
            <div id="content-editor" class="content-editor">
              <p class="editor-loading">Carregando conteúdo…</p>
            </div>
          </div>
          <div class="editor-foot">
            <span class="dirty-flag" id="dirty-flag" hidden><span class="dot warn" aria-hidden="true"></span> Alterações não salvas</span>
            <div class="foot-actions">
              <span class="updated">Última atualização · <strong id="editor-updated">—</strong></span>
              <button class="btn btn-ghost" type="button" id="reload-btn">Recarregar</button>
              <button class="btn btn-primary" type="button" id="save-btn" disabled>Salvar alterações</button>
            </div>
          </div>
        </section>
        </div>
      </section>

      <section class="view" id="view-messages" aria-labelledby="heading-messages" hidden>
        <div class="view-head">
          <div>
            <p class="eyebrow">Caixa de entrada</p>
            <h1 id="heading-messages" tabindex="-1">Mensagens</h1>
          </div>
          <p class="head-meta" id="messages-meta">6 mensagens · 2 não lidas</p>
        </div>

        <div class="inbox" id="inbox">
          <div class="list-pane">
            <div class="inbox-tools">
              <label class="search-label" for="msg-search">Buscar mensagens</label>
              <div class="search">
                <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input class="input" id="msg-search" type="search" placeholder="Nome, assunto ou e-mail" autocomplete="off">
              </div>
              <div class="filter-row" id="filter-row" role="group" aria-label="Filtrar mensagens por status">
                <button class="chip is-active" data-filter="todas">Todas <span data-count="todas">6</span></button>
                <button class="chip" data-filter="nova">Novas <span data-count="nova">2</span></button>
                <button class="chip" data-filter="lida">Lidas <span data-count="lida">2</span></button>
                <button class="chip" data-filter="respondida">Respondidas <span data-count="respondida">1</span></button>
                <button class="chip" data-filter="arquivada">Arquivadas <span data-count="arquivada">1</span></button>
              </div>
            </div>
            <div class="msg-list" id="msg-list" aria-label="Lista de mensagens"></div>
            <div class="empty" id="msg-empty" hidden>
              <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5 5h14l2 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z"/></svg>
              <h3>Nenhuma mensagem encontrada</h3>
              <p>Ajuste a busca ou o filtro para ver outras conversas da caixa de entrada.</p>
              <button class="btn btn-ghost" id="clear-filters">Limpar filtros</button>
            </div>
          </div>
          <div class="detail-pane" id="detail-pane">
            <button class="back-btn" id="msg-back">
              <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg>
              Voltar para a lista
            </button>
            <div id="msg-detail"></div>
          </div>
        </div>
      </section>

      <section class="view" id="view-security" aria-labelledby="heading-security" hidden>
        <div class="view-head">
          <div>
            <p class="eyebrow">Segurança <span class="sep">/</span> acesso</p>
            <h1 id="heading-security" tabindex="-1">Segurança</h1>
            <p class="lede">Proteja o acesso ao painel. Uma senha forte e o segundo fator reduzem o risco de alterações não autorizadas.</p>
          </div>
          <div class="head-actions">
            <span class="pill tone-ok"><span class="dot ok" aria-hidden="true"></span> Conta protegida</span>
          </div>
        </div>

        <div class="sec-grid">
          <section class="panel form-panel" aria-labelledby="pw-title">
            <p class="eyebrow">Credenciais</p>
            <h2 id="pw-title">Alterar senha</h2>
            <p class="panel-sub">Use uma senha que você não reutiliza em outros serviços. A alteração vale para este acesso imediatamente.</p>

            <form class="pw-form" id="pw-form" novalidate>
              <div class="field">
                <label for="pw-current">Senha atual <span class="req">obrigatório</span></label>
                <input class="input" id="pw-current" type="password" autocomplete="current-password" aria-describedby="pw-current-error">
                <p class="field-error" id="pw-current-error" hidden></p>
              </div>

              <div class="field">
                <label for="pw-new">Nova senha <span class="req">obrigatório</span></label>
                <input class="input" id="pw-new" type="password" autocomplete="new-password" aria-describedby="pw-new-error pw-hints">
                <p class="field-error" id="pw-new-error" hidden></p>
                <div class="strength" id="strength" data-score="0">
                  <div class="strength-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                  <p class="strength-label" id="strength-label" role="status">Força da senha</p>
                </div>
                <ul class="hints" id="pw-hints">
                  <li data-rule="length">Pelo menos 10 caracteres</li>
                  <li data-rule="letter">Uma letra</li>
                  <li data-rule="number">Um número</li>
                  <li data-rule="symbol">Um símbolo</li>
                </ul>
              </div>

              <div class="field">
                <label for="pw-confirm">Confirmar nova senha <span class="req">obrigatório</span></label>
                <input class="input" id="pw-confirm" type="password" autocomplete="new-password" aria-describedby="pw-confirm-error">
                <p class="field-error" id="pw-confirm-error" hidden></p>
              </div>

              <p class="form-status" id="pw-status" role="status" hidden>
                <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span id="pw-status-text">Senha alterada agora.</span>
              </p>

              <div>
                <button class="btn btn-primary" id="pw-submit" type="submit" disabled>Alterar senha</button>
              </div>
            </form>
          </section>

          <div class="side-stack">
            <section class="panel checklist" aria-labelledby="checklist-title">
              <p class="eyebrow">Postura</p>
              <h2 id="checklist-title">Checklist de segurança</h2>
              <ul>
                <li class="check-row">
                  <span class="check-ico" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  </span>
                  <span class="check-copy">
                    <strong>Autenticação em dois fatores</strong>
                    <span>Ainda não configurada neste acesso</span>
                  </span>
                  <span class="pill tone-warn">Recomendado</span>
                </li>
                <li class="check-row">
                  <span class="check-ico" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
                  </span>
                  <span class="check-copy">
                    <strong>Sessão com expiração</strong>
                    <span id="last-password-change">O acesso expira em 8 horas</span>
                  </span>
                  <span class="pill tone-ok">Ativo</span>
                </li>
                <li class="check-row">
                  <span class="check-ico" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
                  </span>
                  <span class="check-copy">
                    <strong>Painel fora dos buscadores</strong>
                    <span>Meta noindex, nofollow</span>
                  </span>
                  <span class="pill tone-ok">Ativo</span>
                </li>
                <li class="check-row">
                  <span class="check-ico" aria-hidden="true">
                    <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8"/><path d="M12 16v4"/></svg>
                  </span>
                  <span class="check-copy">
                    <strong>Conexão HTTPS</strong>
                    <span id="session-count-label">Certificado Let's Encrypt em abson.tech</span>
                  </span>
                  <span class="pill tone-ok">Ativo</span>
                </li>
              </ul>
            </section>

            <section class="panel sessions" aria-labelledby="sessions-title">
              <p class="eyebrow">Dispositivos</p>
              <h2 id="sessions-title">Sessão atual</h2>
              <ul id="session-list">
                <li class="session-row">
                  <span class="avatar tone-purple" aria-hidden="true">AD</span>
                  <span class="session-copy">
                    <strong>Este navegador</strong>
                    <span id="session-detail">Sessão iniciada agora</span>
                  </span>
                  <span class="session-tag">Este</span>
                </li>
              </ul>
            </section>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="toast-region" id="toasts" aria-live="polite" aria-atomic="false"></div>

<dialog id="confirm-dialog" aria-labelledby="dlg-title" aria-describedby="dlg-text">
  <div class="dlg-body">
    <p class="eyebrow">Confirmação</p>
    <h2 id="dlg-title">Excluir mensagem?</h2>
    <p id="dlg-text">Esta ação não pode ser desfeita neste protótipo.</p>
  </div>
  <div class="dlg-actions">
    <button class="btn btn-ghost" id="dlg-cancel" type="button">Cancelar</button>
    <button class="btn btn-danger" id="dlg-confirm" type="button">Excluir</button>
  </div>
</dialog>


<script is:inline src="/admin/schema.js"></script>
<script is:inline src="/admin/jsoneditor.js"></script>
<script is:inline src="/admin/admin.js" defer></script>
</body>
</html>
