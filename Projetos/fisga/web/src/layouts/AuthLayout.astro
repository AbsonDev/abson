---
import '../styles/auth.css';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const site = (import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, site).toString();
const api = (import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5184').replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={descricao} />
    <title>{titulo} · Fisga</title>
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F8F4EA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-api={api}>
    <a class="skip" href="#main">Ir para o conteúdo</a>

    <div class="shell">
      <header class="masthead">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="5" r="1.8"></circle>
            <path d="M12 6.8V14a4.2 4.2 0 0 0 8.4 0v-1.6"></path>
            <path d="M20.4 10.6 22 8.9"></path>
          </svg>
          Fisga
        </a>
        <p class="brand-meta">Diário de pesca<br />Litoral de Sergipe</p>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="colophon">
        <span>Fisga — caderno de campo</span>
        <span>
          <a href="/termos">Termos de Uso</a> · <a href="/privacidade">Privacidade</a>
        </span>
      </footer>
    </div>

    <p class="sr-only" id="sr-status" role="status" aria-live="polite"></p>
  </body>
</html>
