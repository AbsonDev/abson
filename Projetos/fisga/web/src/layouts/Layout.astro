---
import Logo from '../components/Logo.astro';
import ContaMenu from '../components/ContaMenu.astro';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descricao?: string;
  bodyClass?: string;
  noindex?: boolean;
  imagem?: string;
  tipo?: string;
  jsonLd?: string;
}

const {
  titulo = 'Fisga — diário de pesca, troféus e estatísticas',
  descricao = 'Registre cada pescaria, as capturas, as condições e gere o card do troféu e um relatório em PDF. Grátis durante a validação.',
  bodyClass = '',
  noindex = false,
  imagem = '/og-fisga.png',
  tipo = 'website',
  jsonLd = ''
} = Astro.props;

const site = (import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, site).toString();
const api = (import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5184').replace(/\/$/, '');
const imagemAbsoluta = /^https?:\/\//.test(imagem)
  ? imagem
  : new URL(imagem, site).toString();
const caminho = Astro.url.pathname;
const mostrarTabbar = !['/entrar', '/boas-vindas', '/registrar'].some((rota) =>
  caminho.startsWith(rota)
);
const ativo = (...rotas: string[]) => rotas.some((rota) => caminho === rota || caminho.startsWith(`${rota}/`));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F8F4EA" />
    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Fisga" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagemAbsoluta} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Fisga" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={`${bodyClass} ${mostrarTabbar ? 'tem-tabbar' : ''}`.trim()} data-api={api}>
    <a class="pular-conteudo" href="#conteudo" data-pagefind-ignore>Pular para o conteúdo</a>

    <header class="topo" data-pagefind-ignore>
      <div class="container topo-interno">
        <Logo />
        <nav class="nav-principal" aria-label="Navegação principal">
          <a
            href="/hoje"
            class:list={['nav-produto', { ativo: ativo('/hoje', '/condicoes') }]}
            aria-current={ativo('/hoje', '/condicoes') ? 'page' : undefined}
          >Hoje</a>
          <a
            href="/meu-diario"
            class:list={['nav-produto', 'nav-auth-only', 'oculto', { ativo: ativo('/meu-diario') }]}
            aria-current={ativo('/meu-diario') ? 'page' : undefined}
          >Diário</a>
          <a
            href="/mapa"
            class:list={['nav-produto', { ativo: ativo('/mapa') }]}
            aria-current={ativo('/mapa') ? 'page' : undefined}
          >Mapa</a>
          <a
            href="/aprender"
            class:list={['nav-produto', { ativo: ativo('/aprender') }]}
            aria-current={ativo('/aprender') ? 'page' : undefined}
          >Aprender</a>
          <a href="/registrar" class="btn btn--pequeno btn--primario nav-produto-cta">Registrar pescaria</a>
          <ContaMenu />
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    {mostrarTabbar && (
      <nav class="tabbar" aria-label="Navegação principal no celular" data-pagefind-ignore>
        <div class="tabbar-in">
          <a
            href="/hoje"
            class:list={['tab', { ativo: ativo('/hoje', '/condicoes') }]}
            aria-current={ativo('/hoje', '/condicoes') ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <span>Hoje</span>
          </a>
          <a
            href="/meu-diario"
            class:list={['tab', 'nav-auth-only', 'oculto', { ativo: ativo('/meu-diario') }]}
            aria-current={ativo('/meu-diario') ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2V4z"/><path d="M9 8h5M9 12h5"/></svg>
            <span>Diário</span>
          </a>
          <a
            href="/registrar"
            class="tab tab-principal nav-auth-only oculto"
            aria-label="Registrar pescaria"
          >
            <span class="tab-bubble" aria-hidden="true">+</span>
            <span>Registrar</span>
          </a>
          <a
            href="/mapa"
            class:list={['tab', { ativo: ativo('/mapa') }]}
            aria-current={ativo('/mapa') ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span>Mapa</span>
          </a>
          <a
            href="/aprender"
            class:list={['tab', { ativo: ativo('/aprender') }]}
            aria-current={ativo('/aprender') ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v18H6.5A2.5 2.5 0 0 1 4 18.5v-13z"/><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H12v18h5.5a2.5 2.5 0 0 0 2.5-2.5v-13z"/></svg>
            <span>Aprender</span>
          </a>
        </div>
      </nav>
    )}

    <footer class="rodape" data-pagefind-ignore>
      <div class="container rodape-grade">
        <div class="rodape-marca">
          <Logo compacto />
          <p>Cada peixe tem uma história.<br />O Fisga guarda a sua.</p>
        </div>
        <div class="rodape-colunas">
          <div>
            <span class="rodape-titulo">Produto</span>
            <a href="/condicoes">Condições</a>
            <a href="/mapa">Mapa privado</a>
            <a href="/ferramentas">Ferramentas</a>
            <a href="/mapa?aba=locais">Meus locais</a>
            <a href="/registrar">Registrar pescaria</a>
            <a href="/meu-diario">Meu diário</a>
            <a href="/conta">Minha conta</a>
            <a href="/wiki">Wiki do Pescador</a>
            <a href="/precos">É grátis</a>
            <a href="/#como-funciona">Como funciona</a>
          </div>
          <div>
            <span class="rodape-titulo">Para quem</span>
            <a href="/registrar">Rio</a>
            <a href="/registrar">Mar</a>
            <a href="/registrar">Pesque-pague</a>
            <a href="/registrar">Represa</a>
            <a href="/registrar">Lagoa</a>
          </div>
          <div>
            <span class="rodape-titulo">Conta</span>
            <a href="/entrar">Entrar</a>
            <a href="/meu-diario">Meu diário</a>
            <a href="/conta">Minha conta</a>
          </div>
          <div>
            <span class="rodape-titulo">Fisga</span>
            <a href="/sobre">Sobre</a>
            <a href="/contato">Contato</a>
            <a href="/privacidade">Privacidade</a>
            <a href="/termos">Termos</a>
          </div>
        </div>
      </div>
      <div class="container rodape-base">
        <span>© {new Date().getFullYear()} Fisga</span>
        <span>Registre, solte e compartilhe com responsabilidade. Respeite o defeso e os tamanhos mínimos.</span>
      </div>
    </footer>

    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:' && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Sem service worker: o app continua funcionando online.
          });
        });
      }
    </script>
  </body>
</html>
