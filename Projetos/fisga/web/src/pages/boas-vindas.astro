---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const sugestoes = [
  { nome: 'Aracaju', cidade: 'Aracaju', estado: 'SE', latitude: -10.911, longitude: -37.071, ambiente: 'Mar' },
  { nome: 'Ilhabela', cidade: 'Ilhabela', estado: 'SP', latitude: -23.778, longitude: -45.358, ambiente: 'Mar' },
  { nome: 'Campinas', cidade: 'Campinas', estado: 'SP', latitude: -22.905, longitude: -47.06, ambiente: 'Represa' }
];
---

<Layout
  titulo="Bem-vindo ao Fisga"
  descricao="Escolha onde você pesca para abrir a janela de hoje e começar seu diário."
  noindex
  foco
>
  <section class="boas">
    <div class="boas-topo">
      <Logo compacto />
      <button id="boas-pular" class="boas-pular" type="button">Agora não</button>
    </div>

    <div class="boas-conteudo">
      <span class="eyebrow">Primeiro acesso</span>
      <h1 id="boas-titulo">Bem-vindo.</h1>
      <p class="boas-lead">
        Escolha onde você pesca para abrir a janela de hoje e começar seu diário.
      </p>

      <div class="boas-busca">
        <label class="boas-rotulo" for="boas-busca-local">Onde você pesca?</label>
        <div class="boas-campo">
          <svg class="boas-lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16 16l4.5 4.5"></path>
          </svg>
          <input
            id="boas-busca-local"
            type="search"
            placeholder="Cidade, praia ou represa"
            autocomplete="off"
          />
        </div>

        <button id="boas-usar-localizacao" class="btn btn--contorno boas-geo" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
          Usar minha localização
        </button>

        <ul id="boas-resultados" class="boas-resultados oculto" aria-label="Resultados da busca"></ul>
        <p id="boas-local-status" class="boas-status" role="status" aria-live="polite"></p>
      </div>

      <div class="boas-sugestoes">
        <p class="boas-sugestoes-rotulo">Ou comece por</p>
        <div class="boas-chips">
          {sugestoes.map((sugestao) => (
            <button
              type="button"
              class="boas-sugestao"
              data-nome={sugestao.nome}
              data-cidade={sugestao.cidade}
              data-estado={sugestao.estado}
              data-latitude={sugestao.latitude}
              data-longitude={sugestao.longitude}
              data-ambiente={sugestao.ambiente}
            >
              {sugestao.nome}
            </button>
          ))}
        </div>
      </div>

      <p class="boas-privacidade">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5" y="10" width="14" height="10" rx="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        <span>
          Privado por padrão. Nada é publicado até você compartilhar.
          <a href="/privacidade">Como funciona</a>
        </span>
      </p>
    </div>
  </section>
</Layout>

<style>
  .boas {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    padding: 20px 20px 44px;
    background:
      radial-gradient(circle at 92% 4%, rgba(23, 78, 87, 0.055), transparent 26rem),
      radial-gradient(circle at 4% 96%, rgba(217, 119, 63, 0.07), transparent 24rem),
      var(--papel);
  }

  .boas-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1000px);
    margin: 0 auto;
    gap: 16px;
  }

  .boas-pular {
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: transparent;
    color: var(--tinta-suave);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .boas-pular:hover {
    color: var(--tinta);
  }

  .boas-conteudo {
    width: min(100%, 620px);
    margin: auto;
    padding: clamp(40px, 10vh, 110px) 0 clamp(24px, 5vh, 48px);
  }

  .boas-conteudo h1 {
    margin-top: 14px;
    font-size: clamp(2.3rem, 6vw, 3.7rem);
  }

  .boas-lead {
    max-width: 50ch;
    margin-top: 16px;
    color: var(--tinta-suave);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .boas-busca {
    margin-top: 34px;
  }

  .boas-rotulo {
    display: block;
    margin-bottom: 8px;
    color: var(--tinta);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .boas-campo {
    position: relative;
  }

  .boas-lupa {
    position: absolute;
    top: 50%;
    left: 16px;
    width: 18px;
    height: 18px;
    color: var(--tinta-suave);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .boas-campo input {
    width: 100%;
    min-height: 52px;
    padding: 0 16px 0 46px;
    border: 1px solid var(--linha-forte);
    border-radius: 14px;
    background: var(--superficie);
    color: var(--tinta);
    font-size: 1rem;
  }

  .boas-campo input:focus {
    border-color: var(--terracota);
    box-shadow: 0 0 0 3px rgba(23, 78, 87, 0.14);
    outline: none;
  }

  .boas-campo input::placeholder {
    color: var(--tinta-suave);
    opacity: 0.8;
  }

  .boas-geo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 12px;
    padding: 0 16px;
    font-size: 0.8rem;
  }

  .boas-geo svg {
    width: 16px;
    height: 16px;
  }

  .boas-resultados {
    margin: 10px 0 0;
    padding: 6px;
    border: 1px solid var(--linha);
    border-radius: 14px;
    background: var(--superficie);
    box-shadow: var(--sombra-suave);
    list-style: none;
  }

  .boas-resultados li + li {
    border-top: 1px solid var(--linha);
  }

  .boas-resultado {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--tinta);
    font-size: 0.9rem;
    text-align: left;
  }

  .boas-resultado:hover,
  .boas-resultado:focus-visible {
    background: var(--superficie-2);
  }

  .boas-status {
    min-height: 1.5em;
    margin-top: 10px;
    color: var(--tinta-suave);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .boas-sugestoes {
    margin-top: 26px;
  }

  .boas-sugestoes-rotulo {
    color: var(--tinta-suave);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .boas-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .boas-sugestao {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--linha-forte);
    border-radius: 999px;
    background: transparent;
    color: var(--tinta);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .boas-sugestao:hover,
  .boas-sugestao:focus-visible {
    border-color: var(--terracota);
    background: var(--terracota-clara);
  }

  .boas-privacidade {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: clamp(40px, 8vh, 72px);
    padding-top: 18px;
    border-top: 1px solid var(--linha);
    color: var(--tinta-suave);
    font-size: 0.74rem;
    line-height: 1.6;
  }

  .boas-privacidade svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .boas-privacidade a {
    color: var(--terracota);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .boas {
      padding: 16px 18px 36px;
    }

    .boas-conteudo {
      padding-top: clamp(32px, 7vh, 64px);
    }

    .boas-geo {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { destinoSeguro } from '../lib/auth';

  const API = (document.body.dataset.api || 'http://localhost:5184').replace(/\/$/, '');
  const titulo = document.getElementById('boas-titulo');
  const status = document.getElementById('boas-local-status');
  const busca = document.getElementById('boas-busca-local');
  const resultados = document.getElementById('boas-resultados');
  let timerBusca = 0;
  let salvando = false;

  function primeiroNome(nome) {
    const limpo = String(nome || '').trim();
    return limpo ? limpo.split(/\s+/)[0] : 'pescador';
  }

  function destino() {
    try {
      const salvo = sessionStorage.getItem('fisga:retorno');
      if (salvo !== null) sessionStorage.removeItem('fisga:retorno');
      return destinoSeguro(salvo, '/hoje');
    } catch {
      return '/hoje';
    }
  }

  function escreverStatus(mensagem) {
    if (status) status.textContent = mensagem;
  }

  function esconderResultados() {
    if (!resultados) return;
    resultados.innerHTML = '';
    resultados.classList.add('oculto');
  }

  async function iniciar() {
    try {
      const resposta = await fetch(`${API}/api/auth/me`, { credentials: 'include' });
      const dados = await resposta.json().catch(() => ({}));

      if (!dados.autenticado || !dados.usuario) {
        window.location.replace('/entrar?voltar=/hoje');
        return;
      }

      if (dados.consentimentoPendente) {
        window.location.replace(
          '/aceite?destino=' + encodeURIComponent(window.location.pathname + window.location.search)
        );
        return;
      }

      if (titulo) titulo.textContent = `Bem-vindo, ${primeiroNome(dados.usuario.nome)}.`;
    } catch {
      escreverStatus('Não foi possível carregar sua conta. Recarregue a página.');
    }
  }

  async function salvarLocal(local) {
    if (salvando) return;
    salvando = true;
    escreverStatus('Abrindo seu dia…');

    const corpo = {
      nome: local.nome,
      latitude: local.latitude,
      longitude: local.longitude,
      ambiente: local.ambiente ?? 'Outro',
      padrao: true
    };
    if (local.cidade != null) corpo.cidade = local.cidade;
    if (local.estado != null) corpo.estado = local.estado;

    try {
      const resposta = await fetch(`${API}/api/locais`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(corpo)
      });

      if (resposta.status === 401) {
        window.location.assign(`/entrar?voltar=${encodeURIComponent('/hoje')}`);
        return;
      }

      const dados = await resposta.json().catch(() => ({}));
      if (!resposta.ok) throw new Error(dados.detalhe || 'Não foi possível salvar o local.');
      window.location.assign(destino());
    } catch (falha) {
      salvando = false;
      escreverStatus(falha instanceof Error ? falha.message : 'Não foi possível salvar o local.');
    }
  }

  async function buscarLocal(termo) {
    const limpo = termo.trim();
    if (limpo.length < 2) {
      esconderResultados();
      escreverStatus('');
      return;
    }

    escreverStatus('Buscando…');
    try {
      const resposta = await fetch(`${API}/api/locais/buscar?q=${encodeURIComponent(limpo)}`);
      if (!resposta.ok) throw new Error('busca');
      const lista = await resposta.json();

      if (!Array.isArray(lista) || lista.length === 0) {
        esconderResultados();
        escreverStatus('Nenhum lugar encontrado. Tente o nome da cidade.');
        return;
      }

      resultados.innerHTML = '';
      for (const item of lista) {
        const linha = document.createElement('li');
        const opcao = document.createElement('button');
        opcao.type = 'button';
        opcao.className = 'boas-resultado';
        opcao.textContent = `${item.nome}${item.estado ? ` · ${item.estado}` : ''}`;
        opcao.addEventListener('click', () =>
          salvarLocal({
            nome: item.nome ?? item.cidade ?? 'Meu local',
            cidade: item.cidade ?? item.nome,
            estado: item.estado ?? null,
            latitude: Number(item.latitude),
            longitude: Number(item.longitude),
            ambiente: 'Outro'
          })
        );
        linha.appendChild(opcao);
        resultados.appendChild(linha);
      }

      escreverStatus('');
      resultados.classList.remove('oculto');
    } catch {
      esconderResultados();
      escreverStatus('Não foi possível buscar agora. Tente de novo.');
    }
  }

  busca?.addEventListener('input', () => {
    window.clearTimeout(timerBusca);
    timerBusca = window.setTimeout(() => buscarLocal(busca.value), 320);
  });

  for (const botao of document.querySelectorAll('.boas-sugestao')) {
    botao.addEventListener('click', () => {
      salvarLocal({
        nome: botao.dataset.nome,
        cidade: botao.dataset.cidade,
        estado: botao.dataset.estado,
        latitude: Number(botao.dataset.latitude),
        longitude: Number(botao.dataset.longitude),
        ambiente: botao.dataset.ambiente
      });
    });
  }

  void iniciar();
</script>
