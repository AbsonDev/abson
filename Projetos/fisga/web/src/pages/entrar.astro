---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
  titulo="Entrar"
  descricao="Entre no Fisga com e-mail e senha, Google ou link de acesso. Seu diário de pesca em qualquer aparelho."
>
  <section class="screen">
    <div class="screen-inner">
      <header class="screen-head">
        <p class="eyebrow">Acesso ao Fisga</p>
        <h1 tabindex="-1">Seu diário está <em>onde você deixou</em>.</h1>
        <p class="sub">Entre para ver a janela de hoje e suas pescarias.</p>
      </header>

      <div class="auth">
        <div class="note" id="entrar-aviso" role="status" hidden>
          <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
          <span id="entrar-aviso-texto"></span>
        </div>
        <div class="note note--error" id="entrar-erro" role="alert" hidden>
          <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
          <span id="entrar-erro-texto"></span>
        </div>

        <button type="button" class="btn btn-ghost btn-block" id="google-login" hidden>
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
          </svg>
          <span class="spinner" hidden></span>
          <span data-btn-label>Continuar com Google</span>
        </button>

        <div class="divider"><span>ou</span></div>

        <form id="login-form" class="auth-form" novalidate>
          <div class="field">
            <label class="label" for="login-email">E-mail</label>
            <div class="control">
              <input class="input" id="login-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" maxlength="254" required aria-describedby="login-email-error" />
            </div>
            <p class="field-error" id="login-email-error" role="alert" hidden>
              <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
              <span data-err-text></span>
            </p>
          </div>

          <div class="field">
            <label class="label" for="login-password">Senha</label>
            <div class="control">
              <input class="input input--reveal" id="login-password" name="password" type="password" autocomplete="current-password" required aria-describedby="login-password-error" />
              <button type="button" class="reveal" data-reveal="login-password" aria-pressed="false" aria-label="Mostrar senha">
                <svg class="od-icon od-icon--lg" data-icon="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-5.5 9.5-5.5S21.5 12 21.5 12s-3.5 5.5-9.5 5.5S2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
                <svg class="od-icon od-icon--lg" data-icon="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><path d="m4 4 16 16"></path><path d="M10.6 6.7A9.6 9.6 0 0 1 12 6.5c6 0 9.5 5.5 9.5 5.5a16 16 0 0 1-3.1 3.5"></path><path d="M6.4 8.4A16 16 0 0 0 2.5 12s3.5 5.5 9.5 5.5a9 9 0 0 0 3.2-.6"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
              </button>
            </div>
            <p class="field-error" id="login-password-error" role="alert" hidden>
              <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
              <span data-err-text></span>
            </p>
          </div>

          <div class="note note--error" id="login-error" role="alert" hidden>
            <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
            <div class="note-body">
              <strong>E-mail ou senha incorretos.</strong>
              <span id="login-error-detalhe">Confira os dados e tente de novo. Se continuar, redefina sua senha.</span>
            </div>
          </div>

          <div class="note" id="login-unconfirmed" role="status" hidden>
            <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
            <div class="note-body">
              <strong>Sua conta ainda não foi confirmada.</strong>
              <span>Confirme o e-mail para entrar. Se o link já venceu, envie outro.</span>
              <button type="button" class="btn btn-quiet" id="login-resend">
                <span class="spinner" hidden></span>
                <span data-btn-label>Reenviar link de confirmação</span>
              </button>
              <p class="note-inline" id="login-resend-note" hidden>Novo link enviado. Confira a caixa de entrada e o spam.</p>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block" id="login-submit">
            <span class="spinner" hidden></span>
            <span data-btn-label>Entrar</span>
          </button>

          <div class="link-row">
            <a class="linkish" href="/esqueci-senha">Esqueci a senha</a>
            <a class="linkish" href="/criar-conta">Criar conta</a>
          </div>
        </form>

        <div class="alt-access">
          <p class="alt-title">Prefere sem senha?</p>
          <p class="alt-copy">Enviamos um link de acesso ao seu e-mail. Você entra sem digitar senha.</p>
          <button type="button" class="btn btn-quiet" id="magic-btn">
            <span class="spinner" hidden></span>
            <span data-btn-label>Enviar link de acesso</span>
          </button>
          <p class="note note--success" id="magic-note" role="status" hidden>
            <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>
            <span>Enviamos um link de acesso para <strong id="magic-email"></strong>. Confira a caixa de entrada e o spam.</span>
          </p>
        </div>
      </div>
    </div>
  </section>
</AuthLayout>

<script>
  import { apiBase, obterSessao, postJson } from '../lib/auth';

  const API = apiBase();
  const parametros = new URLSearchParams(window.location.search);
  const ERROS: Record<string, string> = {
    link_expirado: 'Esse link expirou. Peça um novo acesso abaixo.',
    link_ja_usado: 'Esse link já foi usado. Peça um novo acesso abaixo.',
    link_invalido: 'Esse link não é válido. Peça um novo acesso abaixo.',
    sessao_expirada: 'Sua sessão expirou. Entre novamente para continuar.',
    google_indisponivel: 'O login com Google não está disponível agora. Use seu e-mail.',
    google_sessao_externa_invalida: 'Não concluímos o acesso com Google. Tente de novo.',
    google_email_nao_verificado_localmente: 'O e-mail do Google precisa ser o mesmo da sua conta confirmada.',
    confirmacao_pendente: 'Sua conta ainda não foi confirmada. Entre com sua senha para receber um novo link.'
  };

  function alvo() {
    const explicito = parametros.get('destino') || parametros.get('voltar');
    if (explicito && explicito.startsWith('/') && !explicito.startsWith('//')) return explicito;
    try {
      const salvo = sessionStorage.getItem('fisga:retorno');
      if (salvo && salvo.startsWith('/') && !salvo.startsWith('//')) {
        sessionStorage.removeItem('fisga:retorno');
        return salvo;
      }
    } catch {
      // armazenamento indisponível
    }
    return '/hoje';
  }

  const voltar = parametros.get('voltar');
  if (voltar && voltar.startsWith('/') && !voltar.startsWith('//')) {
    try {
      sessionStorage.setItem('fisga:retorno', voltar);
    } catch {
      // armazenamento indisponível
    }
  }

  const erroGeral = document.getElementById('entrar-erro') as HTMLElement;
  const erroGeralTexto = document.getElementById('entrar-erro-texto') as HTMLElement;
  const avisoGeral = document.getElementById('entrar-aviso') as HTMLElement;
  const avisoGeralTexto = document.getElementById('entrar-aviso-texto') as HTMLElement;

  const codigoErro = parametros.get('erro');
  if (codigoErro) {
    erroGeralTexto.textContent = ERROS[codigoErro] ?? 'Não foi possível confirmar o acesso. Peça um novo link.';
    erroGeral.hidden = false;
  }
  if (parametros.get('saiu') === '1') {
    avisoGeralTexto.textContent = 'Você saiu da conta. Até a próxima pescaria.';
    avisoGeral.hidden = false;
  }

  function mensagemErro(mensagem: string | undefined, padrao: string) {
    return mensagem && mensagem.trim() ? mensagem : padrao;
  }

  function setLoading(botao: HTMLButtonElement | null, ocupado: boolean, rotulo?: string) {
    if (!botao) return;
    const label = botao.querySelector('[data-btn-label]') as HTMLElement | null;
    const spinner = botao.querySelector('.spinner') as HTMLElement | null;
    if (label && !botao.dataset.idleLabel) botao.dataset.idleLabel = label.textContent ?? '';
    if (spinner) spinner.hidden = !ocupado;
    if (label) label.textContent = ocupado ? rotulo ?? botao.dataset.idleLabel ?? '' : botao.dataset.idleLabel ?? '';
    botao.disabled = ocupado;
    botao.setAttribute('aria-busy', ocupado ? 'true' : 'false');
  }

  function erroCampo(id: string, mensagem: string) {
    const input = document.getElementById(id) as HTMLInputElement | null;
    const bloco = document.getElementById(`${id}-error`) as HTMLElement | null;
    if (input) {
      input.setAttribute('aria-invalid', 'true');
      input.focus();
    }
    if (bloco) {
      const texto = bloco.querySelector('[data-err-text]') as HTMLElement | null;
      if (texto) texto.textContent = mensagem;
      bloco.hidden = false;
    }
  }

  function limparErroCampo(id: string) {
    const input = document.getElementById(id);
    const bloco = document.getElementById(`${id}-error`);
    input?.removeAttribute('aria-invalid');
    if (bloco) bloco.hidden = true;
  }

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const emailInput = document.getElementById('login-email') as HTMLInputElement;
  const senhaInput = document.getElementById('login-password') as HTMLInputElement;
  const loginErro = document.getElementById('login-error') as HTMLElement;
  const loginErroDetalhe = document.getElementById('login-error-detalhe') as HTMLElement;
  const loginNaoConfirmado = document.getElementById('login-unconfirmed') as HTMLElement;

  emailInput?.addEventListener('input', () => limparErroCampo('login-email'));
  senhaInput?.addEventListener('input', () => limparErroCampo('login-password'));

  document.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((botao) => {
    const input = document.getElementById(botao.dataset.reveal ?? '') as HTMLInputElement | null;
    if (!input) return;
    botao.addEventListener('click', () => {
      const mostrando = input.type === 'text';
      input.type = mostrando ? 'password' : 'text';
      botao.setAttribute('aria-pressed', String(!mostrando));
      botao.setAttribute('aria-label', mostrando ? 'Mostrar senha' : 'Ocultar senha');
      const eye = botao.querySelector('[data-icon="eye"]') as HTMLElement | null;
      const eyeOff = botao.querySelector('[data-icon="eye-off"]') as HTMLElement | null;
      if (eye) eye.style.display = mostrando ? 'none' : '';
      if (eyeOff) eyeOff.style.display = mostrando ? '' : 'none';
      input.focus();
    });
  });

  const google = document.getElementById('google-login') as HTMLButtonElement;
  fetch(`${API}/api/auth/google/disponivel`)
    .then((resposta) => (resposta.ok ? resposta.json() : null))
    .then((dados: { disponivel?: boolean } | null) => {
      if (dados?.disponivel === true) google.hidden = false;
    })
    .catch(() => {
      // Sem rede, o botão permanece oculto.
    });

  google.addEventListener('click', () => {
    setLoading(google, true, 'Abrindo Google…');
    window.location.assign(`${API}/api/auth/google/iniciar`);
  });

  const formulario = document.getElementById('login-form') as HTMLFormElement;
  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    loginErro.hidden = true;
    loginNaoConfirmado.hidden = true;
    limparErroCampo('login-email');
    limparErroCampo('login-password');

    const email = emailInput.value.trim();
    const senha = senhaInput.value;
    if (!EMAIL.test(email)) {
      erroCampo('login-email', email ? 'Esse e-mail parece incompleto. Confira o endereço.' : 'Informe seu e-mail.');
      return;
    }
    if (!senha) {
      erroCampo('login-password', 'Informe sua senha.');
      return;
    }

    const botao = document.getElementById('login-submit') as HTMLButtonElement;
    setLoading(botao, true, 'Entrando…');
    const resposta = await postJson<{ autenticado?: boolean; mensagem?: string | null }>(
      '/api/auth/entrar',
      { email, senha },
      API
    );
    setLoading(botao, false);

    if (!resposta.ok) {
      loginErroDetalhe.textContent = mensagemErro(
        resposta.mensagem,
        'Não foi possível entrar agora. Tente novamente.'
      );
      loginErro.hidden = false;
      return;
    }

    if (!resposta.dados?.autenticado) {
      const mensagem = resposta.mensagem ?? '';
      if (/confirme seu e-mail/i.test(mensagem)) {
        loginNaoConfirmado.hidden = false;
      } else {
        loginErroDetalhe.textContent = mensagemErro(mensagem, 'E-mail ou senha incorretos.');
        loginErro.hidden = false;
      }
      return;
    }

    const sessao = await obterSessao(API);
    const destino = alvo();
    if (sessao?.consentimentoPendente) {
      window.location.replace(`/aceite?destino=${encodeURIComponent(destino)}`);
    } else {
      window.location.assign(destino);
    }
  });

  const reenviar = document.getElementById('login-resend') as HTMLButtonElement;
  reenviar.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!EMAIL.test(email)) {
      erroCampo('login-email', 'Informe seu e-mail para receber um novo link.');
      return;
    }
    setLoading(reenviar, true, 'Reenviando…');
    const resposta = await postJson('/api/auth/solicitar', { email }, API);
    setLoading(reenviar, false);
    const nota = document.getElementById('login-resend-note') as HTMLElement;
    nota.hidden = false;
    if (!resposta.ok) nota.textContent = 'Não foi possível enviar agora. Tente de novo em instantes.';
  });

  const magico = document.getElementById('magic-btn') as HTMLButtonElement;
  magico.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!EMAIL.test(email)) {
      erroCampo('login-email', email ? 'Esse e-mail parece incompleto. Confira o endereço.' : 'Informe seu e-mail para receber o link.');
      return;
    }
    setLoading(magico, true, 'Enviando…');
    const resposta = await postJson<{ linkDesenvolvimento?: string | null }>(
      '/api/auth/solicitar',
      { email },
      API
    );
    setLoading(magico, false);
    if (!resposta.ok) {
      loginErroDetalhe.textContent = mensagemErro(resposta.mensagem, 'Não foi possível enviar o link agora.');
      loginErro.hidden = false;
      return;
    }
    const echoed = document.getElementById('magic-email') as HTMLElement;
    echoed.textContent = email;
    document.getElementById('magic-note')!.hidden = false;
  });
</script>
