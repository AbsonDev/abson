---
import Layout from '../layouts/Layout.astro';
---

<Layout
  titulo="Meu diário — Fisga"
  descricao="Seu diário privado de pesca, com capturas, troféus, estatísticas e recordes."
  noindex
>
  <section class="calc-topo">
    <div class="container">
      <span class="eyebrow" id="saudacao">Meu diário</span>
      <h1>Suas histórias, <em>lado a lado.</em></h1>
      <p>
        Recordes, espécies, iscas e locais que funcionaram. O diário é privado na sua conta; cada
        pescaria tem seu próprio link público.
      </p>
      <div class="hero-acoes oculto" id="acoes-logado">
        <a class="btn btn--primario" href="/registrar">Registrar nova pescaria</a>
        <a class="btn btn--contorno" href="/conta">Minha conta</a>
      </div>
      <div class="hero-acoes" id="acoes-deslogado">
        <a class="btn btn--primario" href="/entrar?voltar=/meu-diario">Entrar no diário</a>
        <a class="btn btn--contorno" href="/registrar">Conhecer o registro</a>
      </div>
    </div>
  </section>

  <section class="container" style="padding-bottom: 80px;">
    <div id="erro" class="erro-caixa" role="alert"></div>

    <div id="carregando" class="aviso">Carregando seu diário...</div>

    <div id="acesso" class="estado-vazio oculto" style="margin-top: 10px;">
      <span class="eyebrow">Diário privado</span>
      <h2>Entre para abrir seu diário.</h2>
      <p>
        Sua conta guarda as pescarias, os troféus e os padrões em qualquer aparelho. O acesso é por
        e-mail, sem senha, e o diário completo só aparece para você.
      </p>
      <div class="diario-stats" style="max-width: 720px; margin: 26px auto 0;">
        <div class="stat-card"><span>Pescarias</span><strong>—</strong><small>seus dias na água</small></div>
        <div class="stat-card"><span>Capturas</span><strong>—</strong><small>peixes no diário</small></div>
        <div class="stat-card"><span>Recorde</span><strong>—</strong><small>seu maior peixe</small></div>
        <div class="stat-card"><span>Soltos</span><strong>—</strong><small>devolvidos à água</small></div>
      </div>
      <div class="hero-acoes" style="justify-content: center; margin-top: 24px;">
        <a class="btn btn--primario" href="/entrar?voltar=/meu-diario">Entrar com e-mail</a>
        <a class="btn btn--contorno" href="/registrar">Registrar pescaria</a>
      </div>
      <p style="margin-top: 16px; font-size: 0.68rem;">
        Ainda não tem conta? O primeiro acesso cria a sua automaticamente.
      </p>
    </div>

    <div id="conteudo-diario" class="oculto">
      <div class="diario-abas" role="tablist" aria-label="Seções do diário">
        <button type="button" role="tab" data-diario-aba="visao" aria-selected="true">Visão geral</button>
        <button type="button" role="tab" data-diario-aba="pescarias" aria-selected="false">Pescarias</button>
        <button type="button" role="tab" data-diario-aba="insights" aria-selected="false">Insights</button>
      </div>

      <div data-diario-painel="visao">
      <div class="diario-stats">
        <div class="stat-card"><span>Pescarias</span><strong id="stat-pescarias">0</strong><small>dias registrados</small></div>
        <div class="stat-card"><span>Capturas</span><strong id="stat-capturas">0</strong><small>peixes no diário</small></div>
        <div class="stat-card"><span>Maior peixe</span><strong id="stat-maior">—</strong><small id="stat-maior-especie">maior peso</small></div>
        <div class="stat-card"><span>Soltos</span><strong id="stat-soltos">0</strong><small id="stat-soltos-detalhe">devolvidos à água</small></div>
      </div>

      <div class="grade-2" style="margin-bottom: 28px;">
        <article class="cartao">
          <span class="selo selo--terracota">Resumo</span>
          <div class="mini-tabela" style="margin-top: 12px;">
            <div><span>Espécie top</span><strong id="stat-especie">—</strong></div>
            <div><span>Isca top</span><strong id="stat-isca">—</strong></div>
            <div><span>Local top</span><strong id="stat-local">—</strong></div>
            <div><span>Maior comprimento</span><strong id="stat-comprimento">—</strong></div>
          </div>
        </article>

        <article class="cartao" style="background: var(--creme);">
          <span class="selo selo--terracota">Sua conta</span>
          <h2 style="margin-top: 12px;">O diário acompanha você.</h2>
          <p>
            Entre com o mesmo e-mail em qualquer aparelho e continue de onde parou. Não há link de
            backup para perder: a sua conta é a chave.
          </p>
          <div class="acoes-calculo">
            <a class="btn btn--contorno" href="/conta">Ver minha conta</a>
          </div>
        </article>
      </div>
      </div>

      <div data-diario-painel="insights" hidden>
      <section id="insights-secao" class="oculto" style="margin-bottom: 28px;">
        <div class="cabecalho-secao" style="margin-bottom: 14px;">
          <div>
            <span class="eyebrow">Seus padrões</span>
            <h2 style="font-size: clamp(1.5rem, 2.6vw, 2rem);">O que mais funcionou</h2>
          </div>
        </div>
        <div class="diario-stats" id="insights" style="margin: 0;"></div>
        <div class="grade-2" style="margin-top: 14px;">
          <article class="cartao">
            <span class="selo selo--terracota">Recordes</span>
            <h2 style="margin-top: 12px;">Por espécie</h2>
            <div class="mini-tabela" id="recordes"></div>
          </article>
          <article class="cartao">
            <span class="selo selo--terracota">Iscas</span>
            <h2 style="margin-top: 12px;">O que funciona por espécie</h2>
            <div class="mini-tabela" id="iscas-especie"></div>
          </article>
        </div>
      </section>

      <section id="sinais-secao" class="oculto" style="margin-bottom: 28px;">
        <div class="cabecalho-secao" style="margin-bottom: 14px;">
          <div>
            <span class="eyebrow">Sinais do seu diário</span>
            <h2 style="font-size: clamp(1.5rem, 2.6vw, 2rem);">O que os seus dados sugerem</h2>
          </div>
        </div>
        <div class="grade-2" id="sinais"></div>
        <p class="fonte-pequena" style="margin-top: 10px;">
          Sinal, não garantia: são poucas pescarias e muitas variáveis. Use como pista para o próximo teste.
        </p>
      </section>
      </div>

      <div data-diario-painel="pescarias" hidden>
      <div class="cabecalho-secao" style="margin-bottom: 18px;">
        <div>
          <span class="eyebrow">Histórico</span>
          <h2 style="font-size: clamp(1.7rem, 3vw, 2.3rem);">Pescarias registradas</h2>
        </div>
      </div>

      <div id="lista" class="diario-lista"></div>

      <div id="vazio" class="estado-vazio oculto" style="margin-top: 20px;">
        <span class="eyebrow">Água parada</span>
        <h2>Seu primeiro registro está esperando.</h2>
        <p>Veja as condições de hoje, salve seu local ou registre a primeira pescaria.</p>
        <div class="hero-acoes" style="justify-content: center; margin-top: 18px;">
          <a class="btn btn--primario" href="/registrar">Registrar primeira pescaria</a>
          <a class="btn btn--contorno" href="/hoje">Ver condições de hoje</a>
          <a class="btn btn--contorno" href="/mapa?aba=locais">Salvar meu local</a>
        </div>
      </div>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    const API = (document.body.dataset.api || 'http://localhost:5184').replace(/\/$/, '');
    const conteudo = document.getElementById('conteudo-diario');
    const carregando = document.getElementById('carregando');
    const acesso = document.getElementById('acesso');
    const erro = document.getElementById('erro');
    const lista = document.getElementById('lista');
    const vazio = document.getElementById('vazio');
    const acoesLogado = document.getElementById('acoes-logado');
    const acoesDeslogado = document.getElementById('acoes-deslogado');
    const saudacao = document.getElementById('saudacao');
    const abasDiario = [...document.querySelectorAll('[data-diario-aba]')];
    const paineisDiario = [...document.querySelectorAll('[data-diario-painel]')];

    function abrirAbaDiario(nome) {
      for (const aba of abasDiario) {
        aba.setAttribute('aria-selected', String(aba.dataset.diarioAba === nome));
      }
      for (const painel of paineisDiario) {
        painel.hidden = painel.dataset.diarioPainel !== nome;
      }
    }

    for (const aba of abasDiario) {
      aba.addEventListener('click', () => abrirAbaDiario(aba.dataset.diarioAba));
    }
    const reais = (valor) =>
      Number(valor || 0).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    const escapar = (texto) =>
      String(texto ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    const data = (iso) => {
      if (!iso) return '';
      return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(
        new Date(`${iso}T12:00:00`)
      );
    };

    function mostrarAcesso() {
      carregando.classList.add('oculto');
      conteudo.classList.add('oculto');
      acesso.classList.remove('oculto');
      acoesLogado.classList.add('oculto');
      acoesDeslogado.classList.remove('oculto');
    }

    function mostrarErro(mensagem) {
      carregando.classList.add('oculto');
      erro.textContent = mensagem;
      erro.classList.add('visivel');
    }

    async function carregarDiario() {
      erro.classList.remove('visivel');
      try {
        const resposta = await fetch(`${API}/api/diario`, { credentials: 'include' });
        if (resposta.status === 401) {
          mostrarAcesso();
          return;
        }

        const dados = await resposta.json().catch(() => ({}));
        if (!resposta.ok) throw new Error(dados.detalhe || 'Não foi possível carregar o diário.');

        carregando.classList.add('oculto');
        conteudo.classList.remove('oculto');
        acesso.classList.add('oculto');

        document.getElementById('stat-pescarias').textContent = dados.totalPescarias ?? 0;
        document.getElementById('stat-capturas').textContent = dados.totalCapturas ?? 0;
        document.getElementById('stat-soltos').textContent = dados.totalSoltos ?? 0;
        const soltosDetalhe = document.getElementById('stat-soltos-detalhe');
        if (soltosDetalhe) {
          soltosDetalhe.textContent = dados.totalCapturas > 0
            ? `${reais(dados.taxaDeSoltura)}% do total`
            : 'devolvidos à água';
        }

        document.getElementById('stat-maior').textContent = dados.maiorPesoKg ? `${reais(dados.maiorPesoKg)} kg` : '—';
        document.getElementById('stat-especie').textContent = dados.especieTop || '—';
        document.getElementById('stat-isca').textContent = dados.iscaTop || '—';
        document.getElementById('stat-local').textContent = dados.localTop || '—';
        document.getElementById('stat-comprimento').textContent = dados.maiorComprimentoCm
          ? `${reais(dados.maiorComprimentoCm)} cm`
          : '—';
        document.getElementById('stat-maior-especie').textContent = dados.especieTop
          ? `maior peso · ${dados.especieTop}`
          : 'maior peso';

        const insights = dados.insights || [];
        if (insights.length > 0) {
          document.getElementById('insights-secao').classList.remove('oculto');
          document.getElementById('insights').innerHTML = insights.map((item) => `
            <div class="stat-card insight-card">
              <span>${escapar(item.rotulo)}</span>
              <strong>${escapar(item.valor)}</strong>
              <small>${escapar(item.detalhe)}</small>
            </div>
          `).join('');
        }

        const sinais = dados.comparacoes || [];
        if (sinais.length > 0) {
          document.getElementById('sinais-secao').classList.remove('oculto');
          document.getElementById('sinais').innerHTML = sinais.map((item) => {
            const mais = item.diferencaPercentual >= 0;
            const pct = Math.abs(Math.round(item.diferencaPercentual));
            return `
              <article class="cartao sinal-card">
                <span class="eyebrow">${escapar(item.dimensao)}</span>
                <h3>${mais ? '+' : '−'}${pct}% de capturas com ${escapar(item.valor.toLowerCase())}</h3>
                <p>${item.capturasCom} capturas em ${item.pescariasCom} pescarias, contra ${item.capturasSem} em ${item.pescariasSem}.</p>
              </article>
            `;
          }).join('');
        }

        const recordes = dados.recordesPorEspecie || [];
        document.getElementById('recordes').innerHTML = recordes.length > 0
          ? recordes.map((item) => `
              <div>
                <span>${escapar(item.especie)}</span>
                <strong>${item.pesoKg ? `${reais(item.pesoKg)} kg` : `${reais(item.comprimentoCm)} cm`}</strong>
              </div>
            `).join('')
          : '<p style="color: var(--tinta-suave); font-size: 0.74rem;">Registre capturas para ver seus recordes.</p>';

        const iscasPorEspecie = dados.iscasPorEspecie || [];
        document.getElementById('iscas-especie').innerHTML = iscasPorEspecie.length > 0
          ? iscasPorEspecie.map((item) => `
              <div>
                <span>${escapar(item.especie)}</span>
                <strong>${escapar(item.isca)} · ${item.capturas}</strong>
              </div>
            `).join('')
          : '<p style="color: var(--tinta-suave); font-size: 0.74rem;">Adicione a isca nas capturas para descobrir padrões.</p>';

        const pescarias = dados.pescarias || [];
        if (pescarias.length === 0) abrirAbaDiario('pescarias');
        if (pescarias.length === 0) {
          lista.innerHTML = '';
          vazio.classList.remove('oculto');
          return;
        }

        vazio.classList.add('oculto');
        lista.innerHTML = pescarias
          .map((pescaria) => {
            const foto = pescaria.fotoCapa
              ? `<div class="pescaria-card-foto"><img src="${API}${escapar(pescaria.fotoCapa)}" alt="Foto da pescaria" loading="lazy" /></div>`
              : '';
            return `
              <article class="pescaria-card">
                ${foto}
                <div class="pescaria-card-topo">
                  <div>
                    <h2>${escapar(pescaria.local)}</h2>
                    <p>${escapar(pescaria.ambienteNome)} · ${data(pescaria.data)}</p>
                  </div>
                  <span class="selo selo--neutro">${pescaria.capturas} ${pescaria.capturas === 1 ? 'peixe' : 'peixes'}</span>
                </div>
                <div class="pescaria-card-numeros">
                  <span>Maior: ${pescaria.maiorPesoKg ? `${reais(pescaria.maiorPesoKg)} kg` : 'sem peso'}</span>
                  <span>${escapar(pescaria.ambienteNome)}</span>
                </div>
                <div class="pescaria-card-acoes">
                  <a class="link-seta" href="/p/${encodeURIComponent(pescaria.shareToken)}">Abrir pescaria</a>
                  <a class="pescaria-editar" href="/registrar?editar=${encodeURIComponent(pescaria.id)}">Editar</a>
                </div>
              </article>
            `;
          })
          .join('');
      } catch (falha) {
        mostrarErro(falha instanceof Error ? falha.message : 'Não foi possível carregar o diário.');
      }
    }

    (async function iniciar() {
      try {
        const resposta = await fetch(`${API}/api/auth/me`, { credentials: 'include' });
        const dados = await resposta.json().catch(() => ({}));

        if (!dados.autenticado || !dados.usuario) {
          mostrarAcesso();
          return;
        }

        acoesLogado.classList.remove('oculto');
        acoesDeslogado.classList.add('oculto');
        saudacao.textContent = `Diário de ${dados.usuario.nomeExibicao}`;
        await carregarDiario();
      } catch {
        mostrarAcesso();
      }
    })();
  </script>
</Layout>

<style>
  .pescaria-editar {
    color: var(--tinta-suave);
    font-size: 0.66rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pescaria-editar:hover {
    color: var(--terracota);
  }
</style>
