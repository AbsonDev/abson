---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import FerramentasNav from '../../components/ferramentas/FerramentasNav.astro';
import { avisoDefeso, checklistDefeso, orgaosAmbientais } from '../../data/defeso';

const ufParam = Astro.url.searchParams.get('uf')?.trim().toUpperCase() ?? '';
const orgao =
  orgaosAmbientais.find((item) => item.uf === ufParam) ??
  orgaosAmbientais.find((item) => item.uf === 'SP')!;

const linkLicenca =
  'https://www.gov.br/mpa/pt-br/assuntos/cadastro-registro-e-monitoramento/pescadora-e-pescador-amador-ou-esportivo/solicitar-registro-de-pescador-amador-1';
---

<Layout
  titulo="Defeso e tamanho mínimo por estado — Fisga"
  descricao="Consulte o órgão ambiental da sua UF, o que confirmar sobre defeso, tamanho mínimo e licença antes de pescar."
>
  <section class="ferramentas-topo">
    <div class="container">
      <span class="eyebrow">Defeso e legislação</span>
      <h1>Regra certa, <em>sem chute.</em></h1>
      <p>
        O período de defeso e o tamanho mínimo mudam por bacia, espécie e ano. Escolha a UF, abra o
        órgão oficial e confira a portaria vigente antes de sair.
      </p>
      <FerramentasNav />
    </div>
  </section>

  <section class="container ferramentas-conteudo">
    <form class="defeso-form" method="get">
      <div class="campo">
        <label for="uf">Estado (UF)</label>
        <select id="uf" name="uf">
          {orgaosAmbientais.map((item) => (
            <option value={item.uf} selected={item.uf === orgao.uf}>
              {item.uf} — {item.estado}
            </option>
          ))}
        </select>
      </div>
      <button class="btn btn--primario" type="submit">Consultar órgão</button>
    </form>

    <div class="defeso-grade">
      <article class="cartao defeso-orgao">
        <span class="eyebrow">Órgão ambiental · {orgao.uf}</span>
        <h2>{orgao.orgao}</h2>
        <p>{orgao.estado}</p>
        <a class="btn btn--primario" href={orgao.site} target="_blank" rel="noopener">
          Abrir portal oficial
        </a>
        <p class="fonte-pequena">
          Procure no portal por “defeso”, “pesca” ou “tamanho mínimo”. A regra pode estar em
          portaria, instrução normativa ou resolução do ano.
        </p>
      </article>

      <article class="cartao defeso-lista">
        <span class="eyebrow">Antes de sair</span>
        <h2>O que confirmar</h2>
        <ul>
          {checklistDefeso.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>

    <div class="defeso-aviso">
      <strong>O Fisga não substitui a legislação.</strong>
      <p>{avisoDefeso}</p>
    </div>

    <div class="defeso-links">
      <a href="https://www.gov.br/ibama/pt-br" target="_blank" rel="noopener">
        <span>Federal</span>
        <strong>IBAMA</strong>
        <small>Regras federais, piracema e fiscalização</small>
      </a>
      <a href={linkLicenca} target="_blank" rel="noopener">
        <span>Licença</span>
        <strong>Registro de pescador amador</strong>
        <small>gov.br · Ministério da Pesca</small>
      </a>
      <a href="/wiki/defeso">
        <span>Guia</span>
        <strong>Wiki do Pescador</strong>
        <small>O que é defeso e como consultar</small>
      </a>
    </div>

    <div class="ferramentas-nota">
      No registro de uma pescaria, o Fisga lembra você de conferir o defeso da espécie e da UF. O
      alerta é um lembrete editorial, não uma autorização nem um laudo.
    </div>
  </section>

  <style>
    .defeso-form {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 10px;
      max-width: 560px;
      margin-bottom: 22px;
    }

    .defeso-form .campo {
      flex: 1 1 240px;
    }

    .defeso-grade {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .defeso-orgao h2 {
      margin-top: 8px;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
    }

    .defeso-orgao > p {
      margin-top: 4px;
      color: var(--tinta-suave);
    }

    .defeso-orgao .btn {
      margin-top: 16px;
    }

    .defeso-lista h2 {
      margin-top: 8px;
      font-size: 1.8rem;
    }

    .defeso-lista ul {
      display: grid;
      gap: 6px;
      margin: 14px 0 0;
      padding-left: 18px;
      color: var(--tinta-suave);
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .defeso-aviso {
      margin-top: 18px;
      padding: 14px 16px;
      border-left: 3px solid var(--acafrao);
      background: #fff4ea;
      color: #6d3a1f;
      font-size: 0.8rem;
      line-height: 1.55;
    }

    .defeso-aviso strong {
      display: block;
      margin-bottom: 3px;
      color: #8a3f1c;
    }

    .defeso-links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 18px;
    }

    .defeso-links a {
      display: grid;
      gap: 2px;
      padding: 14px;
      border: 1px solid var(--linha);
      border-radius: 12px;
      background: var(--superficie);
      color: var(--tinta);
      text-decoration: none;
    }

    .defeso-links a:hover {
      border-color: var(--terracota);
    }

    .defeso-links span {
      color: var(--terracota);
      font-size: 0.56rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .defeso-links strong {
      font-family: var(--fonte-titulo);
      font-size: 1.1rem;
      font-weight: 600;
    }

    .defeso-links small {
      color: var(--tinta-suave);
      font-size: 0.66rem;
    }

    @media (max-width: 820px) {
      .defeso-grade,
      .defeso-links {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
