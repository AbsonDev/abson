      { id: 'licenca', nome: 'Regras e licença do pesqueiro conferidas', critico: true },
      { id: 'varas', nome: 'Varas e linhas para a espécie', critico: false },
      { id: 'iscas', nome: 'Iscas permitidas no local', critico: false },
