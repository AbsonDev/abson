    nome: 'Embarcado',
    descricao: 'Barco, mar aberto ou represa grande. Comunicação e redundância.',
    itens: [
      { id: 'colete', nome: 'Colete para todos a bordo', critico: true },
      { id: 'radio', nome: 'Rádio VHF ou comunicação alternativa', critico: true },
      { id: 'combustivel', nome: 'Combustível com reserva', critico: true },
      { id: 'agua', nome: 'Água, comida e gelo', critico: true },
      { id: 'primeiros', nome: 'Kit de primeiros socorros', critico: true },
      { id: 'documento', nome: 'Documentos da embarcação e licença', critico: true },
      { id: 'previsao', nome: 'Previsão de vento, onda e chuva', critico: true },
      { id: 'plano', nome: 'Plano de navegação avisado', critico: true },
      { id: 'ancora', nome: 'Âncora, cabo e defensas', critico: false },
      { id: 'varas', nome: 'Varas, linhas e líderes', critico: false },
