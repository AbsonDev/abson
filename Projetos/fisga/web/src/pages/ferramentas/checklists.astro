  },
  {
    id: 'costeira',
    nome: 'Costeira',
    descricao: 'Praia, pedra e estuário. Sal, sol e linha leve.',
    itens: [
      { id: 'colete', nome: 'Colete se entrar em pedra ou embarcação', critico: true },
      { id: 'agua', nome: 'Água e alimento', critico: true },
      { id: 'protetor', nome: 'Protetor, boné e camiseta UV', critico: false },
      { id: 'licenca', nome: 'Licença/registro de pescador', critico: true },
      { id: 'varas', nome: 'Vara, carretilha e linha', critico: false },
      { id: 'lider', nome: 'Líder de fluorcarbono', critico: false },
      { id: 'iscas', nome: 'Iscas naturais e artificiais', critico: false },
      { id: 'alicate', nome: 'Alicate, faca e puçá', critico: false },
      { id: 'saco', nome: 'Saco para lixo e para o peixe', critico: false },
      { id: 'telefone', nome: 'Celular carregado e protegido', critico: true }
