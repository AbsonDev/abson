      { id: 'varas', nome: 'Varas, linhas e líderes', critico: false },
      { id: 'iscas', nome: 'Iscas e artificiais', critico: false },
      { id: 'alicate', nome: 'Alicate, faca e puçá', critico: false },
      { id: 'reparo', nome: 'Kit de reparo e bomba', critico: false }
