---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiBreadcrumbs from '../../../components/wiki/WikiBreadcrumbs.astro';
import WikiArticleHeader from '../../../components/wiki/WikiArticleHeader.astro';
import WikiFatos from '../../../components/wiki/WikiFatos.astro';
import WikiToc from '../../../components/wiki/WikiToc.astro';
import WikiFaq from '../../../components/wiki/WikiFaq.astro';
import WikiFontes from '../../../components/wiki/WikiFontes.astro';
import WikiCard from '../../../components/wiki/WikiCard.astro';
import WikiCta from '../../../components/wiki/WikiCta.astro';
import { formatarData, jsonLdArtigo } from '../../../lib/wiki';

export const prerender = true;

export async function getStaticPaths() {
  const especies = await getCollection('especies');
  return especies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const site = (import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const url = `${site}/wiki/especies/${entry.id}`;
const trilha = [
  { nome: 'Fisga', url: site },
  { nome: 'Wiki', url: `${site}/wiki` },
  { nome: 'Espécies', url: `${site}/wiki/especies` },
  { nome: entry.data.titulo, url }
];

const iscas = await getCollection('iscas');
const tecnicas = await getCollection('tecnicas');
const todasEspecies = await getCollection('especies');
const iscasPorId = new Map(iscas.map((isca) => [isca.id, isca]));
const tecnicasPorId = new Map(tecnicas.map((tecnica) => [tecnica.id, tecnica]));

const iscasRelacionadas = entry.data.iscas.flatMap((slug) => {
  const isca = iscasPorId.get(slug);
  return isca ? [isca] : [];
});
const tecnicasRelacionadas = entry.data.tecnicas.flatMap((slug) => {
  const tecnica = tecnicasPorId.get(slug);
  return tecnica ? [tecnica] : [];
});
const outrasEspecies = todasEspecies
  .filter((especie) => especie.id !== entry.id)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);

const toc = [
  ...headings
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ id: heading.slug, label: heading.text })),
  ...(iscasRelacionadas.length > 0 ? [{ id: 'iscas', label: 'Iscas recomendadas' }] : []),
  ...(tecnicasRelacionadas.length > 0 ? [{ id: 'tecnicas', label: 'Técnicas' }] : []),
  { id: 'regulamentacao', label: 'Regulamentação' },
  ...(entry.data.faq.length > 0 ? [{ id: 'faq', label: 'Perguntas frequentes' }] : []),
  { id: 'fontes', label: 'Fontes e revisão' }
];

const jsonLd = jsonLdArtigo({
  titulo: `${entry.data.titulo} — guia de pesca`,
  descricao: entry.data.resumo,
  url,
  imagem: `${site}/og-fisga.png`,
  publicadoEm: entry.data.revisadoEm,
  revisadoEm: entry.data.revisadoEm,
  faq: entry.data.faq,
  trilha
});
---

<WikiLayout
  titulo={`${entry.data.titulo} — guia de pesca | Fisga`}
  descricao={entry.data.resumo}
  jsonLd={jsonLd}
  tipo="article"
>
  <WikiBreadcrumbs itens={[
    { nome: 'Fisga', href: '/' },
    { nome: 'Wiki', href: '/wiki' },
    { nome: 'Espécies', href: '/wiki/especies' },
    { nome: entry.data.titulo }
  ]} />

  <article class="wiki-artigo" data-pagefind-body>
    <div class="wiki-artigo-conteudo">
      <WikiArticleHeader
        categoria="Espécie"
        titulo={entry.data.titulo}
        subtitulo={entry.data.nomeCientifico}
        resumo={entry.data.resumo}
        tags={entry.data.tags}
      />

      <WikiFatos
        itens={[
          { rotulo: 'Habitat', valor: entry.data.habitat.join(' · ') },
          { rotulo: 'Distribuição', valor: entry.data.distribuicao },
          { rotulo: 'Tamanho', valor: entry.data.tamanho },
          { rotulo: 'Melhor época', valor: entry.data.epoca },
          { rotulo: 'Dificuldade', valor: entry.data.dificuldade },
          { rotulo: 'Família', valor: entry.data.familia }
        ]}
      />

      <div class="wiki-prose" id="sobre">
        <Content />
      </div>

      {iscasRelacionadas.length > 0 && (
        <section class="wiki-secao-artigo" id="iscas">
          <h2>Iscas recomendadas</h2>
          <p>Opções para começar. O melhor resultado depende da água, da luz e do humor do peixe.</p>
          <div class="wiki-lista-chips">
            {iscasRelacionadas.map((isca) => (
              <a class="wiki-chip" href={`/wiki/iscas/${isca.id}`}>
                {isca.data.titulo} · {isca.data.tipo}
              </a>
            ))}
          </div>
        </section>
      )}

      {tecnicasRelacionadas.length > 0 && (
        <section class="wiki-secao-artigo" id="tecnicas">
          <h2>Técnicas</h2>
          <p>Como apresentar a isca e trabalhar o peixe.</p>
          <div class="wiki-lista-chips">
            {tecnicasRelacionadas.map((tecnica) => (
              <a class="wiki-chip" href={`/wiki/tecnicas/${tecnica.id}`}>
                {tecnica.data.titulo}
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="wiki-secao-artigo" id="regulamentacao">
        <h2>Regulamentação</h2>
        <div class="wiki-callout">
          <strong>Confirme antes de pescar</strong>
          <p>
            Tamanhos mínimos, períodos de defeso e licenças variam por estado e por bacia. O Fisga
            não substitui a legislação. Consulte a agência ambiental da sua UF e o
            <a href="/wiki/defeso">guia de defeso</a> antes de sair.
          </p>
        </div>
      </section>

      <WikiFaq itens={entry.data.faq} />
      <WikiFontes fontes={entry.data.fontes} revisadoEm={entry.data.revisadoEm} />

      <section class="wiki-secao-artigo" id="relacionados">
        <h2>Continue aprendendo</h2>
        <p>Outras espécies para comparar habitat, iscas e técnicas.</p>
        <div class="wiki-relacionados">
          {outrasEspecies.map((especie) => (
            <WikiCard
              href={`/wiki/especies/${especie.id}`}
              titulo={especie.data.titulo}
              subtitulo={especie.data.nomeCientifico}
              descricao={especie.data.resumo}
              tags={especie.data.tags}
              tipo="peixe"
            />
          ))}
        </div>
      </section>

      <WikiCta especie={entry.data.titulo} />
    </div>

    <aside class="wiki-aside">
      <WikiToc itens={toc} />
      <div class="wiki-toc">
        <strong>Ficha rápida</strong>
        <div class="wiki-fatos" style="grid-template-columns: 1fr; margin-top: 8px;">
          <div class="wiki-fato"><span>Revisão</span><strong>{formatarData(entry.data.revisadoEm)}</strong></div>
          <div class="wiki-fato"><span>Dificuldade</span><strong>{entry.data.dificuldade}</strong></div>
          <div class="wiki-fato"><span>Ambiente</span><strong>{entry.data.habitat.join(' · ')}</strong></div>
        </div>
      </div>
      <a class="btn btn--primario btn--largo" href={`/registrar?especie=${encodeURIComponent(entry.data.titulo)}`}>
        Registrar captura
      </a>
    </aside>
  </article>
</WikiLayout>
