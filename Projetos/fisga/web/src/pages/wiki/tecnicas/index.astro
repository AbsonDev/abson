---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiBreadcrumbs from '../../../components/wiki/WikiBreadcrumbs.astro';
import WikiCard from '../../../components/wiki/WikiCard.astro';
import WikiCta from '../../../components/wiki/WikiCta.astro';
import { jsonLdColecao } from '../../../lib/wiki';

export const prerender = true;

const tecnicas = (await getCollection('tecnicas')).sort((a, b) => a.data.ordem - b.data.ordem);
const site = (import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).replace(/\/$/, '');
const jsonLd = jsonLdColecao({
  titulo: 'Técnicas de pesca — Wiki do Pescador',
  descricao: 'Arremesso, fly, baitcasting, fundo, corrico e praia: quando usar, equipamento e passo a passo.',
  url: `${site}/wiki/tecnicas`,
  itens: tecnicas.map((tecnica) => ({
    nome: tecnica.data.titulo,
    url: `${site}/wiki/tecnicas/${tecnica.id}`
  }))
});

const filtros = ['Todas', 'Fácil', 'Média', 'Alta'];
---

<WikiLayout
  titulo="Técnicas de pesca — Wiki do Pescador | Fisga"
  descricao="Arremesso, fly, baitcasting, fundo, corrico e praia: quando usar, equipamento e passo a passo."
  jsonLd={jsonLd}
>
  <WikiBreadcrumbs itens={[
    { nome: 'Fisga', href: '/' },
    { nome: 'Wiki', href: '/wiki' },
    { nome: 'Técnicas' }
  ]} />

  <div data-pagefind-body>
    <header class="wiki-categoria-hero">
      <span class="eyebrow">Wiki do Pescador</span>
      <h1>Técnicas</h1>
      <p>
        Cada técnica resolve um problema diferente: distância, precisão, profundidade ou cobertura
        de área. Escolha pela água e pelo peixe, não pela moda.
      </p>
      <span class="wiki-contagem">{tecnicas.length} guias publicados</span>
    </header>

    <div class="wiki-filtros" role="group" aria-label="Filtrar técnicas" data-pagefind-ignore>
      {filtros.map((filtro, indice) => (
        <button
          class:list={['wiki-filtro', { ativo: indice === 0 }]}
          type="button"
          data-filtro={filtro}
          aria-pressed={indice === 0 ? 'true' : 'false'}
        >
          {filtro}
        </button>
      ))}
    </div>

    <div class="wiki-grid" id="lista-tecnicas">
      {tecnicas.map((tecnica) => (
        <div data-tecnica data-dificuldade={tecnica.data.dificuldade}>
          <WikiCard
            href={`/wiki/tecnicas/${tecnica.id}`}
            titulo={tecnica.data.titulo}
            descricao={tecnica.data.resumo}
            tags={[`Dificuldade ${tecnica.data.dificuldade}`, ...tecnica.data.equipamento.slice(0, 2)]}
            tipo="var"
            destaque={tecnica.data.destaque}
          />
        </div>
      ))}
    </div>

    <p id="sem-resultado" class="wiki-aviso oculto">Nenhuma técnica encontrada com esse filtro.</p>

    <WikiCta
      titulo="Escolheu a técnica?"
      texto="Registre a pescaria e veja, no seu diário, quais condições funcionaram melhor."
      rotulo="Registrar pescaria"
    />
  </div>
</WikiLayout>

<script>
  // @ts-nocheck
  const botoes = [...document.querySelectorAll('[data-filtro]')];
  const cards = [...document.querySelectorAll('[data-tecnica]')];
  const semResultado = document.getElementById('sem-resultado');

  function aplicar(filtro) {
    let visiveis = 0;
    cards.forEach((card) => {
      const dificuldade = card.getAttribute('data-dificuldade') || '';
      const corresponde = filtro === 'Todas' || dificuldade === filtro;
      card.classList.toggle('oculto', !corresponde);
      if (corresponde) visiveis += 1;
    });
    semResultado?.classList.toggle('oculto', visiveis > 0);
    botoes.forEach((botao) => {
      const ativo = botao.getAttribute('data-filtro') === filtro;
      botao.classList.toggle('ativo', ativo);
      botao.setAttribute('aria-pressed', String(ativo));
    });
  }

  botoes.forEach((botao) => {
    botao.addEventListener('click', () => aplicar(botao.getAttribute('data-filtro') || 'Todas'));
  });
</script>
