---
import WikiLayout from '../../layouts/WikiLayout.astro';
import WikiBreadcrumbs from '../../components/wiki/WikiBreadcrumbs.astro';
import { CATEGORIAS } from '../../lib/wiki';

export const prerender = true;
---

<WikiLayout
  titulo="Buscar na Wiki do Pescador | Fisga"
  descricao="Busque por espécie, isca, técnica, região ou defeso."
  noindex
>
  <WikiBreadcrumbs itens={[
    { nome: 'Fisga', href: '/' },
    { nome: 'Wiki', href: '/wiki' },
    { nome: 'Buscar' }
  ]} />

  <header class="wiki-categoria-hero">
    <span class="eyebrow">Wiki do Pescador</span>
    <h1>Buscar</h1>
    <p>
      Encontre uma espécie, uma isca, uma técnica ou uma região. A busca funciona no navegador e
      também fica disponível offline depois da primeira visita.
    </p>
  </header>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <div id="busca" class="wiki-busca-resultados" data-pagefind-ignore></div>

  <div id="busca-indisponivel" class="wiki-aviso oculto" data-pagefind-ignore>
    A busca ainda não está disponível nesta execução. Você pode explorar as categorias abaixo.
  </div>

  <section class="wiki-secao" aria-labelledby="categorias-busca" data-pagefind-ignore>
    <div class="wiki-secao-cabecalho">
      <div>
        <span class="eyebrow">Explore</span>
        <h2 id="categorias-busca">Categorias</h2>
      </div>
    </div>
    <div class="wiki-faixa">
      {CATEGORIAS.map((categoria) => (
        <a class="wiki-faixa-item" href={`/wiki/${categoria.slug}`}>
          <strong>{categoria.titulo}</strong>
          <span>{categoria.descricao}</span>
        </a>
      ))}
    </div>
  </section>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const alvo = document.getElementById('busca');
      const aviso = document.getElementById('busca-indisponivel');

      if (!window.PagefindUI || !alvo) {
        aviso?.classList.remove('oculto');
        alvo?.classList.add('oculto');
        return;
      }

      new PagefindUI({
        element: '#busca',
        bundlePath: '/pagefind/',
        showSubResults: true,
        translations: {
          placeholder: 'Buscar espécie, isca, técnica ou UF',
          clear_search: 'Limpar',
          load_more: 'Carregar mais resultados',
          search_label: 'Buscar na wiki',
          filters: 'Filtros',
          zero_results: 'Nenhum resultado para [SEARCH_TERM]',
          many_results: '[COUNT] resultados para [SEARCH_TERM]',
          one_result: '1 resultado para [SEARCH_TERM]',
          alt_search: 'Nenhum resultado para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM]',
          search_suggestion: 'Tente outra palavra ou confira a ortografia.',
          searching: 'Buscando...'
        }
      });

      const termo = new URLSearchParams(window.location.search).get('q');
      if (termo) {
        window.setTimeout(() => {
          const input = document.querySelector('.pagefind-ui__search-input');
          if (input) {
            input.value = termo;
            input.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }, 150);
      }
    });
  </script>
</WikiLayout>
