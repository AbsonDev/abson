---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { apiBase } from '../lib/api';
import type { Comparacao, Condicoes, LocalSalvo } from '../lib/tipos';

const params = Astro.url.searchParams;
const cookie = Astro.request.headers.get('cookie') ?? '';

type Resposta<T> = { ok: boolean; status: number; dados: T | null };

async function chamar<T>(caminho: string): Promise<Resposta<T>> {
  try {
    const resposta = await fetch(`${apiBase}${caminho}`, {
      headers: cookie ? { cookie } : {}
    });

    if (!resposta.ok) {
      return { ok: false, status: resposta.status, dados: null };
    }

    return { ok: true, status: resposta.status, dados: (await resposta.json()) as T };
  } catch {
    return { ok: false, status: 0, dados: null };
  }
}

let autenticado = false;
let locais: LocalSalvo[] = [];

if (cookie) {
  const resposta = await chamar<LocalSalvo[]>('/api/locais');
  if (resposta.ok && resposta.dados) {
    autenticado = true;
    locais = resposta.dados;
  }
}

const temCoordenadas = params.has('lat') && params.has('lon');
let latitude = temCoordenadas ? Number(params.get('lat')) : Number.NaN;
let longitude = temCoordenadas ? Number(params.get('lon')) : Number.NaN;
let nome = params.get('nome')?.trim() ?? '';
let cidade = params.get('cidade')?.trim() ?? '';
let estado = params.get('estado')?.trim() ?? '';
let ambiente = params.get('ambiente')?.trim() || 'Outro';

const localPadrao = locais.find((local) => local.padrao) ?? locais[0] ?? null;
const usandoPadrao = !temCoordenadas && localPadrao !== null;

if (usandoPadrao && localPadrao) {
  latitude = localPadrao.latitude;
  longitude = localPadrao.longitude;
  nome = localPadrao.nome;
  cidade = localPadrao.cidade ?? '';
  estado = localPadrao.estado ?? '';
  ambiente = localPadrao.ambiente;
}

const coordenadasValidas =
  Number.isFinite(latitude) &&
  Number.isFinite(longitude) &&
  latitude >= -90 &&
  latitude <= 90 &&
  longitude >= -180 &&
  longitude <= 180;

let condicoes: Condicoes | null = null;
let comparacao: Comparacao | null = null;
let erroCondicoes = '';
const consulta = new URLSearchParams({
  lat: String(latitude),
  lon: String(longitude),
  nome: nome || 'Local',
  cidade,
  estado,
  ambiente
});

if (coordenadasValidas) {
  const resposta = await chamar<Condicoes>(`/api/condicoes?${consulta.toString()}`);
  if (resposta.ok && resposta.dados) {
    condicoes = resposta.dados;
    nome = condicoes.local.nome;
    cidade = condicoes.local.cidade ?? '';
    estado = condicoes.local.estado ?? '';
    ambiente = condicoes.local.ambiente;
  } else {
    erroCondicoes = 'Não conseguimos carregar as condições deste local agora. Tente de novo em instantes.';
  }

  if (autenticado && condicoes) {
    const respostaComparacao = await chamar<Comparacao>(`/api/condicoes/comparar?${consulta.toString()}`);
    if (respostaComparacao.ok) {
      comparacao = respostaComparacao.dados;
    }
  }
}

const localAtual = condicoes?.local ?? {
  nome: nome || 'Seu local',
  cidade: cidade || null,
  estado: estado || null,
  latitude,
  longitude,
  ambiente
};

const queryAtual = new URLSearchParams({
  lat: String(localAtual.latitude),
  lon: String(localAtual.longitude),
  nome: localAtual.nome,
  cidade: localAtual.cidade ?? '',
  estado: localAtual.estado ?? '',
  ambiente: localAtual.ambiente
});

const urlRegistrar = `/registrar?${queryAtual.toString()}`;

const titulo = condicoes
  ? `Condições de pesca em ${condicoes.local.nome} — Fisga`
  : 'Condições de pesca: maré, vento e janela — Fisga';
const descricao = condicoes
  ? `Maré, vento, chuva, lua e janela de pesca em ${condicoes.local.nome}. Veja os próximos sete dias e registre a pescaria já preenchida.`
  : 'Consulte maré, vento, chuva, lua e a janela de pesca do seu local. Sem cadastro para consultar; com conta para salvar locais e comparar com o seu histórico.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: titulo,
  description: descricao,
  inLanguage: 'pt-BR',
  about: condicoes
    ? {
        '@type': 'Place',
        name: condicoes.local.nome,
        geo: {
          '@type': 'GeoCoordinates',
          latitude: condicoes.local.latitude,
          longitude: condicoes.local.longitude
        }
      }
    : undefined
});

const fuso = 'America/Sao_Paulo';
const hora = (valor: string | null | undefined) =>
  valor
    ? new Intl.DateTimeFormat('pt-BR', {
        hour: '2-digit',
        minute: '2-digit',
        timeZone: fuso
      }).format(new Date(valor))
    : '—';
const comoData = (valor: string) =>
  new Date(valor.length === 10 ? `${valor}T12:00:00-03:00` : valor);
const dataCurta = (valor: string) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    timeZone: fuso
  })
    .format(comoData(valor))
    .replace('.', '');
const diaSemana = (valor: string) =>
  new Intl.DateTimeFormat('pt-BR', {
    weekday: 'short',
    timeZone: fuso
  })
    .format(comoData(valor))
    .replace('.', '');
const numero = (valor: number | null | undefined, casas = 0) =>
  valor === null || valor === undefined
    ? '—'
    : valor.toLocaleString('pt-BR', {
        minimumFractionDigits: casas,
        maximumFractionDigits: casas
      });
const altura = (valor: number) => `${numero(valor, 2)} m`;
const capitalizar = (texto: string) => (texto ? texto[0].toUpperCase() + texto.slice(1) : texto);
const estrelas = (nota: number) => '★'.repeat(Math.max(0, Math.min(5, nota))) + '☆'.repeat(Math.max(0, 5 - nota));
const nomeMare = (tipo: string) => (tipo === 'Cheia' ? 'Preamar' : 'Baixa-mar');

function caminhoCurva(pontos: Array<{ hora: string; alturaM: number }>): string {
  if (pontos.length < 2) return '';
  const alturas = pontos.map((ponto) => ponto.alturaM);
  const minimo = Math.min(...alturas);
  const maximo = Math.max(...alturas);
  const faixa = Math.max(0.2, maximo - minimo);

  return pontos
    .map((ponto, indice) => {
      const x = (indice / (pontos.length - 1)) * 320;
      const y = 76 - ((ponto.alturaM - minimo) / faixa) * 56;
      return `${indice === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}

const linhaDoTempo = condicoes?.linhaDoTempo ?? [];
const alturasDaMare = linhaDoTempo
  .map((hora) => hora.alturaM)
  .filter((valor): valor is number => valor !== null);
const pressoes = linhaDoTempo.map((hora) => hora.pressaoHpa);
const minAltura = alturasDaMare.length ? Math.min(...alturasDaMare) : 0;
const maxAltura = alturasDaMare.length ? Math.max(...alturasDaMare) : 1;
const minPressao = pressoes.length ? Math.min(...pressoes) : 1000;
const maxPressao = pressoes.length ? Math.max(...pressoes) : 1020;
const maxVento = Math.max(...linhaDoTempo.map((hora) => hora.ventoKmh), 1);
const horaAgora = Number((condicoes?.atualizadoEm ?? 'T00:').slice(11, 13));
const indiceAgora = Math.min(23, Math.max(0, Number.isFinite(horaAgora) ? horaAgora : 0));

function xHora(indice: number) {
  return 36 + (indice / Math.max(1, linhaDoTempo.length - 1)) * 888;
}

function yAltura(valor: number) {
  const faixa = Math.max(0.2, maxAltura - minAltura);
  return 28 + (1 - (valor - minAltura) / faixa) * 62;
}

function yPressao(valor: number) {
  const faixa = Math.max(0.5, maxPressao - minPressao);
  return 112 + (1 - (valor - minPressao) / faixa) * 54;
}

function caminhoDaSerie(
  valores: Array<number | null>,
  y: (valor: number) => number
): string {
  return valores
    .map((valor, indice) =>
      valor === null ? null : `${indice === 0 ? 'M' : 'L'}${xHora(indice).toFixed(1)},${y(valor).toFixed(1)}`
    )
    .filter(Boolean)
    .join(' ');
}

const caminhoDaMare = caminhoDaSerie(
  linhaDoTempo.map((hora) => hora.alturaM),
  yAltura
);
const caminhoDaPressao = caminhoDaSerie(
  linhaDoTempo.map((hora) => hora.pressaoHpa),
  yPressao
);
const larguraHora = 888 / Math.max(1, linhaDoTempo.length - 1);
const rotulosDeHora = linhaDoTempo
  .map((hora, indice) => ({ hora, indice }))
  .filter(({ indice }) => indice % 3 === 0 || indice === linhaDoTempo.length - 1);

function linkDoLocal(local: LocalSalvo): string {
  const consulta = new URLSearchParams({
    lat: String(local.latitude),
    lon: String(local.longitude),
    nome: local.nome,
    cidade: local.cidade ?? '',
    estado: local.estado ?? '',
    ambiente: local.ambiente
  });
  return `/condicoes?${consulta.toString()}`;
}

const exemplos = [
  { nome: 'Aracaju', cidade: 'Aracaju', estado: 'SE', ambiente: 'Mar', lat: '-10.911', lon: '-37.071' },
  { nome: 'Ilhabela', cidade: 'Ilhabela', estado: 'SP', ambiente: 'Mar', lat: '-23.778', lon: '-45.358' },
  { nome: 'Campinas', cidade: 'Campinas', estado: 'SP', ambiente: 'Represa', lat: '-22.905', lon: '-47.060' }
];
---

<Layout
  titulo={titulo}
  descricao={descricao}
  bodyClass="pagina-condicoes"
  jsonLd={jsonLd}
>
  <section class="condicoes-topo">
    <div class="container">
      <span class="eyebrow">{condicoes ? 'Condições agora' : 'Condições de pesca'}</span>
      <h1>
        {condicoes ? (
          <>
            {condicoes.local.nome}
            {condicoes.local.estado && <em>, {condicoes.local.estado}</em>}
          </>
        ) : (
          <>Vale a pena sair <em>hoje?</em></>
        )}
      </h1>
      <p class="condicoes-linha-fina">
        {condicoes
          ? 'Vale a pena sair hoje? Veja a maré, o vento e a janela de pesca deste lugar.'
          : 'Maré, vento, chuva, lua e a janela que costuma funcionar. Consultar é grátis e não precisa de conta.'}
      </p>

      <div class="condicoes-busca" role="search">
        <div class="campo-busca">
          <label class="oculto" for="busca-local">Buscar cidade ou praia</label>
          <input
            id="busca-local"
            type="search"
            placeholder="Busque uma cidade, praia ou represa"
            autocomplete="off"
            aria-describedby="busca-ajuda"
          />
          <div id="resultados-busca" class="busca-resultados oculto" role="listbox"></div>
        </div>
        <button id="usar-localizacao" class="btn btn--contorno" type="button">
          Usar minha localização
        </button>
      </div>
      <p id="busca-ajuda" class="busca-ajuda">
        Buscamos pelo nome da cidade. Você também pode abrir um local salvo ou usar o GPS.
      </p>
      <p id="status-localizacao" class="busca-status" role="status" aria-live="polite"></p>

      {condicoes && (
        <div class="hero-acoes condicoes-hero-acoes">
          <a class="btn btn--primario" href={urlRegistrar}>Registrar pescaria</a>
          <button class="btn btn--contorno" type="button" data-copiar>Compartilhar condições</button>
          <span class="hero-nota">Registrar e salvar locais pedem conta. Ver condições não.</span>
        </div>
      )}

      {locais.length > 0 && (
        <div class="locais-lista">
          <span class="locais-rotulo">Seus locais</span>
          {locais.map((local) => (
            <a
              class:list={[
                'chip-local',
                {
                  ativo:
                    condicoes &&
                    Math.abs(condicoes.local.latitude - local.latitude) < 0.001 &&
                    Math.abs(condicoes.local.longitude - local.longitude) < 0.001
                }
              ]}
              href={linkDoLocal(local)}
            >
              {local.padrao && <span aria-hidden="true">★</span>}
              {local.nome}
            </a>
          ))}
          <a class="chip-local chip-local--gerenciar" href="/mapa?aba=locais">Gerenciar</a>
        </div>
      )}

      {!autenticado && !condicoes && (
        <p class="entrar-salvar">
          <a href={`/entrar?voltar=${encodeURIComponent('/condicoes')}`}>Entre</a> para salvar seus
          locais e abrir as condições com um toque.
        </p>
      )}
    </div>
  </section>

  {condicoes ? (
    <section class="container condicoes-conteudo">
      <div class="condicoes-grade">
        <div class="condicoes-principal">
          <article class="cartao cartao-agora">
            <div class="cartao-topo">
              <span class="eyebrow">Agora</span>
              <span class="selo selo--terracota">{condicoes.local.nome}</span>
            </div>
            <h2>{condicoes.agora.resumo}</h2>
            <div class="agora-metricas">
              <div>
                <span>Maré</span>
                <strong>{condicoes.mare ? capitalizar(condicoes.mare.estado) : 'Sem maré'}</strong>
                <small>{condicoes.agora.proximoEvento ?? 'não se aplica'}</small>
              </div>
              <div>
                <span>Lua</span>
                <strong>{condicoes.solunar.faseNome}</strong>
                <small>{numero(condicoes.solunar.iluminacao)}% iluminada</small>
              </div>
              <div>
                <span>Vento</span>
                <strong>{numero(condicoes.tempo.ventoKmh)} km/h</strong>
                <small>{condicoes.tempo.direcao}</small>
              </div>
              <div>
                <span>Chuva</span>
                <strong>{numero(condicoes.tempo.chuvaProbabilidade)}%</strong>
                <small>próximas horas</small>
              </div>
              <div>
                <span>Pressão</span>
                <strong>{numero(condicoes.tempo.pressaoHpa)} hPa</strong>
                <small>{capitalizar(condicoes.tempo.pressaoTendencia)}</small>
              </div>
            </div>
            {autenticado && (
              <div class="agora-acoes">
                <button id="salvar-local" class="btn btn--pequeno btn--contorno" type="button">
                  Salvar local
                </button>
              </div>
            )}
          </article>

          <article class="cartao cartao-linha">
            <div class="cartao-topo">
              <span class="eyebrow">Linha do tempo</span>
              <span class="selo selo--neutro">Hoje · 24 h</span>
            </div>
            <h3>Maré, vento e pressão na mesma linha.</h3>
            <div class="linha-scroll">
              <svg
                class="linha-svg"
                viewBox="0 0 960 250"
                role="img"
                aria-label="Linha do tempo de hoje com maré, pressão, vento e períodos solunares"
              >
                <g class="linha-solunar">
                  {linhaDoTempo.map((hora, indice) =>
                    hora.solunar ? (
                      <rect
                        x={xHora(indice) - larguraHora / 2}
                        y="10"
                        width={larguraHora}
                        height="206"
                        rx="2"
                      />
                    ) : null
                  )}
                </g>
                <line x1="36" y1="112" x2="924" y2="112" class="linha-base" />
                <line x1="36" y1="166" x2="924" y2="166" class="linha-base" />
                {caminhoDaMare && <path class="linha-mare" d={caminhoDaMare} />}
                {condicoes.mare?.eventos.map((evento) => {
                  const parts = evento.hora.slice(11, 16).split(':');
                  const horaEvento = Number(parts[0]) + Number(parts[1]) / 60;
                  const xEvento = 36 + (horaEvento / 23) * 888;
                  const yEvento = yAltura(evento.alturaM);
                  return (
                    <g>
                      <circle cx={xEvento} cy={yEvento} r="3" class="linha-evento-ponto" />
                      <text x={xEvento} y={yEvento - 7} text-anchor="middle" class="linha-evento">
                        {evento.tipo === 'Cheia' ? 'PM' : 'BM'} {hora(evento.hora)}
                      </text>
                    </g>
                  );
                })}
                <path class="linha-pressao" d={caminhoDaPressao} />
                <g class="linha-vento">
                  {linhaDoTempo.map((hora, indice) => {
                    const alturaBarra = (hora.ventoKmh / maxVento) * 28;
                    return (
                      <rect
                        x={xHora(indice) - 3}
                        y={214 - alturaBarra}
                        width="6"
                        height={alturaBarra}
                        rx="2"
                      />
                    );
                  })}
                </g>
                <line
                  x1={xHora(indiceAgora)}
                  y1="12"
                  x2={xHora(indiceAgora)}
                  y2="218"
                  class="linha-agora"
                />
                <text x={xHora(indiceAgora) + 4} y="224" class="linha-rotulo-agora">agora</text>
                {rotulosDeHora.map(({ hora, indice }) => (
                  <text x={xHora(indice)} y="242" text-anchor="middle" class="linha-rotulo">
                    {hora.hora.slice(11, 16)}
                  </text>
                ))}
              </svg>
            </div>
            <div class="linha-legenda">
              <span><i class="legenda-mare" /> Maré</span>
              <span><i class="legenda-pressao" /> Pressão</span>
              <span><i class="legenda-vento" /> Vento</span>
              <span><i class="legenda-solunar" /> Solunar</span>
            </div>
          </article>

          <article class:list={['cartao', 'cartao-janela', condicoes.melhorJanela ? `forca-${condicoes.melhorJanela.nota}` : '']}>
            <div class="cartao-topo">
              <span class="eyebrow">Janela de pesca</span>
              <span class="nota">{condicoes.melhorJanela ? estrelas(condicoes.melhorJanela.nota) : '☆☆☆☆☆'}</span>
            </div>

            {condicoes.melhorJanela ? (
              <>
                <div class="janela-topo">
                  <h2>{hora(condicoes.melhorJanela.inicio)}–{hora(condicoes.melhorJanela.fim)}</h2>
                  <span class="janela-forca">{condicoes.melhorJanela.forca}</span>
                </div>
                <div class="motivos">
                  {condicoes.melhorJanela.motivos.map((motivo) => (
                    <span class="motivo">{motivo}</span>
                  ))}
                </div>
                <p class="janela-nota">
                  Calculado com maré, solunar, vento e chuva. Se o seu ponto tiver particularidades,
                  ajuste na hora de registrar.
                </p>
              </>
            ) : (
              <p class="vazio-suave">
                Ainda não há uma janela clara para hoje. Confira os próximos dias abaixo.
              </p>
            )}
          </article>

          {comparacao && (
            <article class:list={['cartao', 'cartao-comparacao', { 'sem-dados': !comparacao.temDados }]}>
              <div class="cartao-topo">
                <span class="eyebrow">Seu histórico</span>
                <span class="selo selo--neutro">{comparacao.pescariasConsideradas} {comparacao.pescariasConsideradas === 1 ? 'pescaria' : 'pescarias'}</span>
              </div>
              <h3>{comparacao.titulo}</h3>
              <p>{comparacao.detalhe}</p>
              {comparacao.fatores.length > 0 && (
                <div class="comparacao-fatores">
                  {comparacao.fatores.map((fator) => <span>{fator}</span>)}
                </div>
              )}
              {comparacao.shareToken ? (
                <a class="link-seta" href={`/p/${comparacao.shareToken}`}>Ver pescaria →</a>
              ) : (
                <a class="link-seta" href={urlRegistrar}>Registrar pescaria →</a>
              )}
            </article>
          )}

          <section class="dias">
            <div class="cabecalho-secao">
              <div>
                <span class="eyebrow">Próximos 7 dias</span>
                <h2>Quando voltar</h2>
              </div>
              <span class="dias-legenda">★ = força da janela</span>
            </div>
            <div class="dias-lista">
              {condicoes.dias.map((dia, indice) => (
                <article class:list={['dia-card', { hoje: indice === 0 }]}>
                  <span class="dia-semana">{indice === 0 ? 'Hoje' : diaSemana(dia.data)}</span>
                  <strong class="dia-data">{dataCurta(dia.data)}</strong>
                  <span class="dia-estrelas" aria-label={`Nota ${dia.nota} de 5`}>{estrelas(dia.nota)}</span>
                  <span class="dia-janela">
                    {dia.melhorInicio ? `${hora(dia.melhorInicio)}–${hora(dia.melhorFim)}` : 'Sem janela'}
                  </span>
                  <p>{dia.resumo}</p>
                </article>
              ))}
            </div>
          </section>

          <div class="condicoes-dupla">
            <article class="cartao cartao-mare">
              <div class="cartao-topo">
                <span class="eyebrow">Maré</span>
                {condicoes.temMare && <span class="selo selo--neutro">Aproximada</span>}
              </div>

              {condicoes.mare ? (
                <>
                  <div class="mare-estado">
                    <h3>{condicoes.mare.estado === 'subindo' ? 'Maré enchendo' : condicoes.mare.estado === 'descendo' ? 'Maré vazando' : 'Maré estável'}</h3>
                    {condicoes.mare.proximoEvento && (
                      <p>
                        {nomeMare(condicoes.mare.proximoEvento.tipo)} às{' '}
                        {hora(condicoes.mare.proximoEvento.hora)} · {altura(condicoes.mare.proximoEvento.alturaM)}
                      </p>
                    )}
                  </div>

                  {condicoes.mare.curva.length > 1 && (
                    <svg
                      class="mare-curva"
                      viewBox="0 0 320 90"
                      role="img"
                      aria-label="Curva da maré nas próximas 24 horas"
                    >
                      <path d={caminhoCurva(condicoes.mare.curva)} fill="none" stroke="var(--terracota)" stroke-width="2.5" stroke-linecap="round" />
                    </svg>
                  )}

                  <div class="mare-tabela">
                    {condicoes.mare.eventos.map((evento) => (
                      <div class="mare-linha">
                        <span class:list={['mare-tipo', evento.tipo === 'Cheia' ? 'cheia' : 'baixa']}>
                          {evento.tipo === 'Cheia' ? '↑' : '↓'} {nomeMare(evento.tipo)}
                        </span>
                        <strong>{hora(evento.hora)}</strong>
                        <span>{altura(evento.alturaM)}</span>
                      </div>
                    ))}
                  </div>

                  <p class="fonte-pequena">
                    {condicoes.mare.datum}. Não use para navegação; confira a tábua oficial do porto.
                  </p>
                </>
              ) : (
                <p class="vazio-suave">
                  Este local não tem maré. Mostramos vento, chuva, lua e solunar — e o diário continua
                  valendo.
                </p>
              )}
            </article>

            <article class="cartao cartao-solunar">
              <div class="cartao-topo">
                <span class="eyebrow">Solunar</span>
                <span class="selo selo--neutro">{numero(condicoes.solunar.iluminacao)}% iluminada</span>
              </div>
              <h3>{condicoes.solunar.faseNome}</h3>
              <p class="fonte-pequena">
                {numero(condicoes.solunar.idadeDias, 1)} dias de idade lunar
              </p>

              <div class="solunar-lista">
                {condicoes.solunar.periodos.map((periodo) => (
                  <div class:list={['solunar-linha', periodo.tipo === 'Maior' ? 'maior' : 'menor']}>
                    <span class="solunar-tipo">{periodo.tipo}</span>
                    <strong>{hora(periodo.inicio)}–{hora(periodo.fim)}</strong>
                    <span class="solunar-motivo">{periodo.motivo}</span>
                  </div>
                ))}
              </div>
            </article>
          </div>
        </div>

        <aside class="condicoes-lateral">
          <article class="cartao cartao-tempo">
            <div class="cartao-topo">
              <span class="eyebrow">Tempo agora</span>
              <span class="selo selo--neutro">{condicoes.tempo.direcao}</span>
            </div>
            <div class="tempo-grid">
              <div><span>Vento</span><strong>{numero(condicoes.tempo.ventoKmh)} km/h</strong></div>
              <div><span>Rajadas</span><strong>{numero(condicoes.tempo.rajadaKmh)} km/h</strong></div>
              <div><span>Chuva</span><strong>{numero(condicoes.tempo.chuvaProbabilidade)}%</strong></div>
              <div><span>Temperatura</span><strong>{numero(condicoes.tempo.temperaturaC)} °C</strong></div>
              <div><span>Sensação</span><strong>{numero(condicoes.tempo.sensacaoC)} °C</strong></div>
              <div><span>Pressão</span><strong>{numero(condicoes.tempo.pressaoHpa)} hPa</strong></div>
              {condicoes.tempo.temperaturaDaAguaC !== null && (
                <div><span>Água</span><strong>{numero(condicoes.tempo.temperaturaDaAguaC)} °C</strong></div>
              )}
              {condicoes.tempo.ondaAlturaM !== null && (
                <div><span>Ondas</span><strong>{numero(condicoes.tempo.ondaAlturaM, 1)} m</strong></div>
              )}
              {condicoes.tempo.correnteKmh !== null && (
                <div>
                  <span>Corrente</span>
                  <strong>{numero(condicoes.tempo.correnteKmh, 1)} km/h</strong>
                  <small>{condicoes.tempo.correnteDirecao ?? ''}</small>
                </div>
              )}
            </div>
            <p class="fonte-pequena">Pressão {condicoes.tempo.pressaoTendencia} nas últimas horas.</p>
            {condicoes.tempo.pressaoAlerta && (
              <p class="alerta-pressao">{condicoes.tempo.pressaoAlerta}</p>
            )}
          </article>

          <article class="cartao cartao-locais">
            <div class="cartao-topo">
              <span class="eyebrow">Seus locais</span>
              <span class="selo selo--neutro">{locais.length} de 5</span>
            </div>
            {locais.length > 0 ? (
              <div class="rail-locais">
                {locais.map((local) => (
                  <a class="rail-local" href={linkDoLocal(local)}>
                    <span>{local.padrao ? '★' : '·'}</span>
                    <strong>{local.nome}</strong>
                    <small>{local.estado ?? ''}</small>
                  </a>
                ))}
              </div>
            ) : (
              <p class="vazio-suave">
                {autenticado
                  ? 'Nenhum local salvo. Busque e toque em “Salvar local”.'
                  : 'Entre para salvar seus locais e abrir as condições com um toque.'}
              </p>
            )}
            <a class="link-seta" href={autenticado ? '/mapa?aba=locais' : `/entrar?voltar=${encodeURIComponent('/condicoes')}`}>
              {autenticado ? 'Gerenciar locais' : 'Entrar para salvar'} →
            </a>
          </article>

          <article class="cartao cartao-compartilhar">
            <span class="eyebrow">Página pública</span>
            <h3>Compartilhar condições</h3>
            <p>Qualquer pessoa vê sem login. O link leva o local e o nome.</p>
            <button class="btn btn--pequeno btn--contorno" type="button" data-copiar>Copiar link</button>
          </article>

          <article class="cartao cartao-fonte">
            <span class="eyebrow">Fonte e limites</span>
            <p>
              Dados de{' '}
              <a href="https://open-meteo.com" target="_blank" rel="noopener">Open-Meteo</a>
              {' + '}
              <a href="https://www.met.no" target="_blank" rel="noopener">MET Norway</a>. Atualizado
              às {hora(condicoes.atualizadoEm)}, horário de Brasília.
            </p>
            {condicoes.aviso ? (
              <p class="fonte-pequena">{condicoes.aviso}</p>
            ) : (
              <p class="fonte-pequena">
                A maré é uma aproximação por modelo global. Para navegação, use a tábua oficial do
                porto mais próximo.
              </p>
            )}
          </article>

          <article class="cartao cartao-cta">
            <span class="eyebrow">Menos digitação</span>
            <h3>Registre com as condições já preenchidas.</h3>
            <p>Local, data, maré, lua e clima entram sozinhos. Você só adiciona os peixes.</p>
            <a class="btn btn--primario btn--largo" href={urlRegistrar}>Registrar pescaria</a>
          </article>
        </aside>
      </div>
    </section>
  ) : (
    <section class="container condicoes-conteudo">
      {erroCondicoes ? (
        <div class="erro-caixa" role="alert">{erroCondicoes}</div>
      ) : (
        <div class="estado-inicial">
          <div>
            <span class="eyebrow">Comece por um local</span>
            <h2>Escolha onde você pesca.</h2>
            <p>
              Mostramos a maré, o vento, a chuva, a lua e a melhor janela do dia. Se o local não tiver
              maré, tudo bem: o solunar e o tempo continuam valendo.
            </p>
          </div>
          <div class="exemplos-lista">
            {exemplos.map((exemplo) => (
              <a
                class="exemplo-local"
                href={`/condicoes?lat=${exemplo.lat}&lon=${exemplo.lon}&nome=${encodeURIComponent(exemplo.nome)}&cidade=${encodeURIComponent(exemplo.cidade)}&estado=${exemplo.estado}&ambiente=${exemplo.ambiente}`}
              >
                <strong>{exemplo.nome}</strong>
                <span>{exemplo.cidade} · {exemplo.estado} · {exemplo.ambiente}</span>
              </a>
            ))}
          </div>
          <div class="como-funciona-condicoes">
            <span>O que você vê</span>
            <ul>
              <li>Maré aproximada, com próxima preamar/baixa-mar.</li>
              <li>Janela de pesca com o motivo de cada escolha.</li>
              <li>Sete dias, solunar, vento, chuva e pressão.</li>
            </ul>
          </div>
        </div>
      )}
    </section>
  )}

  <div id="dados-condicoes" class="oculto" data-lat={localAtual.latitude} data-lon={localAtual.longitude} data-nome={localAtual.nome} data-cidade={localAtual.cidade ?? ''} data-estado={localAtual.estado ?? ''} data-ambiente={localAtual.ambiente}></div>

  <dialog id="dialogo-local" class="dialogo-local">
    <form id="form-local">
      <div class="dialogo-topo">
        <div>
          <span class="eyebrow">Salvar local</span>
          <h2>Como você chama este lugar?</h2>
        </div>
        <button id="fechar-dialogo" class="botao-icone" type="button" aria-label="Fechar">×</button>
      </div>
      <div class="campo">
        <label for="local-nome">Nome do local</label>
        <input id="local-nome" name="nome" maxlength="80" required />
      </div>
      <div class="campo-duplo">
        <div class="campo">
          <label for="local-cidade">Cidade</label>
          <input id="local-cidade" name="cidade" maxlength="80" />
        </div>
        <div class="campo">
          <label for="local-estado">UF</label>
          <input id="local-estado" name="estado" maxlength="2" />
        </div>
      </div>
      <div class="campo">
        <label for="local-ambiente">Ambiente</label>
        <select id="local-ambiente" name="ambiente">
          <option value="Rio">Rio</option>
          <option value="Mar">Mar</option>
          <option value="Lagoa">Lagoa</option>
          <option value="Represa">Represa</option>
          <option value="PesquePague">Pesque-pague</option>
          <option value="Outro">Outro</option>
        </select>
      </div>
      <p id="local-erro" class="erro-campo oculto" role="alert"></p>
      <div class="dialogo-acoes">
        <button id="cancelar-local" class="btn btn--contorno" type="button">Cancelar</button>
        <button id="confirmar-local" class="btn btn--primario" type="submit">Salvar local</button>
      </div>
    </form>
  </dialog>

  <div id="toast" class="toast oculto" role="status" aria-live="polite"></div>

  <script>
    const API = (document.body.dataset.api ?? 'http://localhost:5184').replace(/\/$/, '');
    const busca = document.getElementById('busca-local') as HTMLInputElement | null;
    const resultados = document.getElementById('resultados-busca') as HTMLDivElement | null;
    const statusLocalizacao = document.getElementById('status-localizacao');
    const botaoLocalizacao = document.getElementById('usar-localizacao') as HTMLButtonElement | null;
    const dados = document.getElementById('dados-condicoes') as HTMLElement | null;
    const dialogo = document.getElementById('dialogo-local') as HTMLDialogElement | null;
    const formLocal = document.getElementById('form-local') as HTMLFormElement | null;
    const erroLocal = document.getElementById('local-erro');
    const toast = document.getElementById('toast');
    let timerToast = 0;

    let timerBusca = 0;

    function mostrarToast(mensagem: string) {
      if (!toast) return;
      toast.textContent = mensagem;
      toast.classList.remove('oculto');
      window.clearTimeout(timerToast);
      timerToast = window.setTimeout(() => toast.classList.add('oculto'), 2600);
    }

    function irPara(local: { latitude: number; longitude: number; nome?: string; cidade?: string | null; estado?: string | null; ambiente?: string }) {
      const params = new URLSearchParams({
        lat: String(local.latitude),
        lon: String(local.longitude),
        nome: local.nome ?? 'Local',
        cidade: local.cidade ?? '',
        estado: local.estado ?? '',
        ambiente: local.ambiente ?? 'Outro'
      });
      window.location.href = `/condicoes?${params.toString()}`;
    }

    async function buscar(termo: string) {
      if (!resultados) return;
      if (!termo || termo.trim().length < 2) {
        resultados.classList.add('oculto');
        return;
      }

      try {
        const resposta = await fetch(`${API}/api/locais/buscar?q=${encodeURIComponent(termo.trim())}`);
        if (!resposta.ok) throw new Error('busca');
        const lista = await resposta.json();
        if (!Array.isArray(lista) || lista.length === 0) {
          resultados.innerHTML = '<p class="busca-vazia">Nenhum lugar encontrado. Tente outro nome.</p>';
          resultados.classList.remove('oculto');
          return;
        }

        resultados.innerHTML = '';
        for (const item of lista) {
          const botao = document.createElement('button');
          botao.type = 'button';
          botao.className = 'busca-item';
          botao.innerHTML = `<strong>${item.nome}</strong><span>${[item.estado, item.pais].filter(Boolean).join(' · ')}</span>`;
          botao.addEventListener('click', () => irPara(item));
          resultados.appendChild(botao);
        }
        resultados.classList.remove('oculto');
      } catch {
        resultados.innerHTML = '<p class="busca-vazia">Não foi possível buscar agora.</p>';
        resultados.classList.remove('oculto');
      }
    }

    busca?.addEventListener('input', () => {
      window.clearTimeout(timerBusca);
      timerBusca = window.setTimeout(() => buscar(busca.value), 320);
    });

    document.addEventListener('click', (evento) => {
      const alvo = evento.target as HTMLElement | null;
      if (!alvo?.closest('.campo-busca')) {
        resultados?.classList.add('oculto');
      }
    });

    botaoLocalizacao?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        if (statusLocalizacao) statusLocalizacao.textContent = 'Seu navegador não oferece localização.';
        return;
      }

      botaoLocalizacao.disabled = true;
      botaoLocalizacao.textContent = 'Localizando...';
      if (statusLocalizacao) statusLocalizacao.textContent = 'Buscando sua localização...';

      navigator.geolocation.getCurrentPosition(
        (posicao) => {
          irPara({
            latitude: Number(posicao.coords.latitude.toFixed(5)),
            longitude: Number(posicao.coords.longitude.toFixed(5)),
            nome: 'Minha localização',
            cidade: '',
            estado: '',
            ambiente: 'Outro'
          });
        },
        () => {
          botaoLocalizacao.disabled = false;
          botaoLocalizacao.textContent = 'Usar minha localização';
          if (statusLocalizacao) statusLocalizacao.textContent = 'Não conseguimos usar sua localização. Busque pelo nome.';
        },
        { enableHighAccuracy: false, timeout: 12000, maximumAge: 300000 }
      );
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((botao) => {
      botao.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          mostrarToast('Link copiado.');
        } catch {
          mostrarToast('Não foi possível copiar o link.');
        }
      });
    });

    if (dialogo && dados) {
      const nome = document.getElementById('local-nome') as HTMLInputElement | null;
      const cidade = document.getElementById('local-cidade') as HTMLInputElement | null;
      const estado = document.getElementById('local-estado') as HTMLInputElement | null;
      const ambiente = document.getElementById('local-ambiente') as HTMLSelectElement | null;

      document.getElementById('salvar-local')?.addEventListener('click', () => {
        if (nome) nome.value = dados.dataset.nome || '';
        if (cidade) cidade.value = dados.dataset.cidade || '';
        if (estado) estado.value = dados.dataset.estado || '';
        if (ambiente) ambiente.value = dados.dataset.ambiente || 'Outro';
        erroLocal?.classList.add('oculto');
        dialogo.showModal();
      });

      document.getElementById('fechar-dialogo')?.addEventListener('click', () => dialogo.close());
      document.getElementById('cancelar-local')?.addEventListener('click', () => dialogo.close());

      formLocal?.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        const botao = document.getElementById('confirmar-local') as HTMLButtonElement | null;
        const texto = botao?.textContent ?? 'Salvar local';
        if (botao) {
          botao.disabled = true;
          botao.textContent = 'Salvando...';
        }
        erroLocal?.classList.add('oculto');

        try {
          const resposta = await fetch(`${API}/api/locais`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nome: nome?.value.trim(),
              cidade: cidade?.value.trim() || null,
              estado: estado?.value.trim().toUpperCase() || null,
              latitude: Number(dados.dataset.lat),
              longitude: Number(dados.dataset.lon),
              ambiente: ambiente?.value || 'Outro',
              padrao: false
            })
          });

          if (resposta.status === 401) {
            window.location.href = `/entrar?voltar=${encodeURIComponent(window.location.pathname + window.location.search)}`;
            return;
          }

          const corpo = await resposta.json().catch(() => ({}));
          if (!resposta.ok) throw new Error(corpo.detalhe || 'Não foi possível salvar o local.');

          mostrarToast('Local salvo.');
          window.setTimeout(() => window.location.reload(), 500);
        } catch (erro) {
          if (erroLocal) {
            erroLocal.textContent = erro instanceof Error ? erro.message : 'Não foi possível salvar o local.';
            erroLocal.classList.remove('oculto');
          }
          if (botao) {
            botao.disabled = false;
            botao.textContent = texto;
          }
        }
      });
    }
  </script>

  <style>
