---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { apiBase } from '../lib/api';
import type { LocalSalvo } from '../lib/tipos';

const cookie = Astro.request.headers.get('cookie') ?? '';
let locais: LocalSalvo[] = [];
let autenticado = false;
let erro = '';

if (cookie) {
  try {
    const resposta = await fetch(`${apiBase}/api/locais`, { headers: { cookie } });
    if (resposta.ok) {
      autenticado = true;
      locais = (await resposta.json()) as LocalSalvo[];
    } else if (resposta.status !== 401) {
      erro = 'Não conseguimos carregar seus locais agora.';
    }
  } catch {
    erro = 'Não conseguimos carregar seus locais agora.';
  }
}

const ambienteNome = (valor: string) =>
  valor === 'PesquePague' ? 'Pesque-pague' : valor;

const linkDoLocal = (local: LocalSalvo) => {
  const params = new URLSearchParams({
    lat: String(local.latitude),
    lon: String(local.longitude),
    nome: local.nome,
    cidade: local.cidade ?? '',
    estado: local.estado ?? '',
    ambiente: local.ambiente
  });
  return `/condicoes?${params.toString()}`;
};
---

<Layout
  titulo="Meus locais — Fisga"
  descricao="Seus locais de pesca salvos, com condições, maré e janela de pesca a um toque."
  noindex
>
  <section class="locais-topo">
    <div class="container">
      <span class="eyebrow">Meus locais</span>
      <h1>Os lugares que você <em>conhece.</em></h1>
      <p>
        Salve até cinco locais. O padrão abre primeiro nas condições e pré-preenche a pescaria.
      </p>
      <div class="hero-acoes">
        <a class="btn btn--primario" href="/condicoes">Buscar um local</a>
        <a class="btn btn--contorno" href="/conta">Minha conta</a>
      </div>
    </div>
  </section>

  <section class="container locais-conteudo">
    {erro && <div class="erro-caixa" role="alert">{erro}</div>}

    {!autenticado && !erro && (
      <div class="estado-vazio">
        <span class="eyebrow">Conta necessária</span>
        <h2>Entre para ver seus locais.</h2>
        <p>
          Os locais ficam na sua conta e abrem as condições já no lugar certo em qualquer aparelho.
        </p>
        <a class="btn btn--primario" href={`/entrar?voltar=${encodeURIComponent('/locais')}`}>Entrar com e-mail</a>
      </div>
    )}

    {autenticado && locais.length === 0 && (
      <div class="estado-vazio">
        <span class="eyebrow">Nenhum local ainda</span>
        <h2>Comece pelo lugar que você mais pesca.</h2>
        <p>
          Busque uma cidade ou praia nas condições e toque em “Salvar local”. Depois ele abre com um
          toque.
        </p>
        <a class="btn btn--primario" href="/condicoes">Buscar um local</a>
      </div>
    )}

    {autenticado && locais.length > 0 && (
      <div class="locais-grade">
        {locais.map((local) => (
          <article class="cartao local-card" data-local={local.id} data-lat={local.latitude} data-lon={local.longitude}>
            <div class="local-cabecalho">
              <div>
                <span class="eyebrow">{ambienteNome(local.ambiente)}</span>
                <h2>{local.nome}</h2>
                <p>{[local.cidade, local.estado].filter(Boolean).join(' · ') || 'Sem cidade informada'}</p>
              </div>
              {local.padrao && <span class="selo selo--terracota">Padrão</span>}
            </div>

            <div class="local-acoes">
              <a class="btn btn--pequeno btn--primario" href={linkDoLocal(local)}>Abrir condições</a>
              {!local.padrao && (
                <button class="btn btn--pequeno btn--contorno" type="button" data-padrao={local.id}>
                  Tornar padrão
                </button>
              )}
              <button class="btn btn--pequeno btn--contorno local-excluir" type="button" data-excluir={local.id}>
                Excluir
              </button>
            </div>

            <details class="local-editar">
              <summary>Editar nome e dados</summary>
              <form data-editar={local.id}>
                <div class="campo">
                  <label for={`nome-${local.id}`}>Nome</label>
                  <input id={`nome-${local.id}`} name="nome" value={local.nome} maxlength="80" required />
                </div>
                <div class="campo-duplo">
                  <div class="campo">
                    <label for={`cidade-${local.id}`}>Cidade</label>
                    <input id={`cidade-${local.id}`} name="cidade" value={local.cidade ?? ''} maxlength="80" />
                  </div>
                  <div class="campo">
                    <label for={`estado-${local.id}`}>UF</label>
                    <input id={`estado-${local.id}`} name="estado" value={local.estado ?? ''} maxlength="2" />
                  </div>
                </div>
                <div class="campo">
                  <label for={`ambiente-${local.id}`}>Ambiente</label>
                  <select id={`ambiente-${local.id}`} name="ambiente">
                    <option value="Rio" selected={local.ambiente === 'Rio'}>Rio</option>
                    <option value="Mar" selected={local.ambiente === 'Mar'}>Mar</option>
                    <option value="Lagoa" selected={local.ambiente === 'Lagoa'}>Lagoa</option>
                    <option value="Represa" selected={local.ambiente === 'Represa'}>Represa</option>
                    <option value="PesquePague" selected={local.ambiente === 'PesquePague'}>Pesque-pague</option>
                    <option value="Outro" selected={local.ambiente === 'Outro'}>Outro</option>
                  </select>
                </div>
                <p class="local-erro oculto" role="alert"></p>
                <button class="btn btn--pequeno btn--contorno" type="submit">Salvar alterações</button>
              </form>
            </details>
          </article>
        ))}
      </div>
    )}
  </section>

  <div id="toast" class="toast oculto" role="status" aria-live="polite"></div>

  <script>
    const API = (document.body.dataset.api ?? 'http://localhost:5184').replace(/\/$/, '');
    const toast = document.getElementById('toast');
    let timerToast = 0;

    function mostrarToast(mensagem: string) {
      if (!toast) return;
      toast.textContent = mensagem;
      toast.classList.remove('oculto');
      window.clearTimeout(timerToast);
      timerToast = window.setTimeout(() => toast.classList.add('oculto'), 2600);
    }

    async function chamar(caminho: string, opcoes: RequestInit) {
      const resposta = await fetch(`${API}${caminho}`, {
        credentials: 'include',
        ...opcoes,
        headers: {
          ...(opcoes.body ? { 'Content-Type': 'application/json' } : {}),
          ...(opcoes.headers ?? {})
        }
      });

      if (resposta.status === 401) {
        window.location.href = `/entrar?voltar=${encodeURIComponent('/locais')}`;
        return null;
      }

      const corpo = await resposta.json().catch(() => ({}));
      if (!resposta.ok) {
        throw new Error(corpo.detalhe || 'Não foi possível concluir a ação.');
      }

      return corpo;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-padrao]').forEach((botao) => {
      botao.addEventListener('click', async () => {
        botao.disabled = true;
        try {
          await chamar(`/api/locais/${botao.dataset.padrao}/padrao`, { method: 'POST' });
          window.location.reload();
        } catch (erro) {
          mostrarToast(erro instanceof Error ? erro.message : 'Não foi possível definir o padrão.');
          botao.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-excluir]').forEach((botao) => {
      botao.addEventListener('click', async () => {
        if (!window.confirm('Excluir este local? As pescarias continuam no diário.')) return;
        botao.disabled = true;
        try {
          await chamar(`/api/locais/${botao.dataset.excluir}`, { method: 'DELETE' });
          window.location.reload();
        } catch (erro) {
          mostrarToast(erro instanceof Error ? erro.message : 'Não foi possível excluir o local.');
          botao.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLFormElement>('[data-editar]').forEach((form) => {
      form.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        const id = form.dataset.editar;
        const dados = new FormData(form);
        const erro = form.querySelector<HTMLElement>('.local-erro');
        const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!id || !botao) return;

        botao.disabled = true;
        erro?.classList.add('oculto');

        try {
          await chamar(`/api/locais/${id}`, {
            method: 'PUT',
            body: JSON.stringify({
              nome: String(dados.get('nome') ?? ''),
              cidade: String(dados.get('cidade') ?? '').trim() || null,
              estado: String(dados.get('estado') ?? '').trim().toUpperCase() || null,
              latitude: Number(form.closest<HTMLElement>('[data-local]')?.dataset.lat ?? 0),
              longitude: Number(form.closest<HTMLElement>('[data-local]')?.dataset.lon ?? 0),
              ambiente: String(dados.get('ambiente') ?? 'Outro'),
              padrao: false
            })
          });
          mostrarToast('Local atualizado.');
          window.setTimeout(() => window.location.reload(), 500);
        } catch (falha) {
          if (erro) {
            erro.textContent = falha instanceof Error ? falha.message : 'Não foi possível salvar.';
            erro.classList.remove('oculto');
          }
          botao.disabled = false;
        }
      });
    });
  </script>

  <style>
    .locais-topo {
      padding: clamp(48px, 7vw, 86px) 0 30px;
    }

    .locais-topo h1 {
      max-width: 720px;
      font-size: clamp(2.6rem, 6vw, 4.6rem);
    }

    .locais-topo p {
      max-width: 560px;
      margin-top: 16px;
      color: var(--tinta-suave);
    }

    .locais-topo .hero-acoes {
      margin-top: 24px;
    }

    .locais-conteudo {
      padding-bottom: 84px;
    }

    .locais-grade {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .local-card {
      display: grid;
      gap: 14px;
    }

    .local-cabecalho {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 12px;
    }

    .local-cabecalho h2 {
      margin-top: 4px;
      font-size: 1.7rem;
    }

    .local-cabecalho p {
      margin-top: 2px;
      color: var(--tinta-suave);
      font-size: 0.74rem;
    }

    .local-acoes {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .local-editar {
      padding-top: 10px;
      border-top: 1px solid var(--linha);
    }

    .local-editar summary {
      color: var(--tinta-suave);
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
    }

    .local-editar form {
      display: grid;
      gap: 10px;
      margin-top: 12px;
    }

    .local-erro {
      padding: 7px 9px;
      border: 1px solid var(--acafrao);
      border-radius: 7px;
      background: #fff4ea;
      color: #8a3f1c;
      font-size: 0.72rem;
    }

    .toast {
      position: fixed;
      z-index: 80;
      bottom: 24px;
      left: 50%;
      padding: 10px 16px;
      border-radius: 999px;
      background: var(--terracota-escura);
      color: var(--creme);
      font-size: 0.78rem;
      transform: translateX(-50%);
      box-shadow: var(--sombra);
    }

    @media (max-width: 760px) {
      .locais-grade {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
