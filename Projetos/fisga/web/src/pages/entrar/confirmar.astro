---
import Layout from '../../layouts/Layout.astro';

const estado = Astro.url.searchParams.get('estado') ?? '';
---

<Layout
  titulo="Confirmando acesso — Fisga"
  descricao="Confirmando seu link de acesso ao Fisga."
  bodyClass="pagina-confirmar"
>
  <section class="confirmar">
    <div class="container">
      <div class="confirmar-cartao" data-estado={estado ?? ''}>
        <div id="confirmar-conteudo">
          <div class="confirmar-icone" id="confirmar-icone" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2.2" opacity=".35" />
              <path d="m16 24 5.5 5.5L33 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <span class="eyebrow" id="confirmar-eyebrow">Confirmando acesso</span>
          <h1 id="confirmar-titulo">Tudo certo. <em>Abrindo seu diário.</em></h1>
          <p id="confirmar-texto">
            Estamos validando seu link e preparando o seu diário. Você será redirecionado em instantes.
          </p>

          <div class="confirmar-progresso" aria-hidden="true"><span></span></div>

          <a class="btn btn--primario oculto" id="confirmar-acao" href="/hoje">Abrir Hoje</a>
          <a class="btn btn--contorno oculto" id="confirmar-secundaria" href="/entrar">Pedir um novo link</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .confirmar {
    display: grid;
    min-height: 62vh;
    padding: clamp(48px, 8vw, 96px) 0;
    place-items: center;
  }

  .confirmar-cartao {
    width: min(100%, 560px);
    margin: 0 auto;
    padding: clamp(28px, 5vw, 46px);
    border: 1px solid var(--linha);
    border-radius: 22px;
    background: var(--superficie);
    box-shadow: var(--sombra);
    text-align: center;
  }

  .confirmar-icone {
    display: grid;
    width: 68px;
    height: 68px;
    margin: 0 auto 20px;
    place-items: center;
    border-radius: 999px;
    background: var(--terracota-clara);
    color: var(--terracota);
  }

  .confirmar-icone.erro {
    background: #f7e7de;
    color: var(--acafrao);
  }

  .confirmar-icone svg {
    width: 36px;
  }

  .confirmar-cartao h1 {
    margin-top: 12px;
    font-size: clamp(2rem, 4vw, 2.9rem);
  }

  .confirmar-cartao p {
    max-width: 40ch;
    margin: 14px auto 0;
    color: var(--tinta-suave);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .confirmar-cartao .btn {
    margin-top: 22px;
  }

  .confirmar-progresso {
    width: min(100%, 220px);
    height: 3px;
    margin: 26px auto 0;
    overflow: hidden;
    border-radius: 999px;
    background: var(--linha);
  }

  .confirmar-progresso span {
    display: block;
    width: 45%;
    height: 100%;
    border-radius: 999px;
    background: var(--acafrao);
    animation: confirmar-correr 1.4s ease-in-out infinite;
  }

  @keyframes confirmar-correr {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(320%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .confirmar-progresso span {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  import { apiBase, obterSessao } from '../../lib/auth';

  const API = apiBase();
  const estado = document.querySelector('[data-estado]')?.getAttribute('data-estado') || '';
  const icone = document.getElementById('confirmar-icone')!;
  const eyebrow = document.getElementById('confirmar-eyebrow')!;
  const titulo = document.getElementById('confirmar-titulo')!;
  const texto = document.getElementById('confirmar-texto')!;
  const progresso = document.querySelector('.confirmar-progresso')!;
  const acao = document.getElementById('confirmar-acao') as HTMLAnchorElement;
  const secundaria = document.getElementById('confirmar-secundaria') as HTMLAnchorElement;

  // Estados de erro do link mágico e do retorno do Google (Task 8).
  const ERROS: Record<string, { titulo: string; texto: string }> = {
    link_expirado: {
      titulo: 'Esse link <em>expirou.</em>',
      texto: 'Links de acesso valem por 15 minutos. Peça um novo para entrar no seu diário.'
    },
    link_ja_usado: {
      titulo: 'Esse link <em>já foi usado.</em>',
      texto: 'Por segurança, cada link funciona uma única vez. Peça um novo acesso.'
    },
    link_invalido: {
      titulo: 'Esse link <em>não é válido.</em>',
      texto: 'O endereço pode estar incompleto ou ter sido alterado. Peça um novo link para entrar.'
    },
    sessao_expirada: {
      titulo: 'Sua sessão <em>expirou.</em>',
      texto: 'Entre novamente para continuar no seu diário.'
    },
    google_indisponivel: {
      titulo: 'Google <em>indisponível.</em>',
      texto: 'O acesso com Google não está configurado agora. Use seu e-mail e senha para entrar.'
    },
    google_sessao_externa_invalida: {
      titulo: 'Não concluímos o <em>Google.</em>',
      texto: 'A sessão com o Google expirou. Tente entrar de novo.'
    },
    google_email_ausente: {
      titulo: 'O Google não <em>informou seu e-mail.</em>',
      texto: 'Permita o acesso ao e-mail na conta Google e tente novamente.'
    },
    google_email_nao_verificado: {
      titulo: 'E-mail do Google <em>não confirmado.</em>',
      texto: 'Confirme seu e-mail no Google e tente novamente.'
    },
    google_email_nao_verificado_localmente: {
      titulo: 'Não pudemos <em>vincular a conta.</em>',
      texto: 'O e-mail local precisa estar confirmado antes de usar o Google. Entre com sua senha e confirme o e-mail.'
    },
    google_provider_invalido: {
      titulo: 'Provedor <em>não reconhecido.</em>',
      texto: 'Tente entrar com Google novamente.'
    },
    google_subject_invalido: {
      titulo: 'Não concluímos o <em>Google.</em>',
      texto: 'A identidade Google veio incompleta. Tente novamente.'
    },
    google_vinculo_falhou: {
      titulo: 'Não foi possível <em>vincular o Google.</em>',
      texto: 'Este acesso Google já está associado a outra conta. Tente novamente ou use seu e-mail.'
    },
    google_conta_inconsistente: {
      titulo: 'Não encontramos <em>sua conta.</em>',
      texto: 'Tente novamente ou fale com o suporte se o problema continuar.'
    }
  };

  const PADRAO = {
    titulo: 'Não foi possível <em>confirmar o acesso.</em>',
    texto: 'O link pode estar incompleto ou ter sido alterado. Peça um novo para entrar no seu diário.'
  };

  function destino() {
    try {
      const salvo = sessionStorage.getItem('fisga:retorno');
      if (salvo && salvo.startsWith('/') && !salvo.startsWith('//')) {
        sessionStorage.removeItem('fisga:retorno');
        return salvo;
      }
    } catch {
      // armazenamento indisponível
    }
    return '/hoje';
  }

  async function concluir(alvo: string) {
    const sessao = await obterSessao(API);
    if (sessao?.consentimentoPendente) {
      window.location.replace(`/aceite?destino=${encodeURIComponent(alvo)}`);
      return;
    }
    window.location.replace(alvo);
  }

  if (estado === 'ok' || estado === '') {
    const alvo = destino();
    acao.href = alvo;
    acao.addEventListener('click', (evento) => {
      evento.preventDefault();
      concluir(alvo);
    });
    window.setTimeout(() => concluir(alvo), estado === 'ok' ? 1400 : 900);
  } else {
    const mensagem = ERROS[estado] ?? PADRAO;
    icone.classList.add('erro');
    eyebrow.textContent = 'Acesso não confirmado';
    titulo.innerHTML = mensagem.titulo;
    texto.textContent = mensagem.texto;
    progresso.classList.add('oculto');
    acao.classList.remove('oculto');
    secundaria.classList.remove('oculto');
    acao.href = '/entrar';
    acao.textContent = 'Tentar entrar';
    secundaria.href = '/entrar';
    secundaria.textContent = 'Pedir um novo link';
  }
</script>
