---
import Layout from '../layouts/Layout.astro';
import 'leaflet/dist/leaflet.css';
---

<Layout
  titulo="Mapa privado — Fisga"
  descricao="Seus pontos de pesca, poitas, estruturas e trilhas. Privados por padrão, com camadas náuticas e batimetria."
  noindex
>
  <section class="mapa-topo">
    <div class="container">
      <span class="eyebrow">Mapa privado</span>
      <h1>Seus pontos, <em>só seus.</em></h1>
      <p>
        Marque poitas, lajes, canais, manguezais e rampas. Nenhuma coordenada é publicada. O mapa
        usa camadas gratuitas e funciona como caderno pessoal.
      </p>
      <div class="hero-acoes">
        <button id="adicionar-ponto" class="btn btn--primario" type="button">Adicionar ponto</button>
        <button id="desenhar-trilha" class="btn btn--contorno" type="button">Desenhar trilha</button>
        <button id="exportar-gpx" class="btn btn--contorno oculto" type="button">Exportar GPX</button>
        <button id="usar-localizacao-mapa" class="btn btn--contorno" type="button">Ir para minha localização</button>
        <a id="entrar-mapa" class="btn btn--contorno oculto" href={`/entrar?voltar=${encodeURIComponent('/mapa')}`}>Entrar para salvar</a>
      </div>
      <p class="mapa-aviso-privacidade">
        Privacidade por padrão: os pontos ficam na sua conta. O Fisga não mostra suas coordenadas
        para outros pescadores.
      </p>
    </div>
  </section>

  <section class="container mapa-conteudo">
    <div id="mapa-aviso" class="mapa-aviso oculto" role="status" aria-live="polite"></div>

    <div class="mapa-layout">
      <div class="mapa-painel">
        <div id="mapa" aria-label="Mapa de pontos privados de pesca"></div>
        <div class="mapa-legenda" aria-hidden="true">
          <span><i class="ponto-legenda"></i> Ponto privado</span>
          <span>Camadas: mapa, satélite, náutico e batimetria</span>
        </div>
      </div>

      <aside class="mapa-lateral">
        <article class="cartao mapa-lista">
          <div class="cartao-topo">
            <span class="eyebrow">Seus pontos</span>
            <span id="contagem-pontos" class="selo selo--neutro">0</span>
          </div>
          <p class="mapa-lista-ajuda">
            Clique no mapa para marcar um ponto. Arraste, aproxime e use as camadas no canto.
          </p>
          <div id="lista-pontos" class="lista-pontos"></div>
        </article>

        <article class="cartao mapa-trilhas">
          <div class="cartao-topo">
            <span class="eyebrow">Trilhas</span>
            <span id="contagem-trilhas" class="selo selo--neutro">0</span>
          </div>
          <p class="mapa-lista-ajuda">
            Corrico e deslocamento. Toque em “Desenhar trilha”, clique no mapa e finalize.
          </p>
          <div id="lista-trilhas" class="lista-trilhas"></div>
        </article>

        <article class="cartao mapa-offline">
          <span class="eyebrow">No mar, sem sinal</span>
          <h3>O que fica no aparelho</h3>
          <p>
            Seus pontos e trilhas ficam salvos localmente para consulta offline. As condições já
            visitadas e os últimos azulejos do mapa também ficam em cache. Não é um mapa offline
            completo: baixe a área antes de sair para o mar.
          </p>
        </article>

        <article class="cartao mapa-privacidade">
          <span class="eyebrow">Privacidade</span>
          <h3>Nenhum ponto é público.</h3>
          <p>
            Waypoints, poitas e trilhas são privados. A inteligência coletiva futura será anônima e
            por macrorregião, nunca com a coordenada exata.
          </p>
        </article>
      </aside>
    </div>
  </section>

  <div id="barra-trilha" class="barra-trilha oculto" role="status" aria-live="polite">
    <span id="trilha-status">Clique no mapa para adicionar pontos</span>
    <button id="desfazer-trilha" class="btn btn--pequeno btn--contorno" type="button">Desfazer</button>
    <button id="finalizar-trilha" class="btn btn--pequeno btn--primario" type="button">Finalizar</button>
    <button id="cancelar-trilha" class="btn btn--pequeno btn--contorno" type="button">Cancelar</button>
  </div>

  <dialog id="dialogo-trilha" class="dialogo-ponto">
    <form id="form-trilha">
      <div class="dialogo-topo">
        <div>
          <span class="eyebrow">Trilha privada</span>
          <h2>Salvar trilha</h2>
        </div>
        <button id="fechar-trilha" class="botao-icone" type="button" aria-label="Fechar">×</button>
      </div>

      <div class="campo">
        <label for="trilha-nome">Nome</label>
        <input id="trilha-nome" maxlength="80" required placeholder="Ex.: Corrico da laje" />
      </div>

      <div class="campo">
        <label for="trilha-tipo">Tipo</label>
        <select id="trilha-tipo">
          <option value="Corrico">Corrico</option>
          <option value="Deslocamento">Deslocamento</option>
        </select>
      </div>

      <div class="campo">
        <label for="trilha-descricao">Notas privadas</label>
        <textarea id="trilha-descricao" rows="3" maxlength="1000" placeholder="Profundidade, corrente, isca, cuidado..."></textarea>
      </div>

      <p id="trilha-resumo" class="trilha-resumo"></p>
      <p id="trilha-erro" class="erro-campo oculto" role="alert"></p>

      <div class="dialogo-acoes">
        <button id="cancelar-trilha-dialogo" class="btn btn--contorno" type="button">Cancelar</button>
        <button id="salvar-trilha" class="btn btn--primario" type="submit">Salvar trilha</button>
      </div>
    </form>
  </dialog>

  <dialog id="dialogo-ponto" class="dialogo-ponto">
    <form id="form-ponto">
      <input id="ponto-id" type="hidden" />
      <div class="dialogo-topo">
        <div>
          <span class="eyebrow">Ponto privado</span>
          <h2 id="titulo-dialogo-ponto">Novo ponto</h2>
        </div>
        <button id="fechar-ponto" class="botao-icone" type="button" aria-label="Fechar">×</button>
      </div>

      <div class="campo">
        <label for="ponto-nome">Nome</label>
        <input id="ponto-nome" maxlength="80" required placeholder="Ex.: Laje do Farol" />
      </div>

      <div class="campo">
        <label for="ponto-tipo">Tipo</label>
        <select id="ponto-tipo">
          <option value="Ponto">Ponto</option>
          <option value="Poita">Poita</option>
          <option value="Estrutura">Estrutura</option>
          <option value="Trilha">Trilha</option>
          <option value="Rampa">Rampa</option>
        </select>
      </div>

      <div class="campo">
        <label for="ponto-descricao">Notas privadas</label>
        <textarea id="ponto-descricao" rows="4" maxlength="1000" placeholder="Profundidade, fundo, isca, cuidado com a corrente..."></textarea>
      </div>

      <div class="campo-duplo">
        <div class="campo">
          <label for="ponto-lat">Latitude</label>
          <input id="ponto-lat" inputmode="decimal" required />
        </div>
        <div class="campo">
          <label for="ponto-lon">Longitude</label>
          <input id="ponto-lon" inputmode="decimal" required />
        </div>
      </div>

      <p id="ponto-erro" class="erro-campo oculto" role="alert"></p>

      <div class="dialogo-acoes">
        <button id="cancelar-ponto" class="btn btn--contorno" type="button">Cancelar</button>
        <button id="salvar-ponto" class="btn btn--primario" type="submit">Salvar ponto</button>
      </div>
    </form>
  </dialog>

  <div id="toast" class="toast oculto" role="status" aria-live="polite"></div>

  <script>
    import L from 'leaflet';

    const API = (document.body.dataset.api ?? 'http://localhost:5184').replace(/\/$/, '');
    const TIPOS: Record<string, string> = {
      Ponto: 'Ponto',
      Poita: 'Poita',
      Estrutura: 'Estrutura',
      Trilha: 'Trilha',
      Rampa: 'Rampa'
    };

    const mapa = L.map('mapa', { zoomControl: true }).setView([-14.235, -51.925], 4);

    const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    });
    const satelite = L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      {
        maxZoom: 19,
        attribution: 'Tiles &copy; Esri — Esri, Maxar, Earthstar Geographics'
      }
    );
    const nautico = L.tileLayer('https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenSeaMap'
    });
    const batimetria = L.tileLayer.wms('https://wms.gebco.net/mapserv?', {
      layers: 'GEBCO_LATEST',
      format: 'image/png',
      transparent: true,
      version: '1.3.0',
      crs: L.CRS.EPSG3857,
      opacity: 0.55,
      attribution: 'GEBCO'
    });

    osm.addTo(mapa);
    nautico.addTo(mapa);

    L.control
      .layers(
        { Mapa: osm, Satélite: satelite },
        { Náutico: nautico, Batimetria: batimetria },
        { collapsed: L.Browser.mobile }
      )
      .addTo(mapa);

    L.control.scale({ imperial: false }).addTo(mapa);

    const camadaPontos = L.layerGroup().addTo(mapa);
    const camadaTrilhas = L.layerGroup().addTo(mapa);
    const camadaDesenho = L.layerGroup().addTo(mapa);
    const lista = document.getElementById('lista-pontos') as HTMLDivElement | null;
    const listaTrilhas = document.getElementById('lista-trilhas') as HTMLDivElement | null;
    const contagem = document.getElementById('contagem-pontos');
    const contagemTrilhas = document.getElementById('contagem-trilhas');
    const barraTrilha = document.getElementById('barra-trilha');
    const statusTrilha = document.getElementById('trilha-status');
    const dialogoTrilha = document.getElementById('dialogo-trilha') as HTMLDialogElement | null;
    const formTrilha = document.getElementById('form-trilha') as HTMLFormElement | null;
    const erroTrilha = document.getElementById('trilha-erro');
    const botaoSalvarTrilha = document.getElementById('salvar-trilha') as HTMLButtonElement | null;
    const botaoExportar = document.getElementById('exportar-gpx') as HTMLButtonElement | null;
    const aviso = document.getElementById('mapa-aviso');
    const dialogo = document.getElementById('dialogo-ponto') as HTMLDialogElement | null;
    const form = document.getElementById('form-ponto') as HTMLFormElement | null;
    const erro = document.getElementById('ponto-erro');
    const botaoEntrar = document.getElementById('entrar-mapa');
    const toast = document.getElementById('toast');
    const botaoSalvar = document.getElementById('salvar-ponto') as HTMLButtonElement | null;

    let pontos: Array<Record<string, any>> = [];
    let trilhas: Array<Record<string, any>> = [];
    let autenticado = false;
    let editandoId: string | null = null;
    let desenhando = false;
    let pontosDesenho: L.LatLng[] = [];
    let timerToast = 0;

    function mostrarToast(mensagem: string) {
      if (!toast) return;
      toast.textContent = mensagem;
      toast.classList.remove('oculto');
      window.clearTimeout(timerToast);
      timerToast = window.setTimeout(() => toast.classList.add('oculto'), 2800);
    }

    function mostrarAviso(mensagem: string) {
      if (!aviso) return;
      aviso.textContent = mensagem;
      aviso.classList.remove('oculto');
    }

    function esconderAviso() {
      aviso?.classList.add('oculto');
    }

    function rotuloTipo(tipo: string) {
      return TIPOS[tipo] ?? tipo;
    }

    function icone(tipo: string) {
      return L.divIcon({
        className: `ponto-marker ponto-${tipo.toLowerCase()}`,
        html: '<span></span>',
        iconSize: [28, 28],
        iconAnchor: [14, 28],
        popupAnchor: [0, -26]
      });
    }

    function conteudoPopup(ponto: Record<string, any>) {
      const container = document.createElement('div');
      container.className = 'popup-ponto';
      const titulo = document.createElement('strong');
      titulo.textContent = ponto.nome;
      const tipo = document.createElement('span');
      tipo.textContent = rotuloTipo(ponto.tipo);
      container.append(titulo, tipo);

      if (ponto.descricao) {
        const notas = document.createElement('p');
        notas.textContent = ponto.descricao;
        container.appendChild(notas);
      }

      const coordenadas = document.createElement('code');
      coordenadas.textContent = `${Number(ponto.latitude).toFixed(4)}, ${Number(ponto.longitude).toFixed(4)}`;
      container.appendChild(coordenadas);
      return container;
    }

    function criarCartao(ponto: Record<string, any>) {
      const artigo = document.createElement('article');
      artigo.className = 'ponto-card';

      const topo = document.createElement('div');
      topo.className = 'ponto-card-topo';
      const nome = document.createElement('strong');
      nome.textContent = ponto.nome;
      const tipo = document.createElement('span');
      tipo.className = 'ponto-tipo';
      tipo.textContent = rotuloTipo(ponto.tipo);
      topo.append(nome, tipo);

      const coordenadas = document.createElement('small');
      coordenadas.textContent = `${Number(ponto.latitude).toFixed(4)}, ${Number(ponto.longitude).toFixed(4)}`;

      const notas = document.createElement('p');
      notas.textContent = ponto.descricao || 'Sem notas.';

      const acoes = document.createElement('div');
      acoes.className = 'ponto-acoes';

      const ir = document.createElement('button');
      ir.type = 'button';
      ir.className = 'btn btn--pequeno btn--contorno';
      ir.textContent = 'Ir';
      ir.addEventListener('click', () => {
        mapa.flyTo([Number(ponto.latitude), Number(ponto.longitude)], 13, { duration: 0.7 });
      });

      const editar = document.createElement('button');
      editar.type = 'button';
      editar.className = 'btn btn--pequeno btn--contorno';
      editar.textContent = 'Editar';
      editar.addEventListener('click', () => abrirDialogo(ponto));

      const excluir = document.createElement('button');
      excluir.type = 'button';
      excluir.className = 'btn btn--pequeno btn--contorno';
      excluir.textContent = 'Excluir';
      excluir.addEventListener('click', () => excluirPonto(ponto));

      acoes.append(ir, editar, excluir);
      artigo.append(topo, coordenadas, notas, acoes);
      return artigo;
    }

    function distanciaEntre(a: L.LatLng, b: L.LatLng) {
      const raio = 6371;
      const dLat = ((b.lat - a.lat) * Math.PI) / 180;
      const dLon = ((b.lng - a.lng) * Math.PI) / 180;
      const lat1 = (a.lat * Math.PI) / 180;
      const lat2 = (b.lat * Math.PI) / 180;
      const h =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return 2 * raio * Math.asin(Math.sqrt(h));
    }

    function distanciaDesenho() {
      let total = 0;
      for (let indice = 1; indice < pontosDesenho.length; indice++) {
        total += distanciaEntre(pontosDesenho[indice - 1], pontosDesenho[indice]);
      }
      return total;
    }

    function atualizarBarraTrilha() {
      if (statusTrilha) {
        statusTrilha.textContent =
          pontosDesenho.length === 0
            ? 'Clique no mapa para adicionar pontos'
            : `${pontosDesenho.length} pontos · ${distanciaDesenho().toFixed(2).replace('.', ',')} km`;
      }

      const finalizar = document.getElementById('finalizar-trilha') as HTMLButtonElement | null;
      if (finalizar) finalizar.disabled = pontosDesenho.length < 2;
    }

    function redesenharDesenho() {
      camadaDesenho.clearLayers();

      for (const ponto of pontosDesenho) {
        L.circleMarker(ponto, {
          radius: 5,
          color: '#174E57',
          fillColor: '#174E57',
          fillOpacity: 1,
          weight: 2
        }).addTo(camadaDesenho);
      }

      if (pontosDesenho.length > 1) {
        L.polyline(pontosDesenho, { color: '#174E57', weight: 3 }).addTo(camadaDesenho);
      }

      atualizarBarraTrilha();
    }

    function iniciarDesenho() {
      if (!autenticado) {
        window.location.href = `/entrar?voltar=${encodeURIComponent('/mapa')}`;
        return;
      }

      desenhando = true;
      pontosDesenho = [];
      camadaDesenho.clearLayers();
      mapa.doubleClickZoom.disable();
      mapa.closePopup();
      mapa.getContainer().style.cursor = 'crosshair';
      barraTrilha?.classList.remove('oculto');
      atualizarBarraTrilha();
      mostrarToast('Clique no mapa para desenhar. Finalize quando terminar.');
    }

    function cancelarDesenho() {
      desenhando = false;
      pontosDesenho = [];
      camadaDesenho.clearLayers();
      barraTrilha?.classList.add('oculto');
      mapa.getContainer().style.cursor = '';
      mapa.doubleClickZoom.enable();
      atualizarBarraTrilha();
    }

    function adicionarPontoDesenho(latlng: L.LatLng) {
      pontosDesenho.push(latlng);
      redesenharDesenho();
    }

    function atualizarExportacao() {
      const temDados = pontos.length + trilhas.length > 0;
      botaoExportar?.classList.toggle('oculto', !temDados);
    }

    function escaparXml(valor: unknown) {
      return String(valor ?? '').replace(/[<>&"']/g, (caractere) => {
        const mapa: Record<string, string> = {
          '<': '&lt;',
          '>': '&gt;',
          '&': '&amp;',
          '"': '&quot;',
          "'": '&apos;'
        };
        return mapa[caractere] ?? caractere;
      });
    }

    function exportarGpx() {
      if (pontos.length + trilhas.length === 0) {
        mostrarToast('Nada para exportar ainda.');
        return;
      }

      const partes = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<gpx version="1.1" creator="Fisga" xmlns="http://www.topografix.com/GPX/1/1">'
      ];

      for (const ponto of pontos) {
        partes.push(
          `<wpt lat="${Number(ponto.latitude)}" lon="${Number(ponto.longitude)}"><name>${escaparXml(ponto.nome)}</name><desc>${escaparXml(ponto.descricao ?? '')}</desc></wpt>`
        );
      }

      for (const trilha of trilhas) {
        partes.push(`<trk><name>${escaparXml(trilha.nome)}</name><desc>${escaparXml(trilha.descricao ?? '')}</desc><trkseg>`);
        for (const ponto of trilha.pontos ?? []) {
          partes.push(`<trkpt lat="${Number(ponto.latitude)}" lon="${Number(ponto.longitude)}"></trkpt>`);
        }
        partes.push('</trkseg></trk>');
      }

      partes.push('</gpx>');

      const blob = new Blob([partes.join('\n')], { type: 'application/gpx+xml' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `fisga-${new Date().toISOString().slice(0, 10)}.gpx`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1200);
      mostrarToast('GPX exportado.');
    }

    function criarCartaoTrilha(trilha: Record<string, any>) {
      const artigo = document.createElement('article');
      artigo.className = 'trilha-card';

      const topo = document.createElement('div');
      topo.className = 'ponto-card-topo';
      const nome = document.createElement('strong');
      nome.textContent = trilha.nome;
      const tipo = document.createElement('span');
      tipo.className = 'ponto-tipo';
      tipo.textContent = `${trilha.tipo} · ${Number(trilha.distanciaKm).toFixed(1).replace('.', ',')} km`;
      topo.append(nome, tipo);

      const notas = document.createElement('p');
      notas.textContent = trilha.descricao || 'Sem notas.';

      const acoes = document.createElement('div');
      acoes.className = 'ponto-acoes';

      const ver = document.createElement('button');
      ver.type = 'button';
      ver.className = 'btn btn--pequeno btn--contorno';
      ver.textContent = 'Ver';
      ver.addEventListener('click', () => {
        const linha = L.polyline(
          (trilha.pontos ?? []).map((ponto: Record<string, number>) => [ponto.latitude, ponto.longitude]),
          { color: '#d9773f', weight: 3 }
        );
        mapa.fitBounds(linha.getBounds(), { padding: [32, 32] });
      });

      const excluir = document.createElement('button');
      excluir.type = 'button';
      excluir.className = 'btn btn--pequeno btn--contorno';
      excluir.textContent = 'Excluir';
      excluir.addEventListener('click', () => excluirTrilha(trilha));

      acoes.append(ver, excluir);
      artigo.append(topo, notas, acoes);
      return artigo;
    }

    function renderizarTrilhas() {
      camadaTrilhas.clearLayers();
      if (listaTrilhas) listaTrilhas.innerHTML = '';
      if (contagemTrilhas) contagemTrilhas.textContent = String(trilhas.length);

      if (trilhas.length === 0) {
        const vazio = document.createElement('p');
        vazio.className = 'mapa-vazio';
        vazio.textContent = autenticado
          ? 'Nenhuma trilha ainda. Desenhe um corrico ou deslocamento.'
          : 'Entre para desenhar trilhas privadas.';
        listaTrilhas?.appendChild(vazio);
        atualizarExportacao();
        return;
      }

      for (const trilha of trilhas) {
        const pontosTrilha = (trilha.pontos ?? []).map((ponto: Record<string, number>) => [
          Number(ponto.latitude),
          Number(ponto.longitude)
        ]) as L.LatLngExpression[];

        if (pontosTrilha.length < 2) continue;

        const linha = L.polyline(pontosTrilha, {
          color: '#d9773f',
          weight: 3,
          opacity: 0.85
        }).addTo(camadaTrilhas);

        linha.bindPopup(`<strong>${escaparXml(trilha.nome)}</strong><br>${escaparXml(trilha.tipo)} · ${Number(trilha.distanciaKm).toFixed(1)} km`);
        linha.on('click', () => mapa.fitBounds(linha.getBounds(), { padding: [32, 32] }));
        listaTrilhas?.appendChild(criarCartaoTrilha(trilha));
      }

      atualizarExportacao();
    }

    async function carregarTrilhas() {
      if (!autenticado) {
        trilhas = [];
        renderizarTrilhas();
        return;
      }

      try {
        const resposta = await fetch(`${API}/api/trilhas`, { credentials: 'include' });
        if (resposta.status === 401) {
          autenticado = false;
          localStorage.removeItem('fisga:trilhas:v1');
          atualizarSessao();
          return;
        }

        if (!resposta.ok) throw new Error('api');
        trilhas = await resposta.json();
        localStorage.setItem('fisga:trilhas:v1', JSON.stringify(trilhas));
        renderizarTrilhas();
      } catch {
        const cache = localStorage.getItem('fisga:trilhas:v1');
        if (cache) {
          trilhas = JSON.parse(cache);
          renderizarTrilhas();
          mostrarAviso('Sem conexão. Mostrando as trilhas salvas neste aparelho.');
        } else {
          renderizarTrilhas();
        }
      }
    }

    async function excluirTrilha(trilha: Record<string, any>) {
      if (!window.confirm(`Excluir a trilha “${trilha.nome}”?`)) return;

      try {
        const resposta = await fetch(`${API}/api/trilhas/${trilha.id}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        if (!resposta.ok) throw new Error('excluir');
        trilhas = trilhas.filter((item) => item.id !== trilha.id);
        localStorage.setItem('fisga:trilhas:v1', JSON.stringify(trilhas));
        renderizarTrilhas();
        mostrarToast('Trilha excluída.');
      } catch {
        mostrarToast('Não foi possível excluir a trilha.');
      }
    }

    function renderizar() {
      camadaPontos.clearLayers();
      if (lista) lista.innerHTML = '';
      if (contagem) contagem.textContent = String(pontos.length);

      if (pontos.length === 0) {
        const vazio = document.createElement('p');
        vazio.className = 'mapa-vazio';
        vazio.textContent = autenticado
          ? 'Nenhum ponto ainda. Clique no mapa para começar.'
          : 'Entre para salvar pontos privados. O mapa continua disponível para explorar.';
        lista?.appendChild(vazio);
        atualizarExportacao();
        return;
      }

      for (const ponto of pontos) {
        const marcador = L.marker([Number(ponto.latitude), Number(ponto.longitude)], {
          icon: icone(String(ponto.tipo))
        })
          .addTo(camadaPontos)
          .bindPopup(conteudoPopup(ponto));

        marcador.on('click', () => {
          mapa.flyTo([Number(ponto.latitude), Number(ponto.longitude)], Math.max(mapa.getZoom(), 11), {
            duration: 0.5
          });
        });

        lista?.appendChild(criarCartao(ponto));
      }

      atualizarExportacao();
    }

    async function carregarPontos() {
      if (!autenticado) {
        pontos = [];
        renderizar();
        return;
      }

      try {
        const resposta = await fetch(`${API}/api/pontos`, { credentials: 'include' });
        if (resposta.status === 401) {
          autenticado = false;
          localStorage.removeItem('fisga:pontos:v1');
          localStorage.removeItem('fisga:trilhas:v1');
          atualizarSessao();
          return;
        }

        if (!resposta.ok) throw new Error('api');
        pontos = await resposta.json();
        localStorage.setItem('fisga:pontos:v1', JSON.stringify(pontos));
        esconderAviso();
        renderizar();
      } catch {
        const cache = localStorage.getItem('fisga:pontos:v1');
        if (cache) {
          pontos = JSON.parse(cache);
          renderizar();
          mostrarAviso('Sem conexão. Mostrando os pontos salvos neste aparelho; edições precisam de sinal.');
        } else {
          mostrarAviso('Não foi possível carregar seus pontos. Tente de novo.');
        }
      }
    }

    function atualizarSessao() {
      botaoEntrar?.classList.toggle('oculto', autenticado);
      if (!autenticado) {
        botaoExportar?.classList.add('oculto');
        dialogo?.close();
        dialogoTrilha?.close();
        cancelarDesenho();
      }
    }

    function abrirDialogo(ponto: Record<string, any> | null, coordenadas?: L.LatLng) {
      if (!autenticado) {
        mostrarToast('Entre para salvar pontos privados.');
        return;
      }

      if (!dialogo || !form) return;

      editandoId = ponto?.id ?? null;
      const titulo = document.getElementById('titulo-dialogo-ponto');
      if (titulo) titulo.textContent = ponto ? 'Editar ponto' : 'Novo ponto';

      (document.getElementById('ponto-id') as HTMLInputElement).value = ponto?.id ?? '';
      (document.getElementById('ponto-nome') as HTMLInputElement).value = ponto?.nome ?? '';
      (document.getElementById('ponto-tipo') as HTMLSelectElement).value = ponto?.tipo ?? 'Ponto';
      (document.getElementById('ponto-descricao') as HTMLTextAreaElement).value = ponto?.descricao ?? '';
      (document.getElementById('ponto-lat') as HTMLInputElement).value = String(
        ponto?.latitude ?? coordenadas?.lat ?? mapa.getCenter().lat
      );
      (document.getElementById('ponto-lon') as HTMLInputElement).value = String(
        ponto?.longitude ?? coordenadas?.lng ?? mapa.getCenter().lng
      );

      erro?.classList.add('oculto');
      dialogo.showModal();
    }

    async function excluirPonto(ponto: Record<string, any>) {
      if (!window.confirm(`Excluir “${ponto.nome}”? As notas e a coordenada serão removidas.`)) {
        return;
      }

      try {
        const resposta = await fetch(`${API}/api/pontos/${ponto.id}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        if (!resposta.ok) throw new Error('excluir');
        pontos = pontos.filter((item) => item.id !== ponto.id);
        localStorage.setItem('fisga:pontos:v1', JSON.stringify(pontos));
        renderizar();
        mostrarToast('Ponto excluído.');
      } catch {
        mostrarToast('Não foi possível excluir o ponto.');
      }
    }

    document.getElementById('adicionar-ponto')?.addEventListener('click', () => {
      if (!autenticado) {
        window.location.href = `/entrar?voltar=${encodeURIComponent('/mapa')}`;
        return;
      }
      abrirDialogo(null);
    });
    document.getElementById('usar-localizacao-mapa')?.addEventListener('click', () => {
      mapa.locate({ setView: true, maxZoom: 13 });
    });

    mapa.on('locationfound', (evento) => {
      L.circleMarker(evento.latlng, {
        radius: 8,
        color: '#174E57',
        fillColor: '#174E57',
        fillOpacity: 0.25,
        weight: 2
      })
        .addTo(mapa)
        .bindPopup('Sua localização aproximada.')
        .openPopup();
    });

    mapa.on('locationerror', () => {
      mostrarToast('Não conseguimos usar sua localização. Navegue até o ponto.');
    });

    mapa.on('click', (evento) => {
      if (desenhando) {
        adicionarPontoDesenho(evento.latlng);
        return;
      }

      if (!autenticado) {
        mostrarToast('Entre para salvar pontos privados. O mapa continua livre para explorar.');
        return;
      }
      abrirDialogo(null, evento.latlng);
    });

    document.getElementById('desenhar-trilha')?.addEventListener('click', iniciarDesenho);
    document.getElementById('exportar-gpx')?.addEventListener('click', exportarGpx);
    document.getElementById('desfazer-trilha')?.addEventListener('click', () => {
      pontosDesenho.pop();
      redesenharDesenho();
    });
    document.getElementById('cancelar-trilha')?.addEventListener('click', cancelarDesenho);
    document.getElementById('finalizar-trilha')?.addEventListener('click', () => {
      if (pontosDesenho.length < 2) {
        mostrarToast('Adicione pelo menos dois pontos para salvar a trilha.');
        return;
      }

      const nome = document.getElementById('trilha-nome') as HTMLInputElement | null;
      const resumo = document.getElementById('trilha-resumo');
      if (nome) nome.value = `Trilha ${new Date().toLocaleDateString('pt-BR')}`;
      if (resumo) {
        resumo.textContent = `${pontosDesenho.length} pontos · ${distanciaDesenho().toFixed(2).replace('.', ',')} km`;
      }
      erroTrilha?.classList.add('oculto');
      dialogoTrilha?.showModal();
    });

    document.getElementById('fechar-trilha')?.addEventListener('click', () => dialogoTrilha?.close());
    document.getElementById('cancelar-trilha-dialogo')?.addEventListener('click', () => dialogoTrilha?.close());

    formTrilha?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!autenticado) return;

      const textoOriginal = botaoSalvarTrilha?.textContent ?? 'Salvar trilha';
      if (botaoSalvarTrilha) {
        botaoSalvarTrilha.disabled = true;
        botaoSalvarTrilha.textContent = 'Salvando...';
      }
      erroTrilha?.classList.add('oculto');

      const corpo = {
        nome: (document.getElementById('trilha-nome') as HTMLInputElement).value.trim(),
        descricao: (document.getElementById('trilha-descricao') as HTMLTextAreaElement).value.trim() || null,
        tipo: (document.getElementById('trilha-tipo') as HTMLSelectElement).value,
        pontos: pontosDesenho.map((ponto) => ({
          latitude: ponto.lat,
          longitude: ponto.lng
        }))
      };

      try {
        const resposta = await fetch(`${API}/api/trilhas`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(corpo)
        });

        if (resposta.status === 401) {
          window.location.href = `/entrar?voltar=${encodeURIComponent('/mapa')}`;
          return;
        }

        const dados = await resposta.json().catch(() => ({}));
        if (!resposta.ok) throw new Error(dados.detalhe || 'Não foi possível salvar a trilha.');

        dialogoTrilha?.close();
        cancelarDesenho();
        mostrarToast('Trilha salva.');
        await carregarTrilhas();
      } catch (falha) {
        if (erroTrilha) {
          erroTrilha.textContent = falha instanceof Error ? falha.message : 'Não foi possível salvar a trilha.';
          erroTrilha.classList.remove('oculto');
        }
      } finally {
        if (botaoSalvarTrilha) {
          botaoSalvarTrilha.disabled = false;
          botaoSalvarTrilha.textContent = textoOriginal;
        }
      }
    });

    document.getElementById('fechar-ponto')?.addEventListener('click', () => dialogo?.close());
    document.getElementById('cancelar-ponto')?.addEventListener('click', () => dialogo?.close());

    form?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!autenticado) return;

      const textoOriginal = botaoSalvar?.textContent ?? 'Salvar ponto';
      if (botaoSalvar) {
        botaoSalvar.disabled = true;
        botaoSalvar.textContent = 'Salvando...';
      }
      erro?.classList.add('oculto');

      const corpo = {
        nome: (document.getElementById('ponto-nome') as HTMLInputElement).value.trim(),
        tipo: (document.getElementById('ponto-tipo') as HTMLSelectElement).value,
        descricao: (document.getElementById('ponto-descricao') as HTMLTextAreaElement).value.trim() || null,
        latitude: Number((document.getElementById('ponto-lat') as HTMLInputElement).value),
        longitude: Number((document.getElementById('ponto-lon') as HTMLInputElement).value)
      };

      try {
        const resposta = await fetch(
          editandoId ? `${API}/api/pontos/${editandoId}` : `${API}/api/pontos`,
          {
            method: editandoId ? 'PUT' : 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(corpo)
          }
        );

        if (resposta.status === 401) {
          window.location.href = `/entrar?voltar=${encodeURIComponent('/mapa')}`;
          return;
        }

        const dados = await resposta.json().catch(() => ({}));
        if (!resposta.ok) throw new Error(dados.detalhe || 'Não foi possível salvar o ponto.');

        dialogo?.close();
        mostrarToast(editandoId ? 'Ponto atualizado.' : 'Ponto salvo.');
        await carregarPontos();
      } catch (falha) {
        if (erro) {
          erro.textContent = falha instanceof Error ? falha.message : 'Não foi possível salvar o ponto.';
          erro.classList.remove('oculto');
        }
      } finally {
        if (botaoSalvar) {
          botaoSalvar.disabled = false;
          botaoSalvar.textContent = textoOriginal;
        }
      }
    });

    (async function iniciar() {
      let checagemOk = false;
      try {
        const resposta = await fetch(`${API}/api/auth/me`, { credentials: 'include' });
        const dados = await resposta.json().catch(() => ({}));
        autenticado = Boolean(dados.autenticado);
        checagemOk = true;
      } catch {
        autenticado = false;
      }

      if (checagemOk) {
        if (autenticado) {
          localStorage.setItem('fisga:sessao:v1', '1');
        } else {
          localStorage.removeItem('fisga:sessao:v1');
          localStorage.removeItem('fisga:pontos:v1');
          localStorage.removeItem('fisga:trilhas:v1');
        }
      } else if (localStorage.getItem('fisga:sessao:v1') === '1') {
        autenticado = true;
        mostrarAviso('Sem conexão. Abrindo seus pontos salvos neste aparelho.');
      }

      atualizarSessao();
      await carregarPontos();
      await carregarTrilhas();

      const cacheMapa = localStorage.getItem('fisga:mapa:v1');
      if (cacheMapa) {
        try {
          const { lat, lng, zoom } = JSON.parse(cacheMapa);
          mapa.setView([lat, lng], zoom);
        } catch {
          // Mantém a visão do Brasil.
        }
      }

      mapa.on('moveend', () => {
        const centro = mapa.getCenter();
        localStorage.setItem(
          'fisga:mapa:v1',
          JSON.stringify({ lat: centro.lat, lng: centro.lng, zoom: mapa.getZoom() })
        );
      });
    })();
  </script>

