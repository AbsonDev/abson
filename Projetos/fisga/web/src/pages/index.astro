---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { apiBase } from '../lib/api';

const cookie = Astro.request.headers.get('cookie') ?? '';

if (cookie) {
  try {
    const resposta = await fetch(`${apiBase}/api/auth/me`, { headers: { cookie } });
    if (resposta.ok) {
      const sessao = await resposta.json();
      if (sessao?.autenticado) {
        return Astro.redirect('/hoje');
      }
    }
  } catch {
    // Sem sessão: segue para a home pública.
  }
}
---

<Layout
  titulo="Fisga — vale a pena sair hoje?"
  descricao="Maré, vento, chuva e a janela de pesca do seu ponto. Um diário que guarda o que funcionou. Grátis e privado."
  bodyClass="pagina-home"
>
  <section class="capa">
    <div class="container capa-grade">
      <div class="capa-texto">
        <span class="eyebrow">Diário de pesca · Brasil</span>
        <h1>Vale a pena <em>sair hoje?</em></h1>
        <p class="capa-lead">
          Maré, vento e luz do seu ponto — com a janela que costuma render. E um diário que guarda o
          que funcionou.
        </p>

        <form id="busca-capa" class="capa-busca" role="search">
          <label class="oculto" for="capa-local">Cidade, praia ou ponto</label>
          <div class="capa-campo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4 4" />
            </svg>
            <input id="capa-local" type="search" placeholder="Cidade, praia ou ponto" autocomplete="off" />
            <button type="submit" class="btn btn--primario">Ver condições</button>
            <div id="capa-resultados" class="capa-resultados oculto" role="listbox"></div>
          </div>
        </form>

        <div class="capa-links">
          <button id="capa-localizacao" type="button">Usar minha localização</button>
          <a href="/condicoes?lat=-10.911&lon=-37.071&nome=Aracaju&cidade=Aracaju&estado=SE&ambiente=Mar">Ex.: Aracaju, SE</a>
          <a href="/registrar">Já pescou hoje? Registrar pescaria</a>
        </div>
        <p id="capa-status" class="capa-status" role="status" aria-live="polite"></p>
      </div>

      <aside class="capa-exemplo" aria-label="Exemplo de janela de pesca">
        <span class="eyebrow">Exemplo · hoje, 17 de novembro</span>
        <p class="capa-exemplo-horario">16:47–18:47</p>
        <p class="capa-exemplo-meta">Aracaju, SE · 4 de 5 · maré descendo</p>
        <p class="capa-exemplo-texto">
          Uma janela curta no fim da tarde, com vento fraco de leste e luz baixa.
        </p>
      </aside>
    </div>
  </section>

  <section class="container capa-trabalhos" aria-label="O que o Fisga faz">
    <a class="capa-trabalho" href="/condicoes">
      <span class="capa-numero">01</span>
      <h2>Antes</h2>
      <p>Maré, vento, chuva, lua e a janela do dia.</p>
      <span class="capa-seta">Ver condições →</span>
    </a>
    <a class="capa-trabalho" href="/mapa">
      <span class="capa-numero">02</span>
      <h2>Durante</h2>
      <p>Seus locais, pontos e trilhas, privados por padrão.</p>
      <span class="capa-seta">Abrir mapa →</span>
    </a>
    <a class="capa-trabalho" href="/meu-diario">
      <span class="capa-numero">03</span>
      <h2>Depois</h2>
      <p>Diário, fotos, padrões e o troféu do dia.</p>
      <span class="capa-seta">Ver diário →</span>
    </a>
  </section>

  <section class="container capa-prova" aria-label="Por que usar o Fisga">
    <div><strong>Grátis</strong><span>Durante a validação, sem cartão.</span></div>
    <div><strong>Privado</strong><span>Seu diário e seus pontos só você vê.</span></div>
    <div><strong>Offline</strong><span>Wiki e ferramentas ficam no aparelho.</span></div>
  </section>

  <section class="container capa-aprender">
    <div>
      <span class="eyebrow">Aprender</span>
      <h2>O que saber antes de arremessar.</h2>
    </div>
    <div class="capa-aprender-links">
      <a href="/aprender">Ferramentas de campo <span>nós, checklists e defeso →</span></a>
      <a href="/wiki">Wiki do Pescador <span>espécies, técnicas e iscas →</span></a>
    </div>
  </section>

  <script>
    const API = (document.body.dataset.api ?? 'http://localhost:5184').replace(/\/$/, '');
    const form = document.getElementById('busca-capa') as HTMLFormElement | null;
    const input = document.getElementById('capa-local') as HTMLInputElement | null;
    const resultados = document.getElementById('capa-resultados') as HTMLDivElement | null;
    const status = document.getElementById('capa-status');
    const localizacao = document.getElementById('capa-localizacao') as HTMLButtonElement | null;
    let timer = 0;

    function aviso(texto: string) {
      if (status) status.textContent = texto;
    }

    function irPara(local: { latitude: number; longitude: number; nome?: string; cidade?: string | null; estado?: string | null; ambiente?: string }) {
      const params = new URLSearchParams({
        lat: String(local.latitude),
        lon: String(local.longitude),
        nome: local.nome ?? local.cidade ?? 'Local',
        cidade: local.cidade ?? '',
        estado: local.estado ?? '',
        ambiente: local.ambiente ?? 'Outro'
      });
      window.location.href = `/condicoes?${params.toString()}`;
    }

    async function buscar(termo: string) {
      if (!resultados) return;
      if (termo.trim().length < 2) {
        resultados.classList.add('oculto');
        return;
      }

      try {
        const resposta = await fetch(`${API}/api/locais/buscar?q=${encodeURIComponent(termo.trim())}`);
        const lista = await resposta.json();
        resultados.innerHTML = '';

        if (!Array.isArray(lista) || lista.length === 0) {
          resultados.innerHTML = '<p class="capa-resultado-vazio">Nenhum lugar encontrado. Tente outro nome.</p>';
          resultados.classList.remove('oculto');
          return;
        }

        for (const item of lista) {
          const botao = document.createElement('button');
          botao.type = 'button';
          botao.className = 'capa-resultado';
          botao.innerHTML = `<strong></strong><span></span>`;
          botao.querySelector('strong')!.textContent = item.nome;
          botao.querySelector('span')!.textContent = [item.estado, item.pais].filter(Boolean).join(' · ');
          botao.addEventListener('click', () => irPara(item));
          resultados.appendChild(botao);
        }
        resultados.classList.remove('oculto');
      } catch {
        aviso('Não foi possível buscar agora.');
      }
    }

    input?.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => buscar(input.value), 320);
    });

    form?.addEventListener('submit', (evento) => {
      evento.preventDefault();
      if (!input?.value.trim()) {
        input?.focus();
        aviso('Digite uma cidade, praia ou ponto.');
        return;
      }
      buscar(input.value);
    });

    localizacao?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        aviso('Seu navegador não oferece localização.');
        return;
      }
      localizacao.disabled = true;
      localizacao.textContent = 'Localizando...';
      navigator.geolocation.getCurrentPosition(
        (posicao) => irPara({
          latitude: Number(posicao.coords.latitude.toFixed(5)),
          longitude: Number(posicao.coords.longitude.toFixed(5)),
          nome: 'Minha localização',
          ambiente: 'Outro'
        }),
        () => {
          localizacao.disabled = false;
          localizacao.textContent = 'Usar minha localização';
          aviso('Não conseguimos usar sua localização. Busque pelo nome.');
        },
        { enableHighAccuracy: false, timeout: 12000, maximumAge: 300000 }
      );
    });
  </script>

  <style>
    .capa {
      padding: clamp(48px, 8vw, 96px) 0 34px;
    }

    .capa-grade {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: clamp(32px, 6vw, 72px);
      align-items: center;
    }

    .capa h1 {
      max-width: 740px;
      margin-top: 6px;
      font-size: clamp(3rem, 7vw, 5.6rem);
    }

    .capa-lead {
      max-width: 560px;
      margin-top: 18px;
      color: var(--tinta-suave);
      font-size: 1.02rem;
      line-height: 1.65;
    }

    .capa-busca {
      max-width: 620px;
      margin-top: 26px;
    }

    .capa-campo {
      position: relative;
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      padding: 6px 6px 6px 12px;
      border: 1px solid var(--linha-forte);
      border-radius: 12px;
      background: var(--superficie);
    }

    .capa-campo > svg {
      width: 18px;
      height: 18px;
      color: var(--tinta-suave);
    }

    .capa-campo input {
      min-width: 0;
      height: 42px;
      border: 0;
      background: transparent;
      color: var(--tinta);
      font: inherit;
      outline: 0;
    }

    .capa-campo .btn {
      min-height: 42px;
    }

    .capa-resultados {
      position: absolute;
      z-index: 20;
      top: calc(100% + 5px);
      right: 0;
      left: 0;
      overflow: hidden;
      border: 1px solid var(--linha);
      border-radius: 10px;
      background: var(--superficie);
      box-shadow: var(--sombra-suave);
    }

    .capa-resultado {
      display: flex;
      width: 100%;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 13px;
      border: 0;
      border-bottom: 1px solid var(--linha);
      background: transparent;
      color: var(--tinta);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .capa-resultado:hover {
      background: var(--creme);
    }

    .capa-resultado strong {
      font-weight: 600;
    }

    .capa-resultado span {
      color: var(--tinta-suave);
      font-size: 0.68rem;
    }

    .capa-resultado-vazio {
      padding: 12px;
      color: var(--tinta-suave);
      font-size: 0.76rem;
    }

    .capa-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      margin-top: 12px;
      color: var(--tinta-suave);
      font-size: 0.72rem;
    }

    .capa-links button {
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--terracota);
      font: inherit;
      font-weight: 600;
      text-decoration: underline;
      cursor: pointer;
    }

    .capa-links a {
      color: var(--terracota);
      text-decoration: underline;
    }

    .capa-status {
      min-height: 1.1rem;
      margin-top: 8px;
      color: var(--tinta-suave);
      font-size: 0.7rem;
    }

    .capa-exemplo {
      padding: 22px;
      border-left: 2px solid var(--terracota);
      background: var(--creme);
    }

    .capa-exemplo-horario {
      margin-top: 12px;
      font-family: var(--fonte-titulo);
      font-size: clamp(2rem, 4.4vw, 3.1rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .capa-exemplo-meta {
      margin-top: 6px;
      color: var(--tinta-suave);
      font-size: 0.72rem;
    }

    .capa-exemplo-texto {
      margin-top: 12px;
      color: var(--tinta-suave);
      font-size: 0.82rem;
      line-height: 1.55;
    }

    .capa-trabalhos {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--linha);
      border-bottom: 1px solid var(--linha);
    }

    .capa-trabalho {
      display: grid;
      gap: 3px;
      padding: 22px 22px 22px 0;
      border-right: 1px solid var(--linha);
      color: var(--tinta);
      text-decoration: none;
    }

    .capa-trabalho:not(:first-child) {
      padding-left: 22px;
    }

    .capa-trabalho:last-child {
      border-right: 0;
    }

    .capa-numero {
      color: var(--acafrao);
      font-family: var(--fonte-titulo);
      font-size: 1.4rem;
    }

    .capa-trabalho h2 {
      font-size: 1.45rem;
    }

    .capa-trabalho p {
      color: var(--tinta-suave);
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .capa-seta {
      margin-top: 8px;
      color: var(--terracota);
      font-size: 0.68rem;
      font-weight: 600;
    }

    .capa-prova {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .capa-prova div {
      display: grid;
      gap: 2px;
      padding-right: 18px;
      border-right: 1px solid var(--linha);
    }

    .capa-prova div:last-child {
      border-right: 0;
    }

    .capa-prova strong {
      font-family: var(--fonte-titulo);
      font-size: 1.05rem;
      font-weight: 600;
    }

    .capa-prova span {
      color: var(--tinta-suave);
      font-size: 0.7rem;
    }

    .capa-aprender {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      padding-top: 20px;
      padding-bottom: 80px;
    }

    .capa-aprender h2 {
      margin-top: 6px;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
    }

    .capa-aprender-links {
      display: grid;
      gap: 4px;
      min-width: 280px;
    }

    .capa-aprender-links a {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding: 10px 0;
      border-bottom: 1px solid var(--linha);
      color: var(--tinta);
      font-size: 0.82rem;
      text-decoration: none;
    }

    .capa-aprender-links span {
      color: var(--tinta-suave);
      font-size: 0.68rem;
    }

    @media (max-width: 900px) {
      .capa-grade {
        grid-template-columns: 1fr;
      }

      .capa-exemplo {
        max-width: 520px;
      }

      .capa-trabalhos {
        grid-template-columns: 1fr;
      }

      .capa-trabalho,
      .capa-trabalho:not(:first-child) {
        padding: 16px 0;
        border-right: 0;
        border-bottom: 1px solid var(--linha);
      }

      .capa-trabalho:last-child {
        border-bottom: 0;
      }

      .capa-prova {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .capa-prova div {
        padding: 8px 0;
        border-right: 0;
        border-bottom: 1px solid var(--linha);
      }

      .capa-prova div:last-child {
        border-bottom: 0;
      }

      .capa-aprender {
        align-items: start;
        flex-direction: column;
        padding-bottom: 84px;
      }

      .capa-aprender-links {
        width: 100%;
        min-width: 0;
      }
    }

    @media (max-width: 640px) {
      .capa {
        padding-top: 38px;
      }

      .capa h1 {
        font-size: clamp(2.8rem, 13vw, 4rem);
      }

      .capa-campo {
        grid-template-columns: 20px minmax(0, 1fr);
      }

      .capa-campo .btn {
        grid-column: 1 / -1;
        width: 100%;
      }

      .capa-links {
        display: grid;
        gap: 7px;
      }
    }
  </style>
</Layout>
