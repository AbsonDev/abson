---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
  titulo="Conta"
  descricao="Seu e-mail, sua senha, o Google e os dispositivos conectados à conta do Fisga."
>
  <section class="screen">
    <div class="screen-inner screen-inner--wide">
      <div id="conta-loading" role="status" aria-live="polite">
        <header class="screen-head">
          <p class="eyebrow">Conta</p>
          <h1 tabindex="-1">Carregando sua conta…</h1>
          <p class="sub">Um instante para reunir seu acesso e seus dispositivos.</p>
        </header>
        <div class="progress" role="progressbar" aria-label="Carregando sua conta"><span></span></div>
      </div>

      <div id="conta-load-error" role="alert" hidden>
        <header class="screen-head">
          <p class="eyebrow">Conta</p>
          <h1 id="conta-load-error-titulo" tabindex="-1">Não carregamos sua conta.</h1>
          <p class="sub" id="conta-load-error-texto">
            Confira sua conexão e tente de novo. Se continuar, entre novamente.
          </p>
        </header>
        <button type="button" class="btn btn-primary" id="conta-retry">Tentar de novo</button>
      </div>

      <div id="conta-content" hidden>
        <header class="screen-head">
          <p class="eyebrow">Conta</p>
          <h1 tabindex="-1">Sua história, <em>bem guardada.</em></h1>
          <p class="sub">Seu e-mail, seu acesso e os dispositivos conectados ao diário.</p>
        </header>

        <div class="note" id="conta-aviso" role="status" hidden>
          <svg class="od-icon od-icon--md" data-aviso-icon="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>
          <svg class="od-icon od-icon--md" data-aviso-icon="erro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
          <span id="conta-aviso-texto"></span>
        </div>

        <section class="acct-section" aria-labelledby="sec-acesso">
          <div class="acct-head">
            <h2 id="sec-acesso">E-mail e senha</h2>
            <p>O essencial para voltar ao diário com segurança.</p>
          </div>

          <div class="acct-list">
            <div class="acct-row">
              <div class="row-main">
                <p class="row-title">E-mail</p>
                <p class="row-value">
                  <span id="conta-email">—</span>
                  <span class="badge">
                    <svg class="od-icon od-icon--xs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4 4L19 7"></path></svg>
                    Confirmado
                  </span>
                </p>
                <p class="row-note">Quem controla este e-mail consegue entrar na conta. Mantenha a caixa de entrada protegida.</p>
              </div>
            </div>

            <div class="acct-row">
              <div class="row-main">
                <p class="row-title">Senha</p>
                <p class="row-value" id="conta-senha-valor">—</p>
                <p class="row-note">De 10 a 128 caracteres. Não exigimos maiúscula, número ou símbolo.</p>
              </div>
              <div class="row-action">
                <button type="button" class="btn btn-ghost" id="conta-senha-acao">Criar senha</button>
              </div>
            </div>
          </div>

          <p class="note note--success conta-feedback" id="senha-feedback" role="status" hidden>
            <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>
            <span id="senha-feedback-texto"></span>
          </p>
        </section>

        <section class="acct-section" aria-labelledby="sec-google">
          <div class="acct-head">
            <h2 id="sec-google">Google</h2>
            <p>Entre com um toque quando estiver fora de casa.</p>
          </div>

          <div class="acct-row">
            <div class="row-main">
              <p class="row-title">Google</p>
              <p class="row-value" id="google-status">Verificando…</p>
              <p class="row-note" id="google-note">Conferindo a conexão com sua conta Google.</p>
              <p class="row-note" id="google-indisponivel" hidden>
                A conexão com Google não está disponível agora. Use seu e-mail e senha.
              </p>
            </div>
            <div class="row-action">
              <button type="button" class="btn btn-ghost" id="google-acao" hidden>
                <span class="spinner" hidden></span>
                <span data-btn-label>Conectar Google</span>
              </button>
            </div>
          </div>
        </section>

        <section class="acct-section" aria-labelledby="sec-dados">
          <div class="acct-head">
            <h2 id="sec-dados">Seus dados</h2>
            <p>Corrija seu nome, escolha receber novidades e baixe uma cópia do que guardamos.</p>
          </div>

          <form id="form-dados" class="dados-form" novalidate>
            <div class="acct-row">
              <div class="row-main">
                <div class="field">
                  <label class="label" for="dados-nome">Nome</label>
                  <input
                    class="input"
                    id="dados-nome"
                    name="name"
                    type="text"
                    autocomplete="name"
                    maxlength="80"
                    aria-describedby="dados-nome-error"
                  />
                  <p class="field-error" id="dados-nome-error" role="alert" hidden>
                    <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
                    <span data-err-text></span>
                  </p>
                </div>
                <p class="row-note">É o nome que aparece no seu diário. Deixe em branco para usar o e-mail.</p>
              </div>
            </div>

            <div class="acct-row">
              <div class="row-main">
                <p class="row-title">Preferência de e-mail</p>
                <div class="consent">
                  <input type="checkbox" id="dados-novidades" />
                  <div class="consent-body">
                    <label class="consent-label" for="dados-novidades">
                      Quero receber novidades e conteúdo do Fisga por e-mail.
                    </label>
                    <p class="row-note">Você pode desmarcar quando quiser. Avisos essenciais da conta continuam.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="dados-actions">
              <button type="submit" class="btn btn-primary" id="dados-salvar">
                <span class="spinner" hidden></span>
                <span data-btn-label>Salvar alterações</span>
              </button>
              <button type="button" class="btn btn-ghost" id="dados-exportar">
                <span class="spinner" hidden></span>
                <span data-btn-label>Baixar meus dados (JSON)</span>
              </button>
            </div>

            <p class="note note--success conta-feedback" id="dados-feedback" role="status" hidden>
              <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>
              <span id="dados-feedback-texto"></span>
            </p>

            <p class="note note--error" id="dados-erro" role="alert" hidden>
              <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
              <span id="dados-erro-texto"></span>
            </p>
          </form>
        </section>

        <section class="acct-section" aria-labelledby="sec-sessoes">
          <div class="acct-head">
            <h2 id="sec-sessoes" tabindex="-1">Sessões ativas</h2>
            <p>Dispositivos que entraram na sua conta. Encerre o que não reconhecer.</p>
          </div>

          <div id="sessoes-loading" class="sessions-loading" role="status" aria-label="Carregando sessões">
            <div class="skeleton-row" aria-hidden="true">
              <span class="skeleton skeleton--icon"></span>
              <span class="skeleton skeleton--line"></span>
            </div>
            <div class="skeleton-row" aria-hidden="true">
              <span class="skeleton skeleton--icon"></span>
              <span class="skeleton skeleton--meta"></span>
            </div>
            <div class="skeleton-row" aria-hidden="true">
              <span class="skeleton skeleton--icon"></span>
              <span class="skeleton skeleton--wide"></span>
            </div>
          </div>

          <div id="sessoes-erro" hidden>
            <p class="note note--error" id="sessoes-erro-texto" role="alert">
              Não foi possível carregar suas sessões. Tente novamente.
            </p>
            <button type="button" class="btn btn-ghost" id="sessoes-retry">Tentar de novo</button>
          </div>

          <div class="session-list" id="sessoes-lista"></div>

          <p class="empty" id="sessoes-vazio" hidden>
            <strong>Nenhuma outra sessão ativa.</strong>
            <span>Só este dispositivo está conectado à sua conta.</span>
          </p>

          <div class="acct-actions">
            <button type="button" class="btn btn-ghost" id="sair-atual">Sair desta sessão</button>
            <button type="button" class="btn btn-quiet" id="sair-todos">Sair de todos</button>
          </div>
        </section>

        <section class="acct-section" aria-labelledby="sec-perigo">
          <div class="acct-head">
            <h2 id="sec-perigo">Zona sensível</h2>
            <p>O que apaga uma história não pode ser desfeito.</p>
          </div>

          <div class="acct-row">
            <div class="row-main">
              <p class="row-title">Excluir conta</p>
              <p class="row-value">Apaga o diário, as pescarias e as fotos.</p>
              <p class="row-note">A exclusão é permanente e não pode ser desfeita depois de confirmada.</p>
            </div>
            <div class="row-action">
              <button type="button" class="btn btn-danger" id="excluir-conta">Excluir conta</button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="screen" id="conta-encerrada" hidden>
    <div class="screen-inner">
      <header class="screen-head">
        <p class="eyebrow">Conta</p>
        <h1 id="conta-encerrada-titulo" tabindex="-1">Conta excluída.</h1>
        <p class="sub">
          Seu perfil, suas pescarias e suas fotos foram removidos. Estamos te levando para a página
          inicial...
        </p>
      </header>
      <a class="btn btn-ghost" href="/">Voltar agora</a>
    </div>
  </section>

  <dialog id="dialog-senha" aria-labelledby="senha-titulo">
    <form id="form-senha" class="dialog-body" novalidate>
      <p class="eyebrow">Acesso</p>
      <h2 id="senha-titulo">Alterar senha</h2>
      <p class="dialog-copy" id="senha-dica">
        Use de 10 a 128 caracteres. Não exigimos maiúscula, número ou símbolo.
      </p>

      <div class="field" id="campo-senha-atual">
        <label class="label" for="senha-atual">Senha atual</label>
        <div class="control">
          <input
            class="input input--reveal"
            id="senha-atual"
            name="current-password"
            type="password"
            autocomplete="current-password"
            aria-describedby="senha-atual-error"
          />
          <button class="reveal" type="button" data-reveal="senha-atual" aria-pressed="false" aria-label="Mostrar senha">
            <svg class="od-icon od-icon--lg" data-icon="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-5.5 9.5-5.5S21.5 12 21.5 12s-3.5 5.5-9.5 5.5S2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
            <svg class="od-icon od-icon--lg" data-icon="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><path d="m4 4 16 16"></path><path d="M10.6 6.7A9.6 9.6 0 0 1 12 6.5c6 0 9.5 5.5 9.5 5.5a16 16 0 0 1-3.1 3.5"></path><path d="M6.4 8.4A16 16 0 0 0 2.5 12s3.5 5.5 9.5 5.5a9 9 0 0 0 3.2-.6"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
          </button>
        </div>
        <p class="field-error" id="senha-atual-error" role="alert" hidden>
          <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
          <span data-err-text></span>
        </p>
      </div>

      <div class="field">
        <label class="label" for="nova-senha">Nova senha</label>
        <div class="control">
          <input
            class="input input--reveal"
            id="nova-senha"
            name="new-password"
            type="password"
            autocomplete="new-password"
            minlength="10"
            maxlength="128"
            required
            aria-describedby="nova-senha-error"
          />
          <button class="reveal" type="button" data-reveal="nova-senha" aria-pressed="false" aria-label="Mostrar senha">
            <svg class="od-icon od-icon--lg" data-icon="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-5.5 9.5-5.5S21.5 12 21.5 12s-3.5 5.5-9.5 5.5S2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="2.6"></circle></svg>
            <svg class="od-icon od-icon--lg" data-icon="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><path d="m4 4 16 16"></path><path d="M10.6 6.7A9.6 9.6 0 0 1 12 6.5c6 0 9.5 5.5 9.5 5.5a16 16 0 0 1-3.1 3.5"></path><path d="M6.4 8.4A16 16 0 0 0 2.5 12s3.5 5.5 9.5 5.5a9 9 0 0 0 3.2-.6"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg>
          </button>
        </div>
        <p class="field-error" id="nova-senha-error" role="alert" hidden>
          <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
          <span data-err-text></span>
        </p>
      </div>

      <div class="field">
        <label class="label" for="confirmar-senha">Confirmar nova senha</label>
        <div class="control">
          <input
            class="input"
            id="confirmar-senha"
            name="confirm-password"
            type="password"
            autocomplete="new-password"
            required
            aria-describedby="confirmar-senha-error"
          />
        </div>
        <p class="field-error" id="confirmar-senha-error" role="alert" hidden>
          <svg class="od-icon od-icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
          <span data-err-text></span>
        </p>
      </div>

      <p class="note note--error" id="senha-erro" role="alert" hidden>
        <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
        <span id="senha-erro-texto"></span>
      </p>

      <div class="dialog-actions">
        <button type="button" class="btn btn-ghost" data-fechar-senha>Cancelar</button>
        <button type="submit" class="btn btn-primary" id="senha-salvar">
          <span class="spinner" hidden></span>
          <span data-btn-label>Salvar senha</span>
        </button>
      </div>
    </form>
  </dialog>

  <dialog id="dialog-sair" aria-labelledby="sair-titulo">
    <div class="dialog-body">
      <p class="eyebrow">Sessões</p>
      <h2 id="sair-titulo">Sair desta sessão?</h2>
      <p class="dialog-copy" id="sair-copia">
        Você vai encerrar a sessão deste dispositivo. Para voltar, será preciso entrar novamente.
      </p>
      <p class="note note--error" id="sair-erro" role="alert" hidden>
        <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
        <span id="sair-erro-texto"></span>
      </p>
      <div class="dialog-actions">
        <button type="button" class="btn btn-ghost" data-fechar-sair>Cancelar</button>
        <button type="button" class="btn btn-primary" id="sair-confirmar">
          <span class="spinner" hidden></span>
          <span data-btn-label>Sair</span>
        </button>
      </div>
    </div>
  </dialog>

  <dialog id="dialog-excluir" aria-labelledby="excluir-titulo">
    <div class="dialog-body">
      <p class="eyebrow">Zona sensível</p>
      <h2 id="excluir-titulo">Excluir sua conta?</h2>
      <p class="dialog-copy">
        Isto apaga o diário, as pescarias e as fotos. A exclusão não pode ser desfeita depois de
        confirmada.
      </p>
      <p class="dialog-note">Se mudar de ideia, cancele. Nada é apagado até você confirmar.</p>

      <div class="field">
        <label class="label" for="excluir-confirmacao">
          Digite <strong>EXCLUIR</strong> para liberar o botão
        </label>
        <input
          class="input"
          id="excluir-confirmacao"
          type="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
        />
        <p class="help">Precisa ser exatamente EXCLUIR, em maiúsculas.</p>
      </div>

      <p class="note note--error" id="excluir-erro" role="alert" hidden>
        <svg class="od-icon od-icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5"></path><path d="M12 16h.01"></path></svg>
        <span id="excluir-erro-texto"></span>
      </p>

      <div class="dialog-actions">
        <button type="button" class="btn btn-ghost" data-fechar-excluir>Cancelar</button>
        <button type="button" class="btn btn-danger-solid" id="excluir-confirmar" disabled>
          <span class="spinner" hidden></span>
          <span data-btn-label>Excluir definitivamente</span>
        </button>
      </div>
    </div>
  </dialog>
</AuthLayout>

<style>
  #conta-aviso {
    margin-bottom: var(--s5);
  }

  .conta-feedback {
    margin-top: var(--s4);
  }

  .dados-form {
    display: grid;
    gap: var(--s3);
  }

  .dados-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  #dados-nome {
    max-width: 34rem;
  }

  #dados-feedback,
  #dados-erro {
    margin-top: 0;
  }

  #google-indisponivel {
    margin-top: var(--s1);
  }

  #sessoes-erro .btn {
    margin-top: var(--s2);
  }

  #senha-erro,
  #sair-erro,
  #excluir-erro {
    margin-top: 0;
  }
</style>

<script>
  import { apiBase } from '../lib/auth';

  const API = apiBase();
  const URL_ENTRAR = '/entrar?voltar=/conta';
  const MENSAGEM_REDE =
    'Não foi possível falar com o servidor. Confira sua conexão e tente novamente.';

  type TipoAviso = 'ok' | 'erro';
  type ModoSenha = 'criar' | 'alterar';
  type ModoSair = 'atual' | 'todos';

  interface UsuarioConta {
    email: string;
    nome?: string | null;
    nomeExibicao?: string;
    aceitaNovidades?: boolean;
  }

  interface MeConta {
    autenticado: boolean;
    usuario: UsuarioConta | null;
    consentimentoPendente: boolean;
    googleConectado: boolean;
    temSenha?: boolean;
  }

  interface SessaoConta {
    id: string;
    userAgent: string | null;
    criadoEm: string;
    ultimoUsoEm: string;
    expiraEm: string;
    atual: boolean;
  }

  class FalhaApi extends Error {
    status: number;
    codigo: string;

    constructor(mensagem: string, status = 0, codigo = '') {
      super(mensagem);
      this.name = 'FalhaApi';
      this.status = status;
      this.codigo = codigo;
    }
  }

  const porId = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  const carregando = porId<HTMLElement>('conta-loading');
  const falhaCarregamento = porId<HTMLElement>('conta-load-error');
  const falhaCarregamentoTexto = porId<HTMLElement>('conta-load-error-texto');
  const recarregar = porId<HTMLButtonElement>('conta-retry');
  const conteudo = porId<HTMLElement>('conta-content');
  const aviso = porId<HTMLElement>('conta-aviso');
  const avisoTexto = porId<HTMLElement>('conta-aviso-texto');
  const email = porId<HTMLElement>('conta-email');
  const senhaValor = porId<HTMLElement>('conta-senha-valor');
  const senhaAcao = porId<HTMLButtonElement>('conta-senha-acao');
  const senhaFeedback = porId<HTMLElement>('senha-feedback');
  const senhaFeedbackTexto = porId<HTMLElement>('senha-feedback-texto');
  const googleStatus = porId<HTMLElement>('google-status');
  const googleNote = porId<HTMLElement>('google-note');
  const googleIndisponivel = porId<HTMLElement>('google-indisponivel');
