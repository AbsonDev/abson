    googleStatus.textContent = googleConectado ? 'Conectado' : 'Não conectado';
    googleNote.textContent = googleConectado
      ? 'Você pode entrar com um toque usando esta conta do Google.'
      : `Use o mesmo e-mail da sua conta: ${email?.textContent ?? 'seu e-mail'}.`;
