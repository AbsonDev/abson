  async function verificarGoogleDisponivel() {
    if (googleConectado || !googleAcao) return;

    try {
      const { dados } = await pedir<{ disponivel: boolean }>('/api/auth/google/disponivel');
      const disponivel = dados?.disponivel === true;
      googleAcao.hidden = !disponivel;
      if (googleIndisponivel) googleIndisponivel.hidden = disponivel;
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status === 401) return;
      googleAcao.hidden = true;
      if (googleIndisponivel) googleIndisponivel.hidden = false;
    }
