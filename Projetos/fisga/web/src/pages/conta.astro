  function mensagemDoStatus(status: number) {
    if (status === 400) return 'Confira os dados e tente novamente.';
    if (status === 403) return 'Esta ação não foi permitida. Entre novamente na conta.';
    if (status === 429) return 'Muitas tentativas em pouco tempo. Aguarde um minuto.';
    if (status >= 500) return 'Algo deu errado do nosso lado. Tente novamente em instantes.';
    return 'Não foi possível concluir a ação. Tente novamente.';
  }

  async function pedir<T>(
    caminho: string,
    opcoes: { metodo?: string; corpo?: unknown } = {}
  ): Promise<{ resposta: Response; dados: T | null }> {
    const init: RequestInit = {
      method: opcoes.metodo ?? 'GET',
      credentials: 'include',
      headers: { Accept: 'application/json' }
    };

    if (opcoes.corpo !== undefined) {
      init.headers = { ...init.headers, 'Content-Type': 'application/json' };
      init.body = JSON.stringify(opcoes.corpo);
    }

    let resposta: Response;
    try {
      resposta = await fetch(`${API}${caminho}`, init);
    } catch {
      throw new FalhaApi(MENSAGEM_REDE, 0);
    }

    if (resposta.status === 401) {
      irParaEntrar();
      throw new FalhaApi('Sua sessão expirou. Redirecionando para a entrada...', 401);
    }

    if (!resposta.ok) {
      let codigo = '';
      let detalhe = '';
      try {
        const dados = (await resposta.json()) as Record<string, unknown>;
        codigo = typeof dados?.codigo === 'string' ? dados.codigo : '';
        detalhe =
          typeof dados?.detalhe === 'string'
            ? dados.detalhe
            : typeof dados?.message === 'string'
              ? dados.message
              : '';
      } catch {
        detalhe = '';
      }

      throw new FalhaApi(detalhe || mensagemDoStatus(resposta.status), resposta.status, codigo);
    }

    if (resposta.status === 204) {
      return { resposta, dados: null };
    }

    const dados = (await resposta.json().catch(() => null)) as T | null;
    return { resposta, dados };
  }

  function setLoading(botao: HTMLButtonElement | null, ocupado: boolean, rotulo?: string) {
    if (!botao) return;
    const label = botao.querySelector('[data-btn-label]') as HTMLElement | null;
    const spinner = botao.querySelector('.spinner') as HTMLElement | null;
    if (label && !botao.dataset.idleLabel) botao.dataset.idleLabel = label.textContent ?? '';
    if (spinner) spinner.hidden = !ocupado;
    if (label) {
      label.textContent = ocupado
        ? rotulo ?? botao.dataset.idleLabel ?? ''
        : botao.dataset.idleLabel ?? '';
    }
    botao.disabled = ocupado;
    botao.setAttribute('aria-busy', ocupado ? 'true' : 'false');
  }

  function mostrarAviso(tipo: TipoAviso, texto: string) {
    if (!aviso || !avisoTexto) return;
    avisoTexto.textContent = texto;
    aviso.classList.toggle('note--success', tipo === 'ok');
    aviso.classList.toggle('note--error', tipo === 'erro');
    aviso.setAttribute('role', tipo === 'erro' ? 'alert' : 'status');
    aviso.querySelectorAll<HTMLElement>('[data-aviso-icon]').forEach((icone) => {
      icone.style.display = icone.dataset.avisoIcon === tipo ? '' : 'none';
    });
    aviso.hidden = false;
  }

  function erroCampo(id: string, mensagem: string) {
    const input = porId<HTMLInputElement>(id);
    const bloco = porId<HTMLElement>(`${id}-error`);
    if (input) {
      input.setAttribute('aria-invalid', 'true');
      input.focus();
    }
    if (bloco) {
      const texto = bloco.querySelector('[data-err-text]') as HTMLElement | null;
      if (texto) texto.textContent = mensagem;
      bloco.hidden = false;
    }
  }

  function limparErroCampo(id: string) {
    porId<HTMLInputElement>(id)?.removeAttribute('aria-invalid');
    const bloco = porId<HTMLElement>(`${id}-error`);
