</style>

<script>
  // @ts-nocheck
  const API = (document.body.dataset.api || 'http://localhost:5184').replace(/\/$/, '');
  const URL_ENTRAR = '/entrar?voltar=/conta';
  const MENSAGEM_REDE =
    'Não foi possível falar com o servidor. Confira sua conexão e tente novamente.';

  const porId = (id) => document.getElementById(id);

  const carregando = porId('carregando');
  const falhaCarregamento = porId('falha-carregamento');
  const falhaTexto = porId('falha-texto');
  const recarregar = porId('recarregar');
  const conteudo = porId('conta-conteudo');
  const avatar = porId('avatar-conta');
  const nomeConta = porId('nome-conta');
  const emailConta = porId('email-conta');
  const desdeConta = porId('desde-conta');
  const emailCaixa = porId('email-caixa');
  const formPerfil = porId('form-perfil');
  const nomePerfil = porId('nome-perfil');
  const nomeContador = porId('nome-contador');
  const aceitaNovidades = porId('aceita-novidades');
  const salvarPerfil = porId('salvar-perfil');
  const perfilFeedback = porId('perfil-feedback');
  const btnTrocarEmail = porId('btn-trocar-email');
  const trocarEmail = porId('trocar-email');
  const sairParaTrocar = porId('sair-para-trocar');
  const sessoesCarregando = porId('sessoes-carregando');
  const sessoesErro = porId('sessoes-erro');
  const sessoesErroTexto = porId('sessoes-erro-texto');
  const sessoesLista = porId('sessoes-lista');
  const recarregarSessoes = porId('recarregar-sessoes');
  const sairAtual = porId('sair-atual');
  const sairTodos = porId('sair-todos');
  const exportarDados = porId('exportar-dados');
  const exportarFeedback = porId('exportar-feedback');
  const excluirConta = porId('excluir-conta');
  const contaEncerrada = porId('conta-encerrada');
  const contaEncerradaTitulo = porId('conta-encerrada-titulo');
  const modal = porId('modal');
  const modalCaixa = modal.querySelector('.modal-caixa');
  const modalTitulo = porId('modal-titulo');
  const modalDescricao = porId('modal-descricao');
  const modalSimbolo = porId('modal-simbolo');
  const modalCampo = porId('modal-campo');
  const modalConfirmacao = porId('modal-confirmacao');
  const modalErro = porId('modal-erro');
  const modalConfirmar = porId('modal-confirmar');
  const modalCancelar = porId('modal-cancelar');
  const modalFechar = porId('modal-fechar');
  const toast = porId('toast');

  const fundoInerte = [
    document.querySelector('.pular-conteudo'),
    document.querySelector('.topo'),
    document.querySelector('.conta-topo'),
    document.querySelector('.conta-pagina'),
    document.querySelector('.rodape')
  ];

  const formatoDataHora = new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });

  const formatoData = new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  });

  let usuarioAtual = null;
  let redirecionando = false;
  let ultimoFoco = null;
  let acaoConfirmar = null;
  let textoExigido = null;
  let modalEmEnvio = false;
  let overflowAnterior = '';
  let timerToast = null;
  let versaoToast = 0;

  class FalhaApi extends Error {
    constructor(mensagem, status = 0) {
      super(mensagem);
      this.name = 'FalhaApi';
      this.status = status;
    }
  }

  function irParaEntrar() {
    if (redirecionando) return;
    redirecionando = true;
    window.location.replace(URL_ENTRAR);
  }

  function mensagemDoStatus(status) {
    if (status === 400) return 'Confira os dados e tente novamente.';
    if (status === 403) return 'Esta ação não foi permitida. Entre novamente na conta.';
    if (status === 404) return 'Não encontramos o que você procura.';
    if (status === 429) return 'Muitas tentativas em pouco tempo. Aguarde um minuto e tente de novo.';
    if (status >= 500) return 'Algo deu errado do nosso lado. Tente novamente em instantes.';
    return 'Não foi possível concluir a ação. Tente novamente.';
  }

  async function pedir(caminho, opcoes = {}) {
    const { metodo = 'GET', corpo, bruto = false } = opcoes;
    const init = {
      method: metodo,
      credentials: 'include',
      headers: { Accept: 'application/json' }
    };

    if (corpo !== undefined) {
      init.headers['Content-Type'] = 'application/json';
      init.body = JSON.stringify(corpo);
    }

    let resposta;

    try {
      resposta = await fetch(`${API}${caminho}`, init);
    } catch {
      throw new FalhaApi(MENSAGEM_REDE, 0);
    }

    if (resposta.status === 401) {
      irParaEntrar();
      throw new FalhaApi('Sua sessão expirou. Redirecionando para a entrada...', 401);
    }

    if (!resposta.ok) {
      let detalhe = '';
      try {
        const dados = await resposta.json();
        detalhe = dados?.detalhe || dados?.message || '';
      } catch {
        detalhe = '';
      }
      throw new FalhaApi(detalhe || mensagemDoStatus(resposta.status), resposta.status);
    }

    if (bruto || resposta.status === 204) {
      return { resposta, dados: null };
    }

    const dados = await resposta.json().catch(() => null);
    return { resposta, dados };
  }

  function formatarDataHora(iso) {
    if (!iso) return '';
    const data = new Date(iso);
    if (Number.isNaN(data.getTime())) return '';
    return formatoDataHora.format(data);
  }

  function formatarData(iso) {
    if (!iso) return '';
    const data = new Date(iso);
    if (Number.isNaN(data.getTime())) return '';
    return formatoData.format(data);
  }

  function iniciais(nome, email) {
    const partes = String(nome || email || '?')
      .trim()
      .split(/\s+/)
      .filter(Boolean);

    if (!partes.length) return '?';
    if (partes.length === 1) {
      return Array.from(partes[0]).slice(0, 2).join('').toUpperCase();
    }

    const primeira = Array.from(partes[0])[0] || '';
    const ultima = Array.from(partes[partes.length - 1])[0] || '';
    return `${primeira}${ultima}`.toUpperCase();
  }

  function definirFeedback(elemento, texto, tipo) {
    if (!elemento) return;
    elemento.textContent = texto;
    elemento.classList.remove('conta-feedback--ok', 'conta-feedback--erro');
    if (tipo === 'ok') elemento.classList.add('conta-feedback--ok');
    if (tipo === 'erro') elemento.classList.add('conta-feedback--erro');
  }

  function mostrarToast(mensagem, tipo = 'ok', duracao = 4200) {
    if (!toast) return;

    const versao = ++versaoToast;
    window.clearTimeout(timerToast);
    toast.hidden = false;
    toast.dataset.tipo = tipo;
    toast.textContent = mensagem;

    window.requestAnimationFrame(() => toast.classList.add('visivel'));

    timerToast = window.setTimeout(() => {
      if (versao !== versaoToast) return;
      toast.classList.remove('visivel');
      window.setTimeout(() => {
        if (versao === versaoToast) toast.hidden = true;
      }, 220);
    }, duracao);
  }

  function atualizarContador() {
    if (!nomeContador || !nomePerfil) return;
    nomeContador.textContent = `${nomePerfil.value.length}/80`;
  }

  function preencherIdentidade(usuario) {
    const nome = usuario.nomeExibicao || usuario.email || 'Pescador';

    avatar.textContent = iniciais(nome, usuario.email);
    nomeConta.textContent = nome;
    emailConta.textContent = usuario.email || '';
    emailCaixa.textContent = usuario.email || '—';
    nomePerfil.value = usuario.nome ?? '';
    nomePerfil.placeholder = usuario.nomeExibicao
      ? `Ex.: ${usuario.nomeExibicao}`
      : 'Como podemos te chamar?';
    aceitaNovidades.checked = Boolean(usuario.aceitaNovidades);
    atualizarContador();

    const desde = formatarData(usuario.criadoEm);
    desdeConta.textContent = desde ? `No Fisga desde ${desde}` : 'Conta Fisga';
  }

  function iniciarCarregamento() {
    falhaCarregamento.classList.add('oculto');
    conteudo.classList.add('oculto');
    carregando.classList.remove('oculto');
  }

  async function carregarConta() {
    iniciarCarregamento();

    try {
      const { dados } = await pedir('/api/auth/me');

      if (!dados?.autenticado || !dados?.usuario) {
        irParaEntrar();
        return;
      }

      if (dados.consentimentoPendente) {
        window.location.replace(
          '/aceite?destino=' + encodeURIComponent(window.location.pathname + window.location.search)
        );
        return;
      }

      usuarioAtual = dados.usuario;
      preencherIdentidade(usuarioAtual);
      carregando.classList.add('oculto');
      conteudo.classList.remove('oculto');
      void carregarSessoes();
    } catch (erro) {
      if (erro?.status === 401) return;
      carregando.classList.add('oculto');
      falhaTexto.textContent =
        erro?.message || 'Não foi possível carregar sua conta. Confira sua conexão e tente novamente.';
      falhaCarregamento.classList.remove('oculto');
    }
  }

  function svgDispositivo(tipo) {
    if (tipo === 'tablet') {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2.5"></rect><path d="M11 18.5h2"></path></svg>';
    }

    if (tipo === 'celular') {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect><path d="M11 18.5h2"></path></svg>';
    }

    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"></rect><path d="M2 20h20"></path></svg>';
  }

  function descreverDispositivo(userAgent) {
    if (!userAgent) {
      return { titulo: 'Dispositivo desconhecido', tipo: 'computador' };
    }

    const ua = String(userAgent);
    let navegador = '';
    let sistema = '';

    if (ua.includes('Edg/') || ua.includes('EdgiOS')) navegador = 'Edge';
    else if (ua.includes('OPR/') || ua.includes('Opera') || ua.includes('OPiOS')) navegador = 'Opera';
    else if (ua.includes('SamsungBrowser')) navegador = 'Samsung Internet';
    else if (ua.includes('Firefox/') || ua.includes('FxiOS')) navegador = 'Firefox';
    else if (ua.includes('CriOS')) navegador = 'Chrome';
    else if (ua.includes('Chrome/')) navegador = 'Chrome';
    else if (ua.includes('Safari/')) navegador = 'Safari';

    if (ua.includes('Windows NT')) sistema = 'Windows';
    else if (ua.includes('Android')) sistema = 'Android';
    else if (ua.includes('iPad')) sistema = 'iPadOS';
    else if (ua.includes('iPhone') || ua.includes('iPod')) sistema = 'iOS';
    else if (ua.includes('Mac OS X')) sistema = 'macOS';
    else if (ua.includes('CrOS')) sistema = 'ChromeOS';
    else if (ua.includes('Linux')) sistema = 'Linux';

    const tablet =
      ua.includes('iPad') ||
      ua.includes('Tablet') ||
      ua.includes('PlayBook') ||
      (ua.includes('Android') && !ua.includes('Mobile'));
    const celular =
      ua.includes('Mobi') ||
      ua.includes('iPhone') ||
      ua.includes('iPod') ||
      ua.includes('Windows Phone');

    const tipo = tablet ? 'tablet' : celular ? 'celular' : 'computador';
    const descricao = [navegador, sistema ? `no ${sistema}` : ''].filter(Boolean).join(' ');

    return {
      titulo: descricao || 'Dispositivo desconhecido',
      tipo
    };
  }

  function renderizarSessoes(sessoes) {
    sessoesCarregando.classList.add('oculto');
    sessoesErro.classList.add('oculto');
    sessoesLista.innerHTML = '';

    if (!sessoes.length) {
      const vazio = document.createElement('p');
      vazio.className = 'conta-sessoes-vazio';
      vazio.textContent = 'Nenhuma sessão ativa encontrada.';
      sessoesLista.append(vazio);
      return;
    }

    const fragmento = document.createDocumentFragment();

    sessoes.forEach((sessao) => {
      const dispositivo = descreverDispositivo(sessao.userAgent);
      const item = document.createElement('article');
      item.className = `sessao-item${sessao.atual ? ' sessao-item--atual' : ''}`;

      const icone = document.createElement('span');
      icone.className = 'sessao-icone';
      icone.setAttribute('aria-hidden', 'true');
      icone.innerHTML = svgDispositivo(dispositivo.tipo);

      const corpo = document.createElement('div');
      corpo.className = 'sessao-corpo';

      const topo = document.createElement('div');
      topo.className = 'sessao-topo';

      const titulo = document.createElement('strong');
      titulo.textContent = dispositivo.titulo;
      topo.append(titulo);

      if (sessao.atual) {
        const selo = document.createElement('span');
        selo.className = 'selo';
        selo.textContent = 'Sessão atual';
        topo.append(selo);
      }

      corpo.append(topo);

      const criada = formatarDataHora(sessao.criadoEm);
      if (criada) {
        const linhaCriada = document.createElement('p');
        linhaCriada.className = 'sessao-meta';
        linhaCriada.textContent = `Iniciada em ${criada}`;
        corpo.append(linhaCriada);
      }

      const ultimoUso = formatarDataHora(sessao.ultimoUsoEm);
      const linhaUltimoUso = document.createElement('p');
      linhaUltimoUso.className = 'sessao-meta';
      linhaUltimoUso.textContent = ultimoUso
        ? `Último uso em ${ultimoUso}`
        : 'Último uso não registrado';
      corpo.append(linhaUltimoUso);

      const expira = formatarDataHora(sessao.expiraEm);
      const linhaExpira = document.createElement('p');
      linhaExpira.className = 'sessao-meta';
      linhaExpira.textContent = expira ? `Expira em ${expira}` : 'Expiração não informada';
      corpo.append(linhaExpira);

      item.append(icone, corpo);
      fragmento.append(item);
    });

    sessoesLista.append(fragmento);
  }

  async function carregarSessoes() {
    sessoesErro.classList.add('oculto');
    sessoesLista.innerHTML = '';
    sessoesCarregando.classList.remove('oculto');

    try {
      const { dados } = await pedir('/api/conta/sessoes');
      const sessoes = Array.isArray(dados) ? [...dados] : [];

      sessoes.sort((a, b) => {
        if (Boolean(a.atual) !== Boolean(b.atual)) return a.atual ? -1 : 1;
        const dataA = new Date(a.ultimoUsoEm || 0).getTime();
        const dataB = new Date(b.ultimoUsoEm || 0).getTime();
        return dataB - dataA;
      });

      renderizarSessoes(sessoes);
    } catch (erro) {
      if (erro?.status === 401) return;
      sessoesCarregando.classList.add('oculto');
      sessoesErroTexto.textContent =
        erro?.message || 'Não foi possível carregar suas sessões. Tente novamente.';
      sessoesErro.classList.remove('oculto');
    }
  }

  function abrirModalConfirmacao(opcoes) {
    ultimoFoco = document.activeElement;
    modalTitulo.textContent = opcoes.titulo;
    modalDescricao.textContent = opcoes.descricao;
    modalSimbolo.textContent = opcoes.simbolo || '!';
    modalSimbolo.className = `modal-simbolo${opcoes.perigo ? ' modal-simbolo--perigo' : ''}`;

    modalConfirmar.className = `btn ${opcoes.perigo ? 'btn--perigo' : 'btn--primario'}`;
    modalConfirmar.textContent = opcoes.rotuloConfirmar;
    modalConfirmar.dataset.texto = opcoes.rotuloConfirmar;

    modalErro.textContent = '';
    modalErro.classList.add('oculto');
    modalConfirmacao.value = '';
    modalCampo.classList.toggle('oculto', !opcoes.exigirTexto);
    textoExigido = opcoes.exigirTexto || null;
    modalConfirmar.disabled = Boolean(textoExigido);
    modalCancelar.disabled = false;
    modalFechar.disabled = false;
    modalConfirmacao.disabled = false;

    acaoConfirmar = opcoes.aoConfirmar;

    overflowAnterior = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    fundoInerte.forEach((elemento) => elemento?.setAttribute('inert', ''));
    modal.hidden = false;

    window.requestAnimationFrame(() => {
      if (textoExigido) modalConfirmacao.focus();
      else modalCancelar.focus();
    });
  }

  function fecharModal() {
    if (modal.hidden) return;

    modal.hidden = true;
    modalEmEnvio = false;
    acaoConfirmar = null;
    textoExigido = null;
    document.body.style.overflow = overflowAnterior;
    fundoInerte.forEach((elemento) => elemento?.removeAttribute('inert'));

    if (ultimoFoco && typeof ultimoFoco.focus === 'function') {
      ultimoFoco.focus();
    }
    ultimoFoco = null;
  }

  async function confirmarModal() {
    if (modalEmEnvio || !acaoConfirmar) return;

    if (textoExigido && modalConfirmacao.value.trim() !== textoExigido) {
      modalErro.textContent = 'Digite EXCLUIR, em maiúsculas, para confirmar.';
      modalErro.classList.remove('oculto');
      modalConfirmacao.focus();
      return;
    }

    modalEmEnvio = true;
    const rotuloOriginal = modalConfirmar.dataset.texto || modalConfirmar.textContent;

    modalConfirmar.disabled = true;
    modalConfirmar.textContent = 'Processando...';
    modalCancelar.disabled = true;
    modalFechar.disabled = true;
    modalConfirmacao.disabled = true;
    modalErro.classList.add('oculto');

    try {
      await acaoConfirmar();
    } catch (erro) {
      if (erro?.status !== 401) {
        modalErro.textContent =
          erro?.message || 'Não foi possível concluir a ação. Tente novamente.';
        modalErro.classList.remove('oculto');
      }
    } finally {
      modalEmEnvio = false;

      if (!modal.hidden) {
        modalCancelar.disabled = false;
        modalFechar.disabled = false;
        modalConfirmacao.disabled = false;
        modalConfirmar.textContent = rotuloOriginal;
        modalConfirmar.disabled =
          Boolean(textoExigido) && modalConfirmacao.value.trim() !== textoExigido;
      }
    }
  }

  function abrirModalSairAtual(motivoTroca = false) {
    const email = usuarioAtual?.email || 'seu e-mail';

    abrirModalConfirmacao({
      titulo: motivoTroca ? 'Sair para trocar de e-mail?' : 'Sair deste dispositivo?',
      descricao: motivoTroca
        ? `Você vai encerrar esta sessão. Depois, é só entrar com o novo e-mail para receber o link mágico no endereço certo.`
        : `Você vai encerrar a sessão deste dispositivo. Para voltar, será preciso pedir um novo link mágico para ${email}.`,
      rotuloConfirmar: motivoTroca ? 'Sair da conta' : 'Sair',
      aoConfirmar: async () => {
        await pedir('/api/auth/sair', { metodo: 'POST' });
        fecharModal();
        mostrarToast('Sessão encerrada. Até a próxima pescaria!', 'ok');
        window.setTimeout(() => window.location.assign('/'), 1200);
      }
    });
  }

  formPerfil.addEventListener('submit', async (evento) => {
    evento.preventDefault();

    const nome = nomePerfil.value.trim();

    if (nome.length > 80) {
      definirFeedback(perfilFeedback, 'O nome deve ter até 80 caracteres.', 'erro');
      nomePerfil.focus();
      return;
    }

    const rotuloOriginal = salvarPerfil.textContent;
    salvarPerfil.disabled = true;
    salvarPerfil.textContent = 'Salvando...';
    definirFeedback(perfilFeedback, '', null);

    try {
      const { dados } = await pedir('/api/auth/perfil', {
        metodo: 'PATCH',
        corpo: {
          nome: nome || null,
          aceitaNovidades: aceitaNovidades.checked
        }
      });

      if (dados) {
        usuarioAtual = dados;
        preencherIdentidade(dados);
      }

      definirFeedback(perfilFeedback, 'Alterações salvas.', 'ok');
      mostrarToast('Perfil atualizado.', 'ok');
    } catch (erro) {
      if (erro?.status !== 401) {
        definirFeedback(
          perfilFeedback,
          erro?.message || 'Não foi possível salvar suas alterações. Tente novamente.',
          'erro'
        );
      }
    } finally {
      salvarPerfil.disabled = false;
      salvarPerfil.textContent = rotuloOriginal;
    }
  });

  nomePerfil.addEventListener('input', atualizarContador);

  btnTrocarEmail.addEventListener('click', () => {
    const vaiAbrir = trocarEmail.classList.contains('oculto');
    trocarEmail.classList.toggle('oculto', !vaiAbrir);
    btnTrocarEmail.setAttribute('aria-expanded', String(vaiAbrir));
    btnTrocarEmail.textContent = vaiAbrir ? 'Fechar' : 'Trocar e-mail';
  });

  sairParaTrocar.addEventListener('click', () => abrirModalSairAtual(true));

  sairAtual.addEventListener('click', () => abrirModalSairAtual(false));

  sairTodos.addEventListener('click', () => {
    abrirModalConfirmacao({
      titulo: 'Sair de todos os dispositivos?',
      descricao:
        'Todos os navegadores e aparelhos conectados à sua conta serão desconectados. Cada um vai precisar de um novo link mágico para entrar.',
      rotuloConfirmar: 'Sair de todos',
      aoConfirmar: async () => {
        await pedir('/api/auth/sair-de-todos', { metodo: 'POST' });
        fecharModal();
        mostrarToast('Todas as sessões foram encerradas.', 'ok');
        window.setTimeout(() => window.location.assign('/'), 1200);
      }
    });
  });

  exportarDados.addEventListener('click', async () => {
    const rotuloOriginal = exportarDados.textContent;
    exportarDados.disabled = true;
    exportarDados.textContent = 'Preparando arquivo...';
    definirFeedback(exportarFeedback, '', null);

    try {
      const { resposta } = await pedir('/api/conta/exportar', { bruto: true });
      const blob = await resposta.blob();
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');

      link.href = url;
      link.download = `fisga-conta-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1500);

      definirFeedback(exportarFeedback, 'Exportação iniciada. Confira seus downloads.', 'ok');
      mostrarToast('Seus dados estão sendo baixados.', 'ok');
    } catch (erro) {
      if (erro?.status !== 401) {
        definirFeedback(
          exportarFeedback,
          erro?.message || 'Não foi possível exportar seus dados. Tente novamente.',
          'erro'
        );
        mostrarToast('Não foi possível exportar seus dados.', 'erro');
      }
    } finally {
      exportarDados.disabled = false;
      exportarDados.textContent = rotuloOriginal;
    }
  });

  excluirConta.addEventListener('click', () => {
    abrirModalConfirmacao({
      titulo: 'Excluir sua conta?',
      descricao:
        'Esta ação é permanente. Vamos apagar seu perfil, suas pescarias, capturas e fotos. Não é possível recuperar depois.',
      rotuloConfirmar: 'Excluir minha conta',
      perigo: true,
      exigirTexto: 'EXCLUIR',
      aoConfirmar: async () => {
        await pedir('/api/conta', {
          metodo: 'DELETE',
          corpo: { confirmacao: 'EXCLUIR' }
        });

        fecharModal();
        conteudo.classList.add('oculto');
        falhaCarregamento.classList.add('oculto');
        contaEncerrada.classList.remove('oculto');

        const comportamentoAnterior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = 'auto';
        contaEncerrada.scrollIntoView({ block: 'start' });
        document.documentElement.style.scrollBehavior = comportamentoAnterior;
        contaEncerradaTitulo.focus({ preventScroll: true });

        window.setTimeout(() => window.location.replace('/'), 2400);
      }
    });
  });

  modalConfirmacao.addEventListener('input', () => {
    if (modalEmEnvio) return;
    const podeConfirmar = !textoExigido || modalConfirmacao.value.trim() === textoExigido;
    modalConfirmar.disabled = !podeConfirmar;
    if (podeConfirmar) modalErro.classList.add('oculto');
  });

  modalConfirmacao.addEventListener('keydown', (evento) => {
    if (evento.key === 'Enter' && !modalConfirmar.disabled) {
      evento.preventDefault();
      void confirmarModal();
    }
  });

  modalConfirmar.addEventListener('click', () => void confirmarModal());

  modalCancelar.addEventListener('click', () => {
    if (!modalEmEnvio) fecharModal();
  });

  modalFechar.addEventListener('click', () => {
    if (!modalEmEnvio) fecharModal();
  });

  modal.addEventListener('click', (evento) => {
    if (evento.target === modal && !modalEmEnvio) fecharModal();
  });

  document.addEventListener('keydown', (evento) => {
    if (modal.hidden) return;

    if (evento.key === 'Escape') {
      evento.preventDefault();
      if (!modalEmEnvio) fecharModal();
      return;
    }

    if (evento.key !== 'Tab') return;

    const focaveis = Array.from(
      modal.querySelectorAll('button, input, a[href], [tabindex]:not([tabindex="-1"])')
    ).filter((elemento) => !elemento.disabled && elemento.offsetParent !== null);

    if (!focaveis.length) {
      evento.preventDefault();
      modalCaixa.focus();
      return;
    }

    const primeiro = focaveis[0];
    const ultimo = focaveis[focaveis.length - 1];

    if (evento.shiftKey && document.activeElement === primeiro) {
      evento.preventDefault();
      ultimo.focus();
    } else if (!evento.shiftKey && document.activeElement === ultimo) {
      evento.preventDefault();
      primeiro.focus();
    }
  });

  recarregar.addEventListener('click', () => void carregarConta());
  recarregarSessoes.addEventListener('click', () => void carregarSessoes());

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void carregarConta(), { once: true });
  } else {
    void carregarConta();
  }
</script>
