  function formatarDataHora(iso: string | null | undefined) {
    if (!iso) return '';
    const data = new Date(iso);
    if (Number.isNaN(data.getTime())) return '';
    return formatoDataHora.format(data);
  }

  function svgDispositivo(tipo: string) {
    if (tipo === 'tablet') {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2.5"></rect><path d="M11 18.5h2"></path></svg>';
    }

    if (tipo === 'celular') {
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect><path d="M11 18.5h2"></path></svg>';
    }

    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="2"></rect><path d="M2 20h20"></path></svg>';
  }

  function descreverDispositivo(userAgent: string | null) {
    if (!userAgent) {
      return { titulo: 'Dispositivo desconhecido', tipo: 'computador' };
    }

    const ua = String(userAgent);
    let navegador = '';
    let sistema = '';

    if (ua.includes('Edg/') || ua.includes('EdgiOS')) navegador = 'Edge';
    else if (ua.includes('OPR/') || ua.includes('Opera') || ua.includes('OPiOS')) navegador = 'Opera';
    else if (ua.includes('SamsungBrowser')) navegador = 'Samsung Internet';
    else if (ua.includes('Firefox/') || ua.includes('FxiOS')) navegador = 'Firefox';
    else if (ua.includes('CriOS')) navegador = 'Chrome';
    else if (ua.includes('Chrome/')) navegador = 'Chrome';
    else if (ua.includes('Safari/')) navegador = 'Safari';

    if (ua.includes('Windows NT')) sistema = 'Windows';
    else if (ua.includes('Android')) sistema = 'Android';
    else if (ua.includes('iPad')) sistema = 'iPadOS';
    else if (ua.includes('iPhone') || ua.includes('iPod')) sistema = 'iOS';
    else if (ua.includes('Mac OS X')) sistema = 'macOS';
    else if (ua.includes('CrOS')) sistema = 'ChromeOS';
    else if (ua.includes('Linux')) sistema = 'Linux';

    const tablet =
      ua.includes('iPad') ||
      ua.includes('Tablet') ||
      ua.includes('PlayBook') ||
      (ua.includes('Android') && !ua.includes('Mobile'));
    const celular =
      ua.includes('Mobi') ||
      ua.includes('iPhone') ||
      ua.includes('iPod') ||
      ua.includes('Windows Phone');

    const tipo = tablet ? 'tablet' : celular ? 'celular' : 'computador';
    const descricao = [navegador, sistema ? `no ${sistema}` : ''].filter(Boolean).join(' ');

    return { titulo: descricao || 'Dispositivo desconhecido', tipo };
  }

  function renderizarSessoes(lista: SessaoConta[]) {
    if (!sessoesLista || !sessoesCarregando) return;

    sessoesCarregando.hidden = true;
    if (sessoesErro) sessoesErro.hidden = true;
    sessoesLista.innerHTML = '';
    if (sessoesVazio) sessoesVazio.hidden = lista.length > 0;

    if (!lista.length) return;

    const fragmento = document.createDocumentFragment();

    lista.forEach((sessao) => {
      const dispositivo = descreverDispositivo(sessao.userAgent);
      const item = document.createElement('div');
      item.className = 'session';

      const icone = document.createElement('span');
      icone.className = 'session-icon';
      icone.setAttribute('aria-hidden', 'true');
      icone.innerHTML = svgDispositivo(dispositivo.tipo);

      const principal = document.createElement('div');
      principal.className = 'session-main';

      const nome = document.createElement('div');
      nome.className = 'session-name';
      const titulo = document.createElement('strong');
      titulo.textContent = dispositivo.titulo;
      nome.append(titulo);

      if (sessao.atual) {
        const selo = document.createElement('span');
        selo.className = 'badge badge--tint';
        selo.textContent = 'Sessão atual';
        nome.append(selo);
      }

      const criada = formatarDataHora(sessao.criadoEm);
      const ultimoUso = formatarDataHora(sessao.ultimoUsoEm);
      const meta = document.createElement('p');
      meta.className = 'session-meta';
      meta.textContent = [
        criada ? `Iniciada em ${criada}` : '',
        ultimoUso ? `Último uso em ${ultimoUso}` : ''
      ]
        .filter(Boolean)
        .join(' · ');

      principal.append(nome);
      if (meta.textContent) principal.append(meta);
      item.append(icone, principal);
      fragmento.append(item);
    });

    sessoesLista.append(fragmento);
  }

  async function carregarSessoes() {
    if (!sessoesCarregando || !sessoesLista) return;

    sessoesCarregando.hidden = false;
    if (sessoesErro) sessoesErro.hidden = true;
    sessoesLista.innerHTML = '';
    if (sessoesVazio) sessoesVazio.hidden = true;

    try {
      const { dados } = await pedir<SessaoConta[]>('/api/conta/sessoes');
      sessoes = Array.isArray(dados) ? [...dados] : [];

      sessoes.sort((a, b) => {
        if (Boolean(a.atual) !== Boolean(b.atual)) return a.atual ? -1 : 1;
        const dataA = new Date(a.ultimoUsoEm || 0).getTime();
        const dataB = new Date(b.ultimoUsoEm || 0).getTime();
        return dataB - dataA;
      });

      outrasSessoes = sessoes.filter((sessao) => !sessao.atual).length;
      renderizarSessoes(sessoes);
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status === 401) return;
      sessoesCarregando.hidden = true;
      if (sessoesErroTexto) {
        sessoesErroTexto.textContent =
          erro instanceof Error
            ? erro.message
            : 'Não foi possível carregar suas sessões. Tente novamente.';
      }
      if (sessoesErro) sessoesErro.hidden = false;
    }
  }

  function limparEstadoDaConta() {
    if (senhaFeedback) senhaFeedback.hidden = true;
    if (senhaFeedbackTexto) senhaFeedbackTexto.textContent = '';
    if (aviso) aviso.hidden = true;
    limparFeedbackDados();
    limparErroNomeDados();
  }

  async function carregarConta() {
    limparEstadoDaConta();
    if (!carregando || !falhaCarregamento || !conteudo) return;

    carregando.hidden = false;
    falhaCarregamento.hidden = true;
    conteudo.hidden = true;

    try {
      const { dados } = await pedir<MeConta>('/api/auth/me');

      if (!dados?.autenticado || !dados.usuario) {
        irParaEntrar();
        return;
      }

      if (dados.consentimentoPendente) {
        window.location.replace(
          '/aceite?destino=' +
            encodeURIComponent(window.location.pathname + window.location.search)
        );
        return;
      }

      temSenha = dados.temSenha === true;
      googleConectado = dados.googleConectado === true;
      if (email) email.textContent = dados.usuario.email;
      preencherDados(dados.usuario);
      atualizarSenha();
      atualizarGoogle();

      aplicarEstadoDaUrl();
      carregando.hidden = true;
      conteudo.hidden = false;
      void carregarSessoes();
      void verificarGoogleDisponivel();
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status === 401) return;
      carregando.hidden = true;
      if (falhaCarregamentoTexto) {
        falhaCarregamentoTexto.textContent =
          erro instanceof Error
            ? erro.message
            : 'Não foi possível carregar sua conta. Confira sua conexão e tente novamente.';
      }
      falhaCarregamento.hidden = false;
      porId<HTMLElement>('conta-load-error-titulo')?.focus();
    }
  }

  function aplicarEstadoDaUrl() {
    const parametros = new URLSearchParams(window.location.search);
    const estado = parametros.get('estado');
    if (!estado) return;

    const mensagens: Record<string, { tipo: TipoAviso; texto: string }> = {
      google_conectado: {
        tipo: 'ok',
        texto: 'Google conectado. Agora você pode entrar com um toque.'
      },
      google_email_divergente: {
        tipo: 'erro',
        texto: 'O e-mail do Google precisa ser o mesmo e-mail da sua conta Fisga.'
      },
      google_email_nao_verificado: {
        tipo: 'erro',
        texto: 'O e-mail da conta Google não está verificado. Tente com outra conta.'
      },
      google_email_nao_verificado_localmente: {
        tipo: 'erro',
        texto: 'Confirme seu e-mail no Fisga antes de conectar o Google.'
      },
      google_intencao_invalida: {
        tipo: 'erro',
        texto: 'A conexão expirou. Tente conectar o Google de novo.'
      },
      google_intencao_expirada: {
        tipo: 'erro',
        texto: 'A conexão expirou. Tente conectar o Google de novo.'
      },
      google_sessao_externa_invalida: {
        tipo: 'erro',
        texto: 'Não concluímos a conexão com Google. Tente de novo.'
      },
      google_conexao_nao_autenticado: {
        tipo: 'erro',
        texto: 'Sua sessão expirou. Entre novamente para conectar o Google.'
      },
      google_vinculo_falhou: {
        tipo: 'erro',
        texto: 'Esta conta do Google já está associada a outro usuário.'
      },
      google_indisponivel: {
        tipo: 'erro',
        texto: 'A conexão com Google não está disponível agora.'
      }
    };

    const mensagem = mensagens[estado] ?? {
      tipo: 'erro' as TipoAviso,
      texto: 'Não concluímos a conexão com Google. Tente de novo.'
    };

    mostrarAviso(mensagem.tipo, mensagem.texto);

    const url = new URL(window.location.href);
    url.searchParams.delete('estado');
    window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  }

  function resetarRevealSenha() {
    document.querySelectorAll<HTMLButtonElement>('#dialog-senha [data-reveal]').forEach((botao) => {
      const input = document.getElementById(botao.dataset.reveal ?? '') as HTMLInputElement | null;
      if (input) input.type = 'password';
      botao.setAttribute('aria-pressed', 'false');
      botao.setAttribute('aria-label', 'Mostrar senha');
      const eye = botao.querySelector('[data-icon="eye"]') as HTMLElement | null;
      const eyeOff = botao.querySelector('[data-icon="eye-off"]') as HTMLElement | null;
      if (eye) eye.style.display = '';
      if (eyeOff) eyeOff.style.display = 'none';
    });
  }

  function atualizarDicaSenha() {
    if (!senhaDica) return;
    senhaDica.textContent =
      modoSenha === 'alterar'
        ? 'Informe a senha atual e escolha uma nova, de 10 a 128 caracteres. Não exigimos maiúscula, número ou símbolo.'
        : 'Use de 10 a 128 caracteres. Não exigimos maiúscula, número ou símbolo.';
  }

  function abrirDialogoSenha() {
    if (!dialogSenha || !senhaTitulo || !campoSenhaAtual) return;

    modoSenha = temSenha ? 'alterar' : 'criar';
    senhaTitulo.textContent = modoSenha === 'alterar' ? 'Alterar senha' : 'Criar uma senha';
    atualizarDicaSenha();
    campoSenhaAtual.hidden = modoSenha === 'criar';
    resetarRevealSenha();
    if (senhaAtual) senhaAtual.value = '';
    if (novaSenha) novaSenha.value = '';
    if (confirmarSenha) confirmarSenha.value = '';
    limparErroCampo('senha-atual');
    limparErroCampo('nova-senha');
    limparErroCampo('confirmar-senha');
    if (senhaErro) senhaErro.hidden = true;
    if (senhaFeedback) senhaFeedback.hidden = true;

    dialogSenha.showModal();
    // Foco síncrono após showModal: agendar em requestAnimationFrame permitia
    // que o foco mudasse no meio da digitação/preenchimento (perda de caracteres).
    (modoSenha === 'alterar' ? senhaAtual : novaSenha)?.focus();
  }

  function fecharDialogoSenha() {
    if (salvandoSenha || !dialogSenha?.open) return;
    dialogSenha.close();
  }

  function mostrarFeedbackSenha(texto: string) {
    if (!senhaFeedback || !senhaFeedbackTexto) return;
    const complemento =
      outrasSessoes > 0 ? ' Os outros dispositivos foram desconectados.' : '';
    senhaFeedbackTexto.textContent = `${texto}${complemento}`;
    senhaFeedback.hidden = false;
    senhaFeedback.scrollIntoView({ block: 'nearest' });
  }

  formSenha?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (salvandoSenha) return;

    limparErroCampo('senha-atual');
    limparErroCampo('nova-senha');
    limparErroCampo('confirmar-senha');
    if (senhaErro) senhaErro.hidden = true;

    if (modoSenha === 'alterar' && !senhaAtual?.value) {
      erroCampo('senha-atual', 'Informe sua senha atual.');
      return;
    }

    const nova = novaSenha?.value ?? '';
    if (nova.length < 10) {
      erroCampo('nova-senha', 'Use pelo menos 10 caracteres.');
      return;
    }
    if (nova.length > 128) {
      erroCampo('nova-senha', 'Use no máximo 128 caracteres.');
      return;
    }
    if (nova !== (confirmarSenha?.value ?? '')) {
      erroCampo('confirmar-senha', 'As senhas não são iguais. Confira e tente de novo.');
      return;
    }

    salvandoSenha = true;
    setLoading(senhaSalvar, true, 'Salvando…');

    try {
      await pedir('/api/conta/senha', {
        metodo: 'POST',
        corpo: {
          senhaAtual: modoSenha === 'alterar' ? senhaAtual?.value ?? '' : null,
          novaSenha: nova
        }
      });

      const eraCriacao = modoSenha === 'criar';
      temSenha = true;
      atualizarSenha();
      dialogSenha?.close();
      mostrarFeedbackSenha(eraCriacao ? 'Senha criada.' : 'Senha alterada.');
      void carregarSessoes();
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status !== 401) {
        if (erro.codigo === 'senha_atual_incorreta') {
          // Outra aba pode ter criado a senha primeiro (ou uma API antiga não
          // informou temSenha). Sem trocar de modo, o campo atual ficaria
          // escondido e o erro pareceria um diálogo travado.
          if (modoSenha === 'criar') {
            modoSenha = 'alterar';
            temSenha = true;
            if (senhaTitulo) senhaTitulo.textContent = 'Alterar senha';
            atualizarDicaSenha();
            atualizarSenha();
          }
          erroCampo('senha-atual', 'A senha atual está incorreta.');
        } else if (erro.codigo === 'senha_curta') {
          erroCampo('nova-senha', 'Use pelo menos 10 caracteres.');
        } else if (erro.codigo === 'senha_longa') {
          erroCampo('nova-senha', 'Use no máximo 128 caracteres.');
        } else if (senhaErro && senhaErroTexto) {
          senhaErroTexto.textContent =
            erro.message || 'Não foi possível salvar a senha. Tente novamente.';
          senhaErro.hidden = false;
        }
      }
    } finally {
      salvandoSenha = false;
      setLoading(senhaSalvar, false);
    }
  });

  formDados?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (salvandoDados) return;

    limparFeedbackDados();
    limparErroNomeDados();

    const nome = dadosNome?.value.trim() ?? '';
    if (nome.length > 80) {
      erroNomeDados('Use até 80 caracteres.');
      return;
    }

    salvandoDados = true;
    setLoading(dadosSalvar, true, 'Salvando…');

    try {
      const { dados } = await pedir<UsuarioConta>('/api/auth/perfil', {
        metodo: 'PATCH',
        corpo: {
          nome: nome || null,
          aceitaNovidades: dadosNovidades?.checked === true
        }
      });

      if (dados) {
        if (dadosNome) dadosNome.value = dados.nome ?? '';
        if (dadosNovidades) dadosNovidades.checked = dados.aceitaNovidades === true;
      }
      mostrarFeedbackDados('Dados salvos.');
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status !== 401) {
        if (erro.codigo === 'nome_longo') {
          erroNomeDados('Use até 80 caracteres.');
        } else {
          mostrarErroDados(erro.message || 'Não foi possível salvar seus dados. Tente novamente.');
        }
      }
    } finally {
      salvandoDados = false;
      setLoading(dadosSalvar, false);
    }
  });

  dadosExportar?.addEventListener('click', async () => {
    if (exportandoDados) return;

    limparFeedbackDados();
    exportandoDados = true;
    setLoading(dadosExportar, true, 'Preparando…');

    try {
      const resposta = await fetch(`${API}/api/conta/exportar`, {
        credentials: 'include',
        headers: { Accept: 'application/json' }
      });

      if (resposta.status === 401) {
        irParaEntrar();
        return;
      }

      if (!resposta.ok) {
        let mensagem = mensagemDoStatus(resposta.status);
        try {
          const dados = (await resposta.json()) as Record<string, unknown>;
          if (typeof dados?.detalhe === 'string') mensagem = dados.detalhe;
        } catch {
          // resposta sem JSON: mantém a mensagem por status
        }
        mostrarErroDados(mensagem);
        return;
      }

      const arquivo = await resposta.blob();
      const disposicao = resposta.headers.get('Content-Disposition') ?? '';
      const encontrado = /filename\*?=(?:UTF-8''|")?([^";]+)/i.exec(disposicao);
      const nomeArquivo =
        encontrado?.[1]?.trim() ||
        `fisga-conta-${new Date().toISOString().slice(0, 10).replaceAll('-', '')}.json`;

      const url = URL.createObjectURL(arquivo);
      const link = document.createElement('a');
      link.href = url;
      link.download = nomeArquivo;
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      mostrarFeedbackDados('Download iniciado. O arquivo JSON deve aparecer na sua pasta de downloads.');
    } catch {
      mostrarErroDados(MENSAGEM_REDE);
    } finally {
      exportandoDados = false;
      setLoading(dadosExportar, false);
    }
  });

  function abrirDialogoSair(modo: ModoSair) {
    if (!dialogSair || !sairTitulo || !sairCopia || !sairConfirmar) return;

    modoSair = modo;
    sairTitulo.textContent =
      modo === 'atual' ? 'Sair desta sessão?' : 'Sair de todos os dispositivos?';
    sairCopia.textContent =
      modo === 'atual'
        ? 'Você vai encerrar a sessão deste dispositivo. Para voltar, será preciso entrar novamente.'
        : 'Todos os navegadores e aparelhos conectados serão desconectados. Cada um vai precisar entrar novamente.';
    const label = sairConfirmar.querySelector('[data-btn-label]') as HTMLElement | null;
    const rotulo = modo === 'atual' ? 'Sair' : 'Sair de todos';
    if (label) label.textContent = rotulo;
    // O setLoading restaura o rótulo a partir daqui; sem atualizar junto com o
    // modo, uma falha anterior poderia deixar "Sair de todos" em "Sair".
    sairConfirmar.dataset.idleLabel = rotulo;
    if (sairErro) sairErro.hidden = true;

    dialogSair.showModal();
    window.requestAnimationFrame(() => {
      (document.querySelector('[data-fechar-sair]') as HTMLButtonElement | null)?.focus();
    });
  }

  sairConfirmar?.addEventListener('click', async () => {
    if (saindo) return;

    saindo = true;
    setLoading(sairConfirmar, true, 'Saindo…');

    try {
      await pedir(modoSair === 'atual' ? '/api/auth/sair' : '/api/auth/sair-de-todos', {
        metodo: 'POST'
      });
      window.location.assign('/entrar?saiu=1');
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status !== 401 && sairErro && sairErroTexto) {
        sairErroTexto.textContent =
          erro.message || 'Não foi possível sair agora. Tente novamente.';
        sairErro.hidden = false;
      }
    } finally {
      saindo = false;
      setLoading(sairConfirmar, false);
    }
  });

  excluirConfirmacao?.addEventListener('input', () => {
    if (!excluirConfirmar) return;
    excluirConfirmar.disabled = excluirConfirmacao.value.trim() !== 'EXCLUIR';
    if (!excluirConfirmar.disabled && excluirErro) excluirErro.hidden = true;
  });

  excluirConta?.addEventListener('click', () => {
    if (!dialogExcluir || !excluirConfirmacao || !excluirConfirmar) return;
    excluirConfirmacao.value = '';
    excluirConfirmar.disabled = true;
    if (excluirErro) excluirErro.hidden = true;
    dialogExcluir.showModal();
    window.requestAnimationFrame(() => excluirConfirmacao.focus());
  });

  excluirConfirmar?.addEventListener('click', async () => {
    if (excluindo || excluirConfirmacao?.value.trim() !== 'EXCLUIR') return;

    excluindo = true;
    setLoading(excluirConfirmar, true, 'Excluindo…');

    try {
      await pedir('/api/conta', {
        metodo: 'DELETE',
        corpo: { confirmacao: 'EXCLUIR' }
      });

      dialogExcluir?.close();
      if (conteudo) conteudo.hidden = true;
      if (falhaCarregamento) falhaCarregamento.hidden = true;
      if (carregando) carregando.hidden = true;
      if (contaEncerrada) contaEncerrada.hidden = false;
      contaEncerradaTitulo?.focus({ preventScroll: true });
      contaEncerrada?.scrollIntoView({ block: 'start' });
      window.setTimeout(() => window.location.replace('/'), 2400);
    } catch (erro) {
      if (erro instanceof FalhaApi && erro.status !== 401 && excluirErro && excluirErroTexto) {
        excluirErroTexto.textContent =
          erro.message || 'Não foi possível excluir a conta. Tente novamente.';
        excluirErro.hidden = false;
      }
    } finally {
      excluindo = false;
      setLoading(excluirConfirmar, false);
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-reveal]').forEach((botao) => {
    const input = document.getElementById(botao.dataset.reveal ?? '') as HTMLInputElement | null;
    if (!input) return;

    botao.addEventListener('click', () => {
      const mostrando = input.type === 'text';
      input.type = mostrando ? 'password' : 'text';
      botao.setAttribute('aria-pressed', String(!mostrando));
      botao.setAttribute('aria-label', mostrando ? 'Mostrar senha' : 'Ocultar senha');
      const eye = botao.querySelector('[data-icon="eye"]') as HTMLElement | null;
      const eyeOff = botao.querySelector('[data-icon="eye-off"]') as HTMLElement | null;
      if (eye) eye.style.display = mostrando ? 'none' : '';
      if (eyeOff) eyeOff.style.display = mostrando ? '' : 'none';
      input.focus();
    });
  });

  document.querySelector('[data-fechar-senha]')?.addEventListener('click', fecharDialogoSenha);
  document.querySelector('[data-fechar-sair]')?.addEventListener('click', () => {
    if (!saindo) dialogSair?.close();
  });
  document.querySelector('[data-fechar-excluir]')?.addEventListener('click', () => {
    if (!excluindo) dialogExcluir?.close();
  });

  dialogSenha?.addEventListener('cancel', (evento) => {
    if (salvandoSenha) evento.preventDefault();
  });
  dialogSair?.addEventListener('cancel', (evento) => {
    if (saindo) evento.preventDefault();
  });
  dialogExcluir?.addEventListener('cancel', (evento) => {
    if (excluindo) evento.preventDefault();
  });

  senhaAcao?.addEventListener('click', abrirDialogoSenha);
  googleAcao?.addEventListener('click', () => {
    setLoading(googleAcao, true, 'Abrindo Google…');
    window.location.assign(`${API}/api/auth/google/conectar`);
  });
  sairAtual?.addEventListener('click', () => abrirDialogoSair('atual'));
  sairTodos?.addEventListener('click', () => abrirDialogoSair('todos'));
  recarregar?.addEventListener('click', () => void carregarConta());
  recarregarSessoes?.addEventListener('click', () => void carregarSessoes());

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void carregarConta(), { once: true });
  } else {
    void carregarConta();
  }
</script>
