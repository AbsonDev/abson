---
import Layout from '../layouts/Layout.astro';
import { obterCatalogo } from '../lib/api';

const catalogo = await obterCatalogo();
const catalogoJson = JSON.stringify(catalogo).replace(/</g, '\\u003c');
const hoje = new Date().toISOString().slice(0, 10);
const retornoRegistro = `/registrar${Astro.url.search}`;
---

<Layout
  titulo="Registrar pescaria — Fisga"
  descricao="Registre local, condições, capturas e fotos. Gere o card do troféu e o relatório da pescaria."
>
  <section class="calc-topo">
    <div class="container">
      <span class="eyebrow">Nova pescaria</span>
      <h1>O que aconteceu <em>na água?</em></h1>
      <p>
        Registre o dia, as condições e cada peixe. Depois o Fisga monta seu diário, o card do troféu
        e o relatório em PDF.
      </p>
    </div>
  </section>

  <section class="container">
    <div id="acesso-registrar" class="aviso-acesso oculto">
      <svg class="aviso-acesso-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2"></rect><path d="M8.5 10.5V8a3.5 3.5 0 0 1 6.8-1.1"></path></svg>
      <p>Você pode preencher agora. Entrar só quando quiser salvar.</p>
      <a class="aviso-acesso-link" href={`/entrar?voltar=${encodeURIComponent(retornoRegistro)}`}>Entrar</a>
    </div>
  </section>

  <section class="container calc-layout">
    {!catalogo && (
      <div class="erro-caixa visivel" style="margin-bottom: 16px;">
        Não foi possível carregar o catálogo agora. Você ainda pode preencher os campos e salvar.
      </div>
    )}

    <form id="pescaria-form" class="calc-form" novalidate>
      <div id="erro-form" class="erro-caixa" role="alert"></div>
      <div id="rascunho-indicador" class="rascunho-indicador" role="status"></div>

      <nav class="registro-passos" aria-label="Etapas do registro">
        <button type="button" data-etapa-botao="1" aria-current="step">1 A pescaria</button>
        <button type="button" data-etapa-botao="2">2 As condições</button>
        <button type="button" data-etapa-botao="3">3 As capturas</button>
        <button type="button" data-etapa-botao="4">4 Revisar</button>
      </nav>

      <div id="condicoes-aplicadas" class="condicoes-aplicadas oculto" role="status">
        <div>
          <span class="selo selo--terracota">Condições aplicadas</span>
          <p id="condicoes-texto"></p>
        </div>
        <button id="ocultar-condicoes" class="btn btn--pequeno btn--contorno" type="button">Ocultar</button>
      </div>

      <div id="exif-aviso" class="condicoes-aplicadas oculto" role="status">
        <div>
          <span class="selo selo--terracota">Dados da foto</span>
          <p id="exif-texto"></p>
        </div>
        <button id="ocultar-exif" class="btn btn--pequeno btn--contorno" type="button">Ocultar</button>
      </div>

      <datalist id="lista-especies">
        {(catalogo?.especies ?? []).map((especie) => <option value={especie}></option>)}
      </datalist>
      <datalist id="lista-iscas">
        {(catalogo?.iscas ?? []).map((isca) => <option value={isca}></option>)}
      </datalist>

      <section class="painel" aria-labelledby="titulo-pescaria" data-etapa="1">
        <div class="painel-cabecalho">
          <span class="passo-etiqueta">01</span>
          <div>
            <h2 id="titulo-pescaria">A pescaria</h2>
            <p>Onde, quando e em que ambiente você pescou.</p>
          </div>
        </div>

        <div class="campo">
          <label for="local">Local</label>
          <input id="local" type="text" maxlength="120" placeholder="Ex.: Represa do Lago Azul" autocomplete="off" />
        </div>

        <div class="campo-duplo">
          <div class="campo">
            <label for="pescador">Pescador</label>
            <input id="pescador" type="text" maxlength="80" placeholder="Seu nome" autocomplete="name" />
          </div>
          <div class="campo">
            <label for="data">Data</label>
            <input id="data" type="date" value={hoje} />
          </div>
        </div>

        <div class="campo-triplo">
          <div class="campo">
            <label for="cidade">Cidade</label>
            <input id="cidade" type="text" maxlength="80" placeholder="Ex.: Campinas" autocomplete="address-level2" />
          </div>
          <div class="campo">
            <label for="estado">UF</label>
            <input id="estado" type="text" maxlength="2" placeholder="SP" autocomplete="address-level1" />
          </div>
          <div class="campo">
            <label for="ambiente">Ambiente</label>
            <select id="ambiente">
              <option value="Rio">Rio</option>
              <option value="Mar">Mar</option>
              <option value="Lagoa">Lagoa</option>
              <option value="Represa">Represa</option>
              <option value="PesquePague">Pesque-pague</option>
              <option value="Outro">Outro</option>
            </select>
          </div>
        </div>

        <div class="campo" style="margin-top: 15px;">
          <label for="privacidade-local">Privacidade do local</label>
          <select id="privacidade-local">
            <option value="Exato">Mostrar local exato no link público</option>
            <option value="Cidade">Mostrar apenas cidade/UF</option>
            <option value="Oculto">Ocultar local</option>
          </select>
          <small style="display: block; margin-top: 5px; color: var(--tinta-suave); font-size: 0.66rem;">
            Vale para o link público, o troféu e o PDF. O diário completo continua privado.
          </small>
        </div>

        <div class="campo" style="margin-top: 15px;">
          <label for="periodo">Período</label>
          <select id="periodo">
            <option value="Madrugada">Madrugada</option>
            <option value="Manha" selected>Manhã</option>
            <option value="Tarde">Tarde</option>
            <option value="Noite">Noite</option>
          </select>
        </div>

        <div class="etapa-acoes">
          <span></span>
          <button class="btn btn--primario" type="button" data-avancar>Continuar</button>
        </div>
      </section>

      <section class="painel" aria-labelledby="titulo-condicoes" data-etapa="2" hidden>
        <div class="painel-cabecalho">
          <span class="passo-etiqueta">02</span>
          <div>
            <h2 id="titulo-condicoes">As condições</h2>
            <p>O contexto que transforma uma captura em padrão.</p>
          </div>
        </div>

        <div class="condicoes-grid">
          <div>
            <label for="lua">Lua</label>
            <select id="lua">
              <option value="NaoInformada">Não informada</option>
              <option value="Nova">Nova</option>
              <option value="Crescente">Crescente</option>
              <option value="Cheia">Cheia</option>
              <option value="Minguante">Minguante</option>
            </select>
          </div>
          <div>
            <label for="mare">Maré</label>
            <select id="mare">
              <option value="NaoSeAplica">Não se aplica</option>
              <option value="Vazante">Vazante</option>
              <option value="Enchente">Enchente</option>
              <option value="Cheia">Cheia</option>
              <option value="Seca">Seca</option>
            </select>
          </div>
          <div>
            <label for="clima">Clima</label>
            <select id="clima">
              <option value="NaoInformado">Não informado</option>
              <option value="Sol">Sol</option>
              <option value="Nublado">Nublado</option>
              <option value="Chuva">Chuva</option>
              <option value="Vento">Vento</option>
            </select>
          </div>
          <div>
            <label for="clareza">Água</label>
            <select id="clareza">
              <option value="NaoInformada">Não informada</option>
              <option value="Clara">Clara</option>
              <option value="Turva">Turva</option>
              <option value="Barrenta">Barrenta</option>
            </select>
          </div>
        </div>

        <div class="dica">
          Maré, lua, vento e água são o que permitem comparar seus melhores dias depois. Vale
          preencher mesmo quando você “só sabe que estava bom”.
        </div>

        <div id="defeso-alerta" class="defeso-alerta oculto" role="note"></div>

        <div class="etapa-acoes">
          <button class="btn btn--contorno" type="button" data-voltar>Voltar</button>
          <button class="btn btn--primario" type="button" data-avancar>Continuar</button>
        </div>
      </section>

      <section class="painel" aria-labelledby="titulo-capturas" data-etapa="3" hidden>
        <div class="painel-cabecalho">
          <span class="passo-etiqueta">03</span>
          <div>
            <h2 id="titulo-capturas">As capturas</h2>
            <p>Adicione cada peixe. Uma pescaria pode ter várias capturas.</p>
          </div>
        </div>

        <div class="linha-captura-cabecalho" aria-hidden="true">
          <span>Espécie</span>
          <span>Peso kg</span>
          <span>Comp. cm</span>
          <span>Isca</span>
          <span>Solto</span>
          <span></span>
        </div>
        <div id="lista-capturas"></div>
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 11px;">
          <button type="button" class="botao-adicionar" id="adicionar-captura">Adicionar captura</button>
          <span class="aviso" id="contador-capturas" style="margin: 0;">0 capturas</span>
        </div>

        <div class="dica">
          Foto opcional, mas é ela que deixa o card do troféu especial. A imagem é comprimida no
          navegador antes do envio.
        </div>

        <div class="etapa-acoes">
          <button class="btn btn--contorno" type="button" data-voltar>Voltar</button>
          <button class="btn btn--primario" type="button" data-avancar>Continuar</button>
        </div>
      </section>

      <section class="painel" aria-labelledby="titulo-revisar" data-etapa="4" hidden>
        <div class="painel-cabecalho">
          <span class="passo-etiqueta">04</span>
          <div>
            <h2 id="titulo-revisar">Revisar</h2>
            <p>Confira o que vai para o seu diário.</p>
          </div>
        </div>

        <div class="revisao-resumo">
          <div><span>Local</span><strong id="revisao-local">—</strong></div>
          <div><span>Data</span><strong id="revisao-data">—</strong></div>
          <div><span>Condições</span><strong id="revisao-condicoes">—</strong></div>
          <div><span>Capturas</span><strong id="revisao-capturas">—</strong></div>
          <div><span>Fotos</span><strong id="revisao-fotos">—</strong></div>
        </div>

        <div class="campo" style="margin-top: 18px;">
          <label for="observacoes">Como foi?</label>
          <textarea id="observacoes" rows="4" maxlength="1000" placeholder="Ex.: o peixe bateu no final da manhã, perto da estrutura." style="width: 100%; padding: 11px 12px; border: 1px solid var(--linha-forte); border-radius: 9px; background: var(--papel); color: var(--tinta); font-size: 0.86rem; resize: vertical;"></textarea>
        </div>

        <div class="etapa-acoes">
          <button class="btn btn--contorno" type="button" data-voltar>Voltar</button>
          <button class="btn btn--primario" type="submit" id="btn-salvar">Salvar pescaria</button>
        </div>

        <div id="confirmar-salvar" class="confirmar-salvar oculto" role="status">
          <h3>Seu registro está pronto.</h3>
          <p>Para guardar no diário, entre com sua conta. O que você preencheu continua aqui, sem mudanças.</p>
          <div class="confirmar-acoes">
            <button id="confirmar-entrar" class="btn btn--primario" type="button">Entrar e salvar no diário</button>
            <button id="confirmar-continuar" class="btn btn--contorno" type="button">Continuar aqui</button>
          </div>
        </div>

        <small class="revisao-nota">Diário privado, card do troféu e PDF gratuitos durante a validação.</small>
      </section>
    </form>

    <aside class="cartao-pilha">
      <section class="cartao" style="background: var(--creme);">
        <span class="selo selo--terracota">Sua conta</span>
        <h2 style="margin-top: 12px;">Só você vê o seu diário.</h2>
        <p>
          Cada pescaria tem um link público para compartilhar. O diário completo fica na sua conta,
          protegido pelo seu acesso por e-mail.
        </p>
        <div class="acoes-calculo">
          <a class="btn btn--contorno" href="/meu-diario">Abrir meu diário</a>
        </div>
      </section>

      <section class="cartao">
        <h2>O que o Fisga guarda</h2>
        <div class="mini-tabela">
          <div><span>Local e data</span><strong>Contexto</strong></div>
          <div><span>Condições</span><strong>Padrões</strong></div>
          <div><span>Capturas</span><strong>História</strong></div>
          <div><span>Fotos</span><strong>Troféu</strong></div>
          <div><span>Isca</span><strong>Aprendizado</strong></div>
        </div>
      </section>

      <section class="cartao">
        <h2>Dica de troféu</h2>
        <p>
          Segure o peixe com as duas mãos, limpe as mãos e procure luz natural. O card usa a foto
          como fundo e fecha a composição com espécie, peso e local.
        </p>
      </section>

      <section class="cartao" id="conta-card">
        <h2>Acesso em qualquer aparelho</h2>
        <p>
          Entre com o mesmo e-mail no celular ou no computador e o diário estará lá. Não há link de
          backup para guardar.
        </p>
        <div class="acoes-calculo">
          <a class="btn btn--contorno" href="/conta">Minha conta</a>
        </div>
      </section>
    </aside>
  </section>

  <script type="application/json" id="catalogo-dados" set:html={catalogoJson}></script>

  <script>
    // @ts-nocheck
    import exifr from 'exifr';
    import { CHAVE_RASCUNHO, encerrarSessaoExpirada, limparCachePrivado } from '../lib/auth';

    const API = (document.body.dataset.api || 'http://localhost:5184').replace(/\/$/, '');
    const catalogo = JSON.parse(document.getElementById('catalogo-dados')?.textContent || 'null');
    const formulario = document.getElementById('pescaria-form');
    const listaCapturas = document.getElementById('lista-capturas');
    const contador = document.getElementById('contador-capturas');
    const botaoSalvar = document.getElementById('btn-salvar');
    const painelConfirmacao = document.getElementById('confirmar-salvar');
    const botaoConfirmarEntrar = document.getElementById('confirmar-entrar');
    const botaoConfirmarContinuar = document.getElementById('confirmar-continuar');
    const erroFormulario = document.getElementById('erro-form');
    const indicadorRascunho = document.getElementById('rascunho-indicador');
    const acessoRegistrar = document.getElementById('acesso-registrar');
    const chaveRascunho = CHAVE_RASCUNHO;
    const especieParam = new URLSearchParams(window.location.search).get('especie');
    let estadoEdicao = null;
    let uploadsPendentes = 0;
    let autenticado = false;
    let exifAplicado = false;
    let capturasTocadas = false;
    const camposTocados = new Set();
    let formularioHidratado = false;
    let especiePrimeiraTocada = false;
    let suprimirMarcasTocadas = false;
    let descartarRascunho = false;

    const reais = (valor) =>
      new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(Number(valor || 0));

    function numero(valor) {
      if (typeof valor === 'number') return Number.isFinite(valor) ? valor : 0;
      if (valor === null || valor === undefined) return 0;
      let texto = String(valor).replace(/[^\d,.-]/g, '').trim();
      if (texto.includes(',') && texto.includes('.')) texto = texto.replace(/\./g, '').replace(',', '.');
      else if (texto.includes(',')) texto = texto.replace(',', '.');
      const convertido = Number(texto);
      return Number.isFinite(convertido) ? convertido : 0;
    }

    function valor(id) {
      return document.getElementById(id)?.value ?? '';
    }

    function urlDeRetorno() {
      return `${window.location.pathname}${window.location.search}`;
    }

    function guardarRetorno() {
      try {
        sessionStorage.setItem('fisga:retorno', urlDeRetorno());
      } catch {}
    }

    function irParaEntrar() {
      guardarRetorno();
      window.location.href = `/entrar?voltar=${encodeURIComponent(urlDeRetorno())}`;
    }

    function mostrarConfirmacao() {
      botaoSalvar.classList.add('oculto');
      painelConfirmacao.classList.remove('oculto');
      botaoConfirmarEntrar.focus();
    }

    function fecharConfirmacao() {
      painelConfirmacao.classList.add('oculto');
      botaoSalvar.classList.remove('oculto');
      botaoSalvar.focus();
    }

    botaoConfirmarContinuar.addEventListener('click', fecharConfirmacao);
    botaoConfirmarEntrar.addEventListener('click', () => {
      flushRascunho();
      irParaEntrar();
    });

    function mostrarOuOcultarBannerAutenticacao() {
      acessoRegistrar.classList.toggle('oculto', autenticado);
    }

    function atualizarContador() {
      const total = listaCapturas.querySelectorAll('.linha-captura').length;
      contador.textContent = `${total} ${total === 1 ? 'captura' : 'capturas'}`;
    }

    const MAX_FOTOS = 4;

    function fotosDaLinha(linha) {
      try {
        return JSON.parse(linha.dataset.fotos || '[]');
      } catch {
        return [];
      }
    }

    function capaDaLinha(linha) {
      const fotos = fotosDaLinha(linha);
      const capa = linha.dataset.fotoCapa || '';
      return fotos.includes(capa) ? capa : (fotos[0] || '');
    }

    function definirFotos(linha, fotos, capa) {
      const lista = [...new Set(fotos)].slice(0, MAX_FOTOS);
      const capaFinal = capa && lista.includes(capa) ? capa : (lista[0] || '');
      linha.dataset.fotos = JSON.stringify(lista);
      linha.dataset.fotoCapa = capaFinal;
      renderizarFotos(linha);
    }

    function renderizarFotos(linha) {
      const container = linha.querySelector('.captura-fotos');
      const adicionar = container?.querySelector('.captura-foto-adicionar');
      if (!container || !adicionar) return;

      container.querySelectorAll('.captura-foto-thumb').forEach((thumb) => thumb.remove());
      const fotos = fotosDaLinha(linha);
      const capa = capaDaLinha(linha);

      fotos.forEach((url) => {
        const thumb = document.createElement('div');
        thumb.className = `captura-foto-thumb${url === capa ? ' capa' : ''}`;
        thumb.dataset.url = url;
        thumb.innerHTML = `
          <img src="${API}${url}" alt="Foto da captura" loading="lazy" />
          <button type="button" class="remover-foto" aria-label="Remover foto">×</button>
          ${url === capa ? '<span class="capa-selo">Capa</span>' : ''}
        `;

        thumb.addEventListener('click', (evento) => {
          if (evento.target.closest('.remover-foto')) return;
          capturasTocadas = true;
          linha.dataset.fotoCapa = url;
          renderizarFotos(linha);
          agendarRascunho();
        });

        thumb.querySelector('.remover-foto').addEventListener('click', (evento) => {
          evento.stopPropagation();
          capturasTocadas = true;
          const restantes = fotosDaLinha(linha).filter((foto) => foto !== url);
          definirFotos(linha, restantes, capa === url ? (restantes[0] || '') : capa);
          agendarRascunho();
        });

        container.insertBefore(thumb, adicionar);
      });

      adicionar.classList.toggle('oculto', fotos.length >= MAX_FOTOS);
      const rotulo = adicionar.querySelector('span');
      if (rotulo) rotulo.textContent = fotos.length === 0 ? 'Foto' : '+ Foto';
    }

    function criarLinhaCaptura(dados = {}) {
      const linha = document.createElement('div');
      linha.className = 'linha-captura';
      linha.dataset.id = dados.id || '';
      const fotosIniciais = Array.isArray(dados.fotos) && dados.fotos.length > 0
        ? dados.fotos
        : (dados.fotoUrl ? [dados.fotoUrl] : []);
      linha.dataset.fotos = JSON.stringify(fotosIniciais.slice(0, MAX_FOTOS));
      linha.dataset.fotoCapa = dados.fotoUrl || fotosIniciais[0] || '';

      linha.innerHTML = `
        <input class="captura-especie" type="text" list="lista-especies" placeholder="Espécie" autocomplete="off" aria-label="Espécie" />
        <input class="captura-peso" inputmode="decimal" placeholder="Peso kg" aria-label="Peso em kg" />
        <input class="captura-comprimento" inputmode="decimal" placeholder="Comp. cm" aria-label="Comprimento em cm" />
        <input class="captura-isca" type="text" list="lista-iscas" placeholder="Isca" autocomplete="off" aria-label="Isca" />
        <label class="captura-solto"><input type="checkbox" class="captura-solto-check" /> Solto</label>
        <button class="botao-icone remover" type="button" aria-label="Remover captura">×</button>
        <div class="captura-fotos">
          <label class="captura-foto-adicionar">
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple />
            <span>Foto</span>
          </label>
          <p class="foto-nota" role="status" hidden>A foto entra depois que você entra. O resto do registro continua aqui.</p>
        </div>
        <div class="sugestoes-especie" aria-live="polite"></div>
      `;

      linha.querySelector('.captura-especie').value = dados.especie || '';
      linha.querySelector('.captura-peso').value = dados.pesoKg ? reais(dados.pesoKg) : '';
      linha.querySelector('.captura-comprimento').value = dados.comprimentoCm ? reais(dados.comprimentoCm) : '';
      linha.querySelector('.captura-isca').value = dados.isca || '';
      linha.querySelector('.captura-solto-check').checked = Boolean(dados.solto);
      linha.querySelectorAll('input').forEach((campo) => {
        campo.addEventListener('input', () => {
          if (!suprimirMarcasTocadas) {
            capturasTocadas = true;
            if (campo.classList.contains('captura-especie')
              && listaCapturas.querySelector('.linha-captura') === linha) {
              especiePrimeiraTocada = true;
            }
          }
        });
        campo.addEventListener('change', () => {
          if (!suprimirMarcasTocadas) capturasTocadas = true;
        });
      });

      const inputArquivo = linha.querySelector('input[type="file"]');
      const notaFoto = linha.querySelector('.foto-nota');
      linha.querySelector('.captura-foto-adicionar').addEventListener('click', (evento) => {
        if (autenticado) return;
        evento.preventDefault();
        notaFoto.hidden = false;
      });
      inputArquivo.addEventListener('change', async () => {
        if (!autenticado) {
          inputArquivo.value = '';
          notaFoto.hidden = false;
          return;
        }

        const arquivos = [...(inputArquivo.files || [])];
        if (arquivos.length === 0) return;

        const disponiveis = MAX_FOTOS - fotosDaLinha(linha).length;
        if (disponiveis <= 0) {
          mostrarErro('Máximo de 4 fotos por captura.');
          inputArquivo.value = '';
          return;
        }

        const paraEnviar = arquivos.slice(0, disponiveis);
        if (arquivos.length > disponiveis) {
          mostrarErro('Máximo de 4 fotos por captura. As extras foram ignoradas.');
        }

        uploadsPendentes += 1;
        botaoSalvar.disabled = true;
        inputArquivo.disabled = true;

        try {
          if (!exifAplicado && paraEnviar[0]) {
            await aplicarExif(paraEnviar[0]);
          }

          for (const arquivo of paraEnviar) {
            const blob = await comprimirImagem(arquivo);
            const formularioMidia = new FormData();
            formularioMidia.append('arquivo', blob, 'foto.jpg');

            const resposta = await fetch(`${API}/api/midia`, {
              method: 'POST',
              credentials: 'include',
              body: formularioMidia
            });

            if (resposta.status === 401) {
              // A navegação dispensa o rascunho: o flush de saída não pode recriá-lo.
              descartarRascunho = true;
              await encerrarSessaoExpirada(urlDeRetorno());
              return;
            }

            const dadosMidia = await resposta.json().catch(() => ({}));
            if (!resposta.ok) throw new Error(dadosMidia.detalhe || 'Não foi possível enviar a foto.');

            const fotos = fotosDaLinha(linha);
            if (fotos.length >= MAX_FOTOS) break;
            fotos.push(dadosMidia.url);
            definirFotos(linha, fotos, capaDaLinha(linha) || dadosMidia.url);
            agendarRascunho();
            await sugerirEspecie(linha, blob);
          }
        } catch (erro) {
          mostrarErro(erro instanceof Error ? erro.message : 'Não foi possível enviar a foto.');
        } finally {
          uploadsPendentes -= 1;
          inputArquivo.disabled = false;
          inputArquivo.value = '';
          botaoSalvar.disabled = uploadsPendentes > 0;
        }
      });

      linha.querySelector('.remover').addEventListener('click', () => {
        capturasTocadas = true;
        linha.remove();
        atualizarContador();
        agendarRascunho();
      });

      renderizarFotos(linha);
      listaCapturas.appendChild(linha);
      atualizarContador();
    }

    function periodoDaHora(hora) {
      if (hora < 6) return 'Madrugada';
      if (hora < 12) return 'Manha';
      if (hora < 18) return 'Tarde';
      return 'Noite';
    }

    async function aplicarExif(arquivo) {
      if (exifAplicado) return;

      try {
        const dados = await exifr.parse(arquivo, { pick: ['DateTimeOriginal', 'CreateDate'] }).catch(() => null);
        const gps = await exifr.gps(arquivo).catch(() => null);

        let data = null;
        const bruto = dados?.DateTimeOriginal ?? dados?.CreateDate;
        if (bruto instanceof Date && !Number.isNaN(bruto.getTime())) {
          data = bruto;
          const local = new Date(data.getTime() - data.getTimezoneOffset() * 60000);
          document.getElementById('data').value = local.toISOString().slice(0, 10);
          document.getElementById('periodo').value = periodoDaHora(local.getHours());
        }

        let cidade = '';
        let estado = '';
        if (gps?.latitude && gps?.longitude) {
          const resposta = await fetch(
            `${API}/api/locais/reverso?lat=${gps.latitude}&lon=${gps.longitude}`
          );
          if (resposta.ok) {
            const local = await resposta.json();
            cidade = local.cidade || local.nome || '';
            estado = local.estado || '';
            if (cidade) {
              const campoCidade = document.getElementById('cidade');
              const campoEstado = document.getElementById('estado');
              const campoLocal = document.getElementById('local');
              if (!campoCidade.value) campoCidade.value = cidade;
              if (!campoEstado.value) campoEstado.value = estado;
              if (!campoLocal.value.trim()) campoLocal.value = cidade;
            }
          }
        }

        if (data || cidade) {
          exifAplicado = true;
          const partes = [];
          if (data) partes.push(data.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }));
          if (cidade) partes.push([cidade, estado].filter(Boolean).join(' · '));
          const banner = document.getElementById('exif-aviso');
          const texto = document.getElementById('exif-texto');
          if (banner && texto) {
            texto.textContent = `Dados lidos da foto: ${partes.join(' · ')}. Confirme antes de salvar. O GPS é usado apenas para sugerir a cidade.`;
            banner.classList.remove('oculto');
          }
        }
      } catch {
        // A foto pode não ter EXIF; o formulário continua manual.
      }
    }

    async function sugerirEspecie(linha, blob) {
      const container = linha.querySelector('.sugestoes-especie');
      if (!container) return;

      try {
        const formularioSugestao = new FormData();
        formularioSugestao.append('arquivo', blob, 'foto.jpg');
        const resposta = await fetch(`${API}/api/especies/sugerir`, {
          method: 'POST',
          credentials: 'include',
          body: formularioSugestao
        });

        if (!resposta.ok) return;
        const dados = await resposta.json();
        container.innerHTML = '';

        if (!dados.disponivel) {
          const aviso = document.createElement('span');
          aviso.className = 'sugestao-aviso';
          aviso.textContent = dados.mensagem || 'Sugestão automática indisponível. Confirme a espécie.';
          container.appendChild(aviso);
          return;
        }

        if (!Array.isArray(dados.sugestoes) || dados.sugestoes.length === 0) {
          const aviso = document.createElement('span');
          aviso.className = 'sugestao-aviso';
          aviso.textContent = dados.mensagem || 'Nenhuma sugestão segura. Confirme a espécie.';
          container.appendChild(aviso);
          return;
        }

        const rotulo = document.createElement('span');
        rotulo.textContent = 'Sugestão:';
        container.appendChild(rotulo);

        for (const sugestao of dados.sugestoes) {
          const botao = document.createElement('button');
          botao.type = 'button';
          botao.className = 'sugestao-chip';
          botao.textContent = `${sugestao.especie} · ${Math.round(sugestao.confianca * 100)}%`;
          botao.addEventListener('click', () => {
            const input = linha.querySelector('.captura-especie');
            if (input) {
              input.value = sugestao.especie;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
            container.innerHTML = '';
          });
          container.appendChild(botao);
        }
      } catch {
        // A sugestão é opcional; o preenchimento manual continua.
      }
    }

    function atualizarDefeso() {
      const alerta = document.getElementById('defeso-alerta');
      if (!alerta) return;

      const especieInput = document.querySelector('.captura-especie');
      const especie = especieInput?.value.trim() || '';
      const estado = document.getElementById('estado').value.trim().toUpperCase();

      if (!especie || estado.length !== 2) {
        alerta.classList.add('oculto');
        return;
      }

      alerta.innerHTML = '';
      const texto = document.createElement('span');
      texto.textContent = `Antes de manter: confira tamanho mínimo e defeso de ${especie} em ${estado}.`;
      const link = document.createElement('a');
      link.href = `/ferramentas/defeso?uf=${encodeURIComponent(estado)}`;
      link.textContent = 'Abrir órgão oficial';
      alerta.append(texto, link);
      alerta.classList.remove('oculto');
    }

    async function comprimirImagem(arquivo) {
      const bitmap = await createImageBitmap(arquivo);
      const escala = Math.min(1, 1400 / Math.max(bitmap.width, bitmap.height));
      const largura = Math.max(1, Math.round(bitmap.width * escala));
      const altura = Math.max(1, Math.round(bitmap.height * escala));
      const canvas = document.createElement('canvas');
      canvas.width = largura;
      canvas.height = altura;
      const contexto = canvas.getContext('2d');
      contexto.drawImage(bitmap, 0, 0, largura, altura);
      bitmap.close?.();

      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => (blob ? resolve(blob) : reject(new Error('Não foi possível processar a foto.'))),
          'image/jpeg',
          0.82
        );
      });
    }

    function coletar() {
      const capturas = [...listaCapturas.querySelectorAll('.linha-captura')]
        .map((linha) => ({
          id: linha.dataset.id || null,
          especie: linha.querySelector('.captura-especie').value.trim(),
          pesoKg: numero(linha.querySelector('.captura-peso').value),
          comprimentoCm: numero(linha.querySelector('.captura-comprimento').value),
          isca: linha.querySelector('.captura-isca').value.trim() || null,
          solto: linha.querySelector('.captura-solto-check').checked,
          fotoUrl: capaDaLinha(linha) || null,
          fotos: fotosDaLinha(linha),
          observacao: null
        }))
        .filter((captura) =>
          captura.especie || captura.pesoKg || captura.comprimentoCm
          || captura.isca || captura.solto || captura.fotoUrl
          || captura.fotos.length || captura.observacao
        );

      return {
        local: valor('local').trim(),
        pescador: valor('pescador').trim() || null,
        cidade: valor('cidade').trim() || null,
        estado: valor('estado').trim().toUpperCase() || null,
        ambiente: valor('ambiente'),
        data: valor('data'),
        periodo: valor('periodo'),
        mare: valor('mare'),
        lua: valor('lua'),
        clima: valor('clima'),
        clarezaDaAgua: valor('clareza'),
        privacidadeDoLocal: valor('privacidade-local') || 'Exato',
        observacoes: valor('observacoes').trim() || null,
        capturas
      };
    }

    function assinaturaCaptura(captura) {
      return JSON.stringify({
        especie: captura.especie || '',
        pesoKg: captura.pesoKg || 0,
        comprimentoCm: captura.comprimentoCm || 0,
        isca: captura.isca || '',
        solto: Boolean(captura.solto),
        fotoUrl: captura.fotoUrl || '',
        fotos: captura.fotos || [],
        observacao: captura.observacao || null
      });
    }

    function assinaturaLinha(linha) {
      return assinaturaCaptura({
        especie: linha.querySelector('.captura-especie').value.trim(),
        pesoKg: numero(linha.querySelector('.captura-peso').value),
        comprimentoCm: numero(linha.querySelector('.captura-comprimento').value),
        isca: linha.querySelector('.captura-isca').value.trim(),
        solto: linha.querySelector('.captura-solto-check').checked,
        fotoUrl: capaDaLinha(linha),
        fotos: fotosDaLinha(linha),
        observacao: null
      });
    }

    function preencher(entrada, opcoes = {}) {
      if (!entrada) return;
      formularioHidratado = true;
      const preservarTocados = opcoes.preservarTocados !== false;
      const preservarCapturas = opcoes.preservarCapturas === true;
      const definir = (id, valor) => {
        if (!preservarTocados || !camposTocados.has(id)) {
          document.getElementById(id).value = valor;
        }
      };

      definir('local', entrada.local || '');
      definir('pescador', entrada.pescador || '');
      definir('cidade', entrada.cidade || '');
      definir('estado', entrada.estado || '');
      definir('ambiente', entrada.ambiente || 'Represa');
      definir('data', entrada.data || new Date().toISOString().slice(0, 10));
      definir('periodo', entrada.periodo || 'Manha');
      definir('mare', entrada.mare || 'NaoSeAplica');
      definir('lua', entrada.lua || 'NaoInformada');
      definir('clima', entrada.clima || 'NaoInformado');
      definir('clareza', entrada.clarezaDaAgua || 'NaoInformada');
      definir('privacidade-local', entrada.privacidadeDoLocal || 'Exato');
      definir('observacoes', entrada.observacoes || '');

      if (!preservarCapturas) {
        if (capturasTocadas) {
          const existentes = new Set(
            [...listaCapturas.querySelectorAll('.linha-captura')].map(assinaturaLinha)
          );
          (entrada.capturas || []).forEach((captura) => {
            const assinatura = assinaturaCaptura(captura);
            if (existentes.has(assinatura)) return;
            criarLinhaCaptura(captura);
            existentes.add(assinatura);
          });
          if (!listaCapturas.querySelector('.linha-captura')) criarLinhaCaptura();
        } else {
          listaCapturas.innerHTML = '';
          (entrada.capturas || []).forEach((captura) => criarLinhaCaptura(captura));
          if (!entrada.capturas || entrada.capturas.length === 0) criarLinhaCaptura();
        }
      }

      atualizarContador();
      atualizarDefeso();
    }

    function periodoDeAgora() {
      const hora = new Date().getHours();
      if (hora < 6) return 'Madrugada';
      if (hora < 12) return 'Manha';
      if (hora < 18) return 'Tarde';
      return 'Noite';
    }

    function climaDe(tempo) {
      if (tempo.chuvaProbabilidade >= 60) return 'Chuva';
      if (tempo.ventoKmh >= 25) return 'Vento';
      if (tempo.chuvaProbabilidade >= 30) return 'Nublado';
      return 'Sol';
    }

    async function buscarCondicoesDaUrl() {
      const params = new URLSearchParams(window.location.search);
      if (!params.get('lat') || !params.get('lon')) return null;

      try {
        const resposta = await fetch(`${API}/api/condicoes?${params.toString()}`);
        if (!resposta.ok) return null;
        const condicoes = await resposta.json();

        const agora = new Date();
        let mare = 'NaoSeAplica';
        if (condicoes.temMare && condicoes.mare) {
          mare = condicoes.mare.estado === 'subindo'
            ? 'Enchente'
            : condicoes.mare.estado === 'descendo'
              ? 'Vazante'
              : 'Cheia';
          const proximo = condicoes.mare.proximoEvento;
          if (proximo) {
            const diferenca = (new Date(proximo.hora).getTime() - agora.getTime()) / 3600000;
            if (diferenca >= 0 && diferenca <= 1) {
              mare = proximo.tipo === 'Cheia' ? 'Cheia' : 'Seca';
            }
          }
        }

        const atualizado = new Intl.DateTimeFormat('pt-BR', {
          day: '2-digit',
          month: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        }).format(new Date(condicoes.atualizadoEm));
        const mareTexto = condicoes.temMare
          ? mare === 'Enchente'
            ? 'maré enchendo'
            : mare === 'Vazante'
              ? 'maré vazando'
              : 'maré parada'
          : 'sem maré';

        return {
          entrada: {
            local: params.get('nome') || condicoes.local.nome,
            cidade: params.get('cidade') || condicoes.local.cidade || '',
            estado: params.get('estado') || condicoes.local.estado || '',
            ambiente: params.get('ambiente') || condicoes.local.ambiente || '',
            data: dataHojeLocal(),
            periodo: periodoDeAgora(),
            mare,
            lua: condicoes.solunar.fase || 'NaoInformada',
            clima: climaDe(condicoes.tempo)
          },
          texto: `${condicoes.local.nome} · ${atualizado} · ${mareTexto} · ${condicoes.solunar.faseNome.toLowerCase()} · vento ${Math.round(condicoes.tempo.ventoKmh)} km/h`
        };
      } catch {
        return null;
      }
    }

    function mesclarCondicoesComRascunho(condicoes, rascunho) {
      const entrada = { ...condicoes.entrada };
      Object.keys(rascunho || {}).forEach((chave) => {
        const semValorDaUrl = entrada[chave] === undefined || entrada[chave] === '';
        if (semValorDaUrl && rascunho[chave] !== undefined) {
          entrada[chave] = rascunho[chave];
        }
      });
      return entrada;
    }

    function mostrarCondicoesAplicadas(texto) {
      const banner = document.getElementById('condicoes-aplicadas');
      const destino = document.getElementById('condicoes-texto');
      if (!banner || !destino) return;
      destino.textContent = `Os valores do link vieram na frente do seu rascunho; o que você já tinha digitado continua aqui. ${texto}`;
      banner.classList.remove('oculto');
    }

    function dataHojeLocal() {
      const agora = new Date();
      const local = new Date(agora.getTime() - agora.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 10);
    }

    function iniciarFormularioVazio() {
      formularioHidratado = true;
      if (!camposTocados.has('data')) {
        document.getElementById('data').value = dataHojeLocal();
      }
      criarLinhaCaptura();
    }

    function aplicarEspecieDaWiki() {
      if (!especieParam || especiePrimeiraTocada) return;
      const primeira = listaCapturas.querySelector('.captura-especie');
      if (primeira) {
        primeira.value = especieParam;
        // O input sintético serve só para o autosave; não é toque da pessoa.
        suprimirMarcasTocadas = true;
        try {
          primeira.dispatchEvent(new Event('input', { bubbles: true }));
        } finally {
          suprimirMarcasTocadas = false;
        }
      }
    }

    function mostrarErro(mensagem) {
      erroFormulario.textContent = mensagem;
      erroFormulario.classList.toggle('visivel', Boolean(mensagem));
    }

    function atualizarIndicadorRascunho() {
      if (!indicadorRascunho) return;
      let atualizadoEm = null;
      try {
        atualizadoEm = JSON.parse(localStorage.getItem(chaveRascunho) || 'null')?.atualizadoEm;
      } catch {
        // Sem rascunho legível: o indicador fica vazio.
      }
      const data = atualizadoEm ? new Date(atualizadoEm) : null;
      if (!data || Number.isNaN(data.getTime())) {
        indicadorRascunho.textContent = '';
        return;
      }
      const hora = new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit' }).format(data);
      indicadorRascunho.textContent = `✓ Rascunho salvo neste aparelho · ${hora}`;
    }

    function salvarRascunho() {
      if (descartarRascunho) return;
      // Antes da hidratação, um flush de saída gravaria um formulário vazio.
      if (!formularioHidratado && camposTocados.size === 0 && !capturasTocadas) return;
      try {
        localStorage.setItem(chaveRascunho, JSON.stringify({ entrada: coletar(), atualizadoEm: new Date().toISOString() }));
        atualizarIndicadorRascunho();
      } catch {
        // Sem localStorage: o formulário continua funcionando.
      }
    }

    let timerRascunho = 0;
    function agendarRascunho() {
      window.clearTimeout(timerRascunho);
      timerRascunho = window.setTimeout(salvarRascunho, 500);
    }

    function flushRascunho() {
      window.clearTimeout(timerRascunho);
      salvarRascunho();
    }

    window.addEventListener('pagehide', flushRascunho);
    window.addEventListener('beforeunload', flushRascunho);
    window.addEventListener('fisga:logout', () => {
      descartarRascunho = true;
      window.clearTimeout(timerRascunho);
      try {
        localStorage.removeItem(chaveRascunho);
      } catch {
        // Sem localStorage: a limpeza assíncrona do logout cuida do resto.
      }
    });

    function restaurarRascunho() {
      const bruto = localStorage.getItem(chaveRascunho);
      return bruto ? JSON.parse(bruto)?.entrada : null;
    }

    async function iniciarEdicao() {
      const params = new URLSearchParams(window.location.search);
      const id = params.get('editar');
      if (!id) return false;

      try {
        const resposta = await fetch(`${API}/api/pescarias/${encodeURIComponent(id)}/editar`, {
          credentials: 'include'
        });

        if (resposta.status === 401) {
          descartarRascunho = true;
          await encerrarSessaoExpirada(urlDeRetorno());
          return true;
        }

        const dados = await resposta.json().catch(() => ({}));
        if (!resposta.ok) {
          mostrarErro(dados.detalhe || 'Pescaria não encontrada.');
          return false;
        }

        estadoEdicao = { id: dados.id, shareToken: dados.shareToken };
        exifAplicado = true;
        preencher(dados.entrada);
        botaoSalvar.textContent = 'Salvar alterações';
        return true;
      } catch {
        mostrarErro('Não foi possível carregar a pescaria para edição.');
        return false;
      }
    }

    document.getElementById('ocultar-condicoes')?.addEventListener('click', () => {
      document.getElementById('condicoes-aplicadas')?.classList.add('oculto');
    });

    document.getElementById('ocultar-exif')?.addEventListener('click', () => {
      document.getElementById('exif-aviso')?.classList.add('oculto');
    });

    formulario.addEventListener('input', atualizarDefeso);
    formulario.addEventListener('change', atualizarDefeso);

    document.getElementById('adicionar-captura').addEventListener('click', () => {
      capturasTocadas = true;
      criarLinhaCaptura();
      listaCapturas.lastElementChild?.querySelector('.captura-especie')?.focus();
    });

    function marcarCampo(evento) {
      if (suprimirMarcasTocadas) return;
      const id = evento.target?.id;
      if (id) camposTocados.add(id);
    }

    formulario.addEventListener('input', (evento) => {
      marcarCampo(evento);
      agendarRascunho();
    });

    formulario.addEventListener('change', (evento) => {
      marcarCampo(evento);
      agendarRascunho();
    });

    let etapaAtual = 1;
    const etapas = [...formulario.querySelectorAll('[data-etapa]')];
    const botoesEtapa = [...formulario.querySelectorAll('[data-etapa-botao]')];

    function textoSelecionado(id) {
      return document.getElementById(id)?.selectedOptions?.[0]?.textContent?.trim() ?? '';
    }

    function atualizarRevisao() {
      const entrada = coletar();
      const local = [entrada.local || 'Sem local', entrada.cidade, entrada.estado]
        .filter(Boolean)
        .join(' · ');

      const data = entrada.data
        ? new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
            .format(new Date(`${entrada.data}T12:00:00`))
        : 'Sem data';

      const condicoes = ['mare', 'lua', 'clima', 'clareza']
        .map(textoSelecionado)
        .filter((texto) => texto && !/^não (informad|se aplica)/i.test(texto))
        .join(' · ') || 'Não informadas';

      const totalCapturas = entrada.capturas.length;
      const especies = [...new Set(entrada.capturas.map((captura) => captura.especie).filter(Boolean))];
      const capturas = totalCapturas
        ? `${totalCapturas} ${totalCapturas === 1 ? 'captura' : 'capturas'}${especies.length ? ` · ${especies.slice(0, 3).join(', ')}` : ''}`
        : 'Nenhuma captura';

      const totalFotos = [...listaCapturas.querySelectorAll('.linha-captura')]
        .reduce((soma, linha) => soma + fotosDaLinha(linha).length, 0);

      const alvo = (id, texto) => {
        const elemento = document.getElementById(id);
        if (elemento) elemento.textContent = texto;
      };
      alvo('revisao-local', local);
      alvo('revisao-data', data);
      alvo('revisao-condicoes', condicoes);
      alvo('revisao-capturas', capturas);
      alvo('revisao-fotos', totalFotos ? `${totalFotos} ${totalFotos === 1 ? 'foto' : 'fotos'}` : 'Sem fotos');
    }

    function validarEtapa(numeroDaEtapa) {
      if (numeroDaEtapa === 1) {
        const local = document.getElementById('local');
        if (!local.value.trim()) {
          mostrarErro('Informe o local da pescaria.');
          mostrarEtapa(1);
          local.focus();
          return false;
        }

        const data = document.getElementById('data');
        if (!data.value) {
          mostrarErro('Informe a data da pescaria.');
          mostrarEtapa(1);
          data.focus();
          return false;
        }
      }

      mostrarErro('');
      return true;
    }

    function mostrarEtapa(numeroDaEtapa) {
      etapaAtual = Math.min(4, Math.max(1, numeroDaEtapa));

      for (const etapa of etapas) {
        etapa.hidden = Number(etapa.dataset.etapa) !== etapaAtual;
      }
      for (const botao of botoesEtapa) {
        if (Number(botao.dataset.etapaBotao) === etapaAtual) botao.setAttribute('aria-current', 'step');
        else botao.removeAttribute('aria-current');
      }

      if (etapaAtual === 4) atualizarRevisao();

      const topo = formulario.getBoundingClientRect().top + window.scrollY - 84;
      window.scrollTo({ top: Math.max(0, topo), behavior: 'smooth' });
    }

    for (const botao of botoesEtapa) {
      botao.addEventListener('click', () => {
        const destino = Number(botao.dataset.etapaBotao);
        if (destino > 1 && !validarEtapa(1)) return;
        mostrarEtapa(destino);
      });
    }

    formulario.querySelectorAll('[data-avancar]').forEach((botao) => {
      botao.addEventListener('click', () => {
        if (validarEtapa(etapaAtual)) mostrarEtapa(etapaAtual + 1);
      });
    });

    formulario.querySelectorAll('[data-voltar]').forEach((botao) => {
      botao.addEventListener('click', () => mostrarEtapa(etapaAtual - 1));
    });

    formulario.addEventListener('input', () => {
      if (etapaAtual === 4) atualizarRevisao();
    });

    formulario.addEventListener('change', () => {
      if (etapaAtual === 4) atualizarRevisao();
    });

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();

      if (!autenticado) {
        mostrarConfirmacao();
        return;
      }

      if (uploadsPendentes > 0) {
        mostrarErro('Espere o envio das fotos terminar.');
        return;
      }

      const entrada = coletar();
      if (!entrada.local) {
        mostrarErro('Informe o local da pescaria.');
        return;
      }

      const textoOriginal = botaoSalvar.textContent;
      botaoSalvar.disabled = true;
      botaoSalvar.textContent = 'Salvando...';
      mostrarErro('');

      try {
        const editando = Boolean(estadoEdicao);
        const url = editando ? `${API}/api/pescarias/${estadoEdicao.id}` : `${API}/api/pescarias`;
        const resposta = await fetch(url, {
          method: editando ? 'PUT' : 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(entrada)
        });

        if (resposta.status === 401) {
          // Sessão expirada: aqui sim o rascunho privado é apagado. A navegação
          // explícita para /registrar sem sessão (200 anônimo) mantém o rascunho
          // para o pescador continuar depois de entrar. O flush de saída não
          // pode recriar o rascunho apagado pela sessão expirada.
          descartarRascunho = true;
          await encerrarSessaoExpirada(urlDeRetorno());
          return;
        }

        const dados = await resposta.json().catch(() => ({}));
        if (!resposta.ok) throw new Error(dados.detalhe || 'Não foi possível salvar a pescaria.');

        const shareToken = editando ? estadoEdicao.shareToken : dados.shareToken;

        descartarRascunho = true;
        window.clearTimeout(timerRascunho);
        try {
          localStorage.removeItem(chaveRascunho);
          atualizarIndicadorRascunho();
        } catch {
          // A pescaria já está salva no servidor.
        }

        window.location.href = `/p/${shareToken}?${editando ? 'atualizado' : 'novo'}=1`;
      } catch (erro) {
        mostrarErro(erro instanceof Error ? erro.message : 'Não foi possível salvar a pescaria.');
        botaoSalvar.disabled = false;
        botaoSalvar.textContent = textoOriginal;
      }
    });

    // A leitura e a hidratação do rascunho acontecem antes de qualquer await:
    // assim um flush de saída durante a inicialização nunca grava um form vazio.
    let rascunhoInicial = null;
    let falhaLeituraRascunho = false;
    let hidratadoSincronamente = false;
    try {
      rascunhoInicial = restaurarRascunho();
    } catch {
      falhaLeituraRascunho = true;
    }
    if (rascunhoInicial && !new URLSearchParams(window.location.search).get('editar')) {
      preencher(rascunhoInicial, { preservarTocados: true });
      hidratadoSincronamente = true;
      exifAplicado = true;
      atualizarIndicadorRascunho();
    }

    (async function iniciar() {
      try {
        const resposta = await fetch(`${API}/api/auth/me`, { credentials: 'include' });
        if (resposta.status === 401) {
          descartarRascunho = true;
          await encerrarSessaoExpirada(urlDeRetorno());
          return;
        }

        const dados = await resposta.json().catch(() => ({}));
        autenticado = Boolean(dados.autenticado);
        if (autenticado && dados.consentimentoPendente) {
          window.location.replace(
            '/aceite?destino=' + encodeURIComponent(window.location.pathname + window.location.search)
          );
          return;
        }
      } catch {
        autenticado = false;
      }

      const params = new URLSearchParams(window.location.search);
      if (params.get('editar') && autenticado) {
        await iniciarEdicao();
        return;
      }

      mostrarOuOcultarBannerAutenticacao();

      if (!autenticado) {
        // Navegação sem sessão: o formulário fica ativo e o estado da conta é
        // limpo, mas o rascunho não salvo é preservado para continuar depois.
        // Só o logout explícito apaga o rascunho.
        await limparCachePrivado({ preservarRascunho: true });
      }

      if (falhaLeituraRascunho) {
        mostrarErro('Não conseguimos recuperar o rascunho. Você pode continuar preenchendo.');
        iniciarFormularioVazio();
        aplicarEspecieDaWiki();
        return;
      }

      const rascunho = rascunhoInicial;
      if (rascunho) {
        exifAplicado = true;
        atualizarIndicadorRascunho();
      }

      // A hidratação síncrona já trouxe as capturas do rascunho para o DOM.
      // Refazer a mesclagem aqui reintroduziria a captura original quando a
      // pessoa editou algum valor durante a inicialização assíncrona.
      const opcoesPreenchimento = { preservarTocados: true, preservarCapturas: hidratadoSincronamente };
      const condicoes = await buscarCondicoesDaUrl();
      if (condicoes) {
        preencher(mesclarCondicoesComRascunho(condicoes, rascunho), opcoesPreenchimento);
        mostrarCondicoesAplicadas(condicoes.texto);
      } else if (rascunho) {
        preencher(rascunho, opcoesPreenchimento);
      } else {
        iniciarFormularioVazio();
      }

      aplicarEspecieDaWiki();
    })();
  </script>
</Layout>

