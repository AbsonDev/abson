---
interface Props {
  tipo?: 'peixe' | 'var' | 'anzol' | 'mapa' | 'escudo' | 'livro' | 'busca';
}

const { tipo = 'peixe' } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {tipo === 'peixe' && (
    <>
      <path d="M3 12.2c3.1-4.2 8.1-5.4 12.2-2.8l4.3-3v11.2l-4.3-3c-4.1 2.6-9.1 1.4-12.2-2.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="8.6" cy="11" r="1.1" fill="currentColor" />
    </>
  )}
  {tipo === 'var' && (
    <>
      <path d="M5 19 18.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M15.5 5.5h3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M5 19c2.5-1 4.2-2.7 5.2-5.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </>
  )}
  {tipo === 'anzol' && (
    <>
      <path d="M12 4v9.5a4.5 4.5 0 0 0 9 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="m9 4 3-2 3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="12" cy="15" r="1.1" fill="currentColor" />
    </>
  )}
  {tipo === 'mapa' && (
    <>
      <path d="m3.5 6.5 5-2 7 2 5-2v15l-5 2-7-2-5 2v-15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M8.5 4.5v15M15.5 6.5v15" stroke="currentColor" stroke-width="1.3" opacity=".55" />
    </>
  )}
  {tipo === 'escudo' && (
    <>
      <path d="M12 3 20 6v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="m8.8 12 2.2 2.2 4.4-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {tipo === 'livro' && (
    <>
      <path d="M4 5.5c3-1.4 5.5-1.4 8 .5 2.5-1.9 5-1.9 8-.5v13c-3-1.4-5.5-1.4-8 .5-2.5-1.9-5-1.9-8-.5v-13Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M12 6v13" stroke="currentColor" stroke-width="1.3" opacity=".55" />
    </>
  )}
  {tipo === 'busca' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" />
      <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </>
  )}
</svg>
