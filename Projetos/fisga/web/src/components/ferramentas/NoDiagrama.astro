---
interface Props {
  tipo: 'laco' | 'encontro' | 'aco' | 'carretel';
}

const { tipo } = Astro.props;
---

<svg class="no-diagrama" viewBox="0 0 220 120" aria-hidden="true">
  <rect x="0" y="0" width="220" height="120" rx="12" fill="var(--creme)" />

  {tipo === 'laco' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="162" cy="58" r="10" stroke="var(--tinta-suave)" stroke-width="2" />
      <path d="M18 76 C62 76, 84 38, 126 48" stroke="var(--terracota)" stroke-width="3" />
      <path d="M126 48 C150 54, 142 78, 118 82 C100 85, 94 66, 112 58" stroke="var(--terracota)" stroke-width="2.4" />
      <path d="M126 48 C140 44, 154 52, 158 58" stroke="var(--terracota)" stroke-width="2.4" />
    </g>
  )}

  {tipo === 'encontro' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 52 C58 52, 84 48, 108 48" stroke="var(--terracota)" stroke-width="3" />
      <path d="M208 68 C162 68, 136 72, 112 72" stroke="var(--tinta-suave)" stroke-width="3" />
      <path d="M96 48 C108 40, 122 40, 132 48 C122 56, 108 56, 96 48" stroke="var(--terracota)" stroke-width="2" />
      <path d="M88 72 C100 64, 114 64, 124 72 C114 80, 100 80, 88 72" stroke="var(--tinta-suave)" stroke-width="2" />
    </g>
  )}

  {tipo === 'aco' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 60 C42 60, 60 60, 86 60" stroke="var(--tinta-suave)" stroke-width="3" />
      <path d="M86 60 C100 46, 116 74, 130 60 C144 46, 160 74, 174 60" stroke="var(--terracota)" stroke-width="3" />
      <path d="M174 60 C188 60, 198 60, 208 60" stroke="var(--terracota)" stroke-width="3" />
      <circle cx="130" cy="60" r="4" fill="var(--terracota)" stroke="none" />
    </g>
  )}

  {tipo === 'carretel' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="110" cy="60" rx="50" ry="30" stroke="var(--tinta-suave)" stroke-width="2" />
      <ellipse cx="110" cy="60" rx="26" ry="16" stroke="var(--tinta-suave)" stroke-width="2" />
      <path d="M18 84 C48 84, 70 70, 86 62" stroke="var(--terracota)" stroke-width="3" />
      <path d="M86 62 C98 56, 106 50, 110 44" stroke="var(--terracota)" stroke-width="2.4" />
    </g>
  )}

  <text x="14" y="24" fill="var(--tinta-suave)" font-size="9" font-family="Inter, sans-serif" letter-spacing="1.2">
    DIAGRAMA ESQUEMÁTICO
  </text>
</svg>

<style>
  .no-diagrama {
    width: 100%;
    height: auto;
    border: 1px solid var(--linha);
    border-radius: 12px;
  }
</style>
