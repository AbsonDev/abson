FROM node:24-slim AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG PUBLIC_API_URL=http://localhost:5184
ARG PUBLIC_SITE_URL=http://localhost:4323
ARG PUBLIC_SENTRY_DSN=
ARG SENTRY_ENVIRONMENT=production
ARG SENTRY_RELEASE=
ARG PUBLIC_SENTRY_RELEASE=
ARG SENTRY_AUTH_TOKEN=
ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV PUBLIC_SENTRY_DSN=$PUBLIC_SENTRY_DSN
ENV PUBLIC_SENTRY_ENVIRONMENT=$SENTRY_ENVIRONMENT
ENV PUBLIC_SENTRY_RELEASE=${PUBLIC_SENTRY_RELEASE:-$SENTRY_RELEASE}
RUN SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN npm run build

FROM node:24-alpine AS final
ARG GIT_SHA=
ARG SOURCE_COMMIT=
ENV GIT_SHA=${GIT_SHA:-$SOURCE_COMMIT}
ENV SENTRY_RELEASE=$GIT_SHA
WORKDIR /app

RUN apk add --no-cache curl

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4323

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./

EXPOSE 4323
CMD ["node", "./dist/server/entry.mjs"]
