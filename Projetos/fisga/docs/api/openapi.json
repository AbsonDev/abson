  "components": {
    "schemas": {
      "AlterarSenhaRequest": {
        "required": [
          "senhaAtual",
          "novaSenha"
        ],
        "type": "object",
        "properties": {
          "senhaAtual": {
            "type": [
              "null",
              "string"
            ]
          },
          "novaSenha": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AmbienteDePesca": {
        "enum": [
          "Rio",
          "Mar",
          "Lagoa",
          "Represa",
          "PesquePague",
          "Outro"
        ]
      },
      "AtualizarPerfilRequest": {
        "required": [
          "nome",
          "aceitaNovidades"
        ],
        "type": "object",
