# ===== API =====
# Produção (Coolify): use ASPNETCORE_ENVIRONMENT=Production.
# NUNCA exponha Development em produção: /api/auth/solicitar devolve
# linkDesenvolvimento, um vetor de tomada de conta.
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=Postgres
Database__ConnectionString=Host=localhost;Port=5435;Database=fisga;Username=fisga;Password=fisga
Cors__AllowedOrigins=http://localhost:4323,http://localhost:4324,http://localhost:3002
Web__Url=http://localhost:4323
Auth__LinkBaseUrl=http://localhost:5184
Auth__WebUrl=http://localhost:4323
Auth__CookieSecure=false
Auth__LegacyCookieName=fisga_sessao
DataProtection__KeysPath=data/keys
Google__ClientId=
Google__ClientSecret=
Google__CallbackPath=/signin-google
Legal__TermsVersion=2026-11-17
Legal__PrivacyVersion=2026-11-17
RateLimiting__Auth=8
Email__Provider=Console
Email__From=Fisga <acesso@abson.tech>
Email__ResendApiKey=
Media__Path=media
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Somente teste/E2E: grava e-mails em JSON em vez de enviar. Nunca use em produção.
# Email__Provider=Outbox
# Email__OutboxPath=./.outbox

# ===== WEB =====
PUBLIC_API_URL=http://localhost:5184
API_URL=http://localhost:5184
PUBLIC_SITE_URL=http://localhost:4323
PUBLIC_SENTRY_DSN=

# ===== PRODUÇÃO (referência; não use estes valores no dev local) =====
# ASPNETCORE_ENVIRONMENT=Production
# Auth__CookieSecure=true
# Email__Provider=Resend
# Email__ResendApiKey=
# PUBLIC_API_URL=https://api.fisga.abson.tech   # build-time (rebuild da web)
# API_URL=https://api.fisga.abson.tech          # SSR
# PUBLIC_SITE_URL=https://fisga.abson.tech      # build-time (rebuild da web)
# Cors__AllowedOrigins=https://fisga.abson.tech,https://www.fisga.abson.tech
