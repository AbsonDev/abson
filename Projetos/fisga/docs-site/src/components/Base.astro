---
import '../styles/portal.css';

interface Props {
  titulo: string;
  descricao: string;
  ativo?: string;
  versao?: string;
}

const { titulo, descricao, ativo, versao } = Astro.props;

// Com `build.format: 'file'` o pathname é o nome do arquivo emitido
// (`/index.html`, `/referencia.html`, `/referencia/conta.html`). Normalizar
// aqui evita publicar o canonical apontando para a variante `.html`.
const caminho = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');
const canonical = new URL(caminho, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <title>{titulo} · Fisga</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header">
      <div class="container">
        <a class="marca" href="/">
          Fisga <small>Documentação da API</small>
        </a>
        <nav aria-label="Principal">
          <ul class="nav-principal">
            <li>
              {/* `inicio` marca a home; `referencia` marca o índice e as páginas
                  de domínio/operação, que passam `ativo` para o Base. */}
              <a href="/" aria-current={ativo === 'inicio' ? 'page' : undefined}>Visão geral</a>
            </li>
            <li>
              <a href="/referencia" aria-current={ativo === 'referencia' ? 'page' : undefined}>
                Referência
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        {versao && <p>Versão do contrato: <code>{versao}</code></p>}
        <p><a href="https://api.fisga.abson.tech">API do Fisga</a></p>
      </div>
    </footer>
  </body>
</html>
