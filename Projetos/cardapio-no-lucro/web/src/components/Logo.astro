---
const { compacto = false } = Astro.props;
---
<a href="/" class:list={["logo", { "logo--compacto": compacto }]} aria-label="Cardápio no Lucro — página inicial">
  <span class="logo-marca" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M3.2 10.2h17.6c0 5.1-3.9 9.2-8.8 9.2s-8.8-4.1-8.8-9.2Z" fill="currentColor" opacity=".96" />
      <path d="M8 6.4c0-1.4 1-1.9 1-3.2M12 6.4c0-1.4 1-1.9 1-3.2M16 6.4c0-1.4 1-1.9 1-3.2" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
    </svg>
  </span>
  <span class="logo-texto">cardápio<em>no lucro</em></span>
</a>
