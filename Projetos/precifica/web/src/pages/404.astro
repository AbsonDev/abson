---
import Layout from '../layouts/Layout.astro';
Astro.response.status = 404;
---

<Layout titulo="Página não encontrada — Precifica" descricao="A página que você procura não existe.">
  <section class="erro-pagina">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Essa página <em>não existe.</em></h1>
      <p>Mas o seu preço pode existir. Que tal começar a conta de novo?</p>
      <a class="btn btn--primario" href="/calculadora" style="margin-top: 22px;">Ir para a calculadora</a>
    </div>
  </section>
</Layout>
