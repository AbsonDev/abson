# ===== API =====
ASPNETCORE_ENVIRONMENT=Development
Database__Provider=Postgres
Database__ConnectionString=Host=localhost;Port=5433;Database=precifica;Username=precifica;Password=precifica
Cors__AllowedOrigins=http://localhost:4321,http://localhost:3000
Web__Url=http://localhost:4321
Api__PublicUrl=http://localhost:5180

# Período gratuito: libera PDF sem marca para todos e bloqueia checkouts.
Monetizacao__Ativa=false

# Mercado Pago: use Simulado no desenvolvimento local.
Pagamentos__Modo=Simulado
MercadoPago__AccessToken=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__WebhookSecret=

# ===== WEB =====
# URL usada pelo navegador para chamar a API.
PUBLIC_API_URL=http://localhost:5180
# URL usada pelo SSR do Astro (dentro do Docker: http://api:8080).
API_URL=http://localhost:5180
PUBLIC_SITE_URL=http://localhost:4321
